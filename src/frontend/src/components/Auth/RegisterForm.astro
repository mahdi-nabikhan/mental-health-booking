
---
---

<form id="register-form" class="auth-form">
    <div class="mb-3">
        <label for="role" class="form-label">نوع حساب</label>

        <select id="role" name="role" class="form-select" required>
            <option value="patient">بیمار</option>
            <option value="therapist">روان‌درمانگر</option>
        </select>
    </div>

    <div class="row">
        <div class="col-md-6 mb-3">
            <label for="first_name" class="form-label">نام</label>

            <input
                id="first_name"
                name="first_name"
                type="text"
                class="form-control"
                placeholder="نام خود را وارد کنید"
                autocomplete="given-name"
                required
            />
        </div>

        <div class="col-md-6 mb-3">
            <label for="last_name" class="form-label">نام خانوادگی</label>

            <input
                id="last_name"
                name="last_name"
                type="text"
                class="form-control"
                placeholder="نام خانوادگی خود را وارد کنید"
                autocomplete="family-name"
                required
            />
        </div>
    </div>

    <div class="mb-3">
        <label for="phone_number" class="form-label">شماره تلفن</label>

        <input
            id="phone_number"
            name="phone_number"
            type="tel"
            class="form-control"
            placeholder="شماره تلفن خود را وارد کنید"
            autocomplete="tel"
            required
        />
    </div>

    <div class="mb-3">
        <label for="email" class="form-label">ایمیل</label>

        <input
            id="email"
            name="email"
            type="email"
            class="form-control"
            placeholder="آدرس ایمیل خود را وارد کنید"
            autocomplete="email"
            required
        />
    </div>

    <div class="mb-3">
        <label for="password" class="form-label">رمز عبور</label>

        <input
            id="password"
            name="password"
            type="password"
            class="form-control"
            placeholder="رمز عبور خود را وارد کنید"
            autocomplete="new-password"
            required
        />
    </div>

    <div class="mb-3">
        <label for="confirm_password" class="form-label">
            تکرار رمز عبور
        </label>

        <input
            id="confirm_password"
            name="confirm_password"
            type="password"
            class="form-control"
            placeholder="رمز عبور را دوباره وارد کنید"
            autocomplete="new-password"
            required
        />
    </div>

    <button
        id="register-submit"
        type="submit"
        class="btn btn-primary w-100"
    >
        ایجاد حساب کاربری
    </button>

    <!-- پیام خطا -->
    <div
        id="register-error"
        class="alert alert-danger mt-3 d-none"
        role="alert"
    ></div>

    <!-- پیام موفقیت -->
    <div
        id="register-success"
        class="alert alert-success mt-3 d-none"
        role="alert"
    ></div>
</form>

<script>
    const registerForm =
        document.querySelector<HTMLFormElement>("#register-form");

    const registerError =
        document.querySelector<HTMLDivElement>("#register-error");

    const registerSuccess =
        document.querySelector<HTMLDivElement>("#register-success");

    const registerSubmit =
        document.querySelector<HTMLButtonElement>("#register-submit");

    const API_BASE_URL =
        "http://localhost:8000/api/v1/accounts";

    function showError(message: string) {
        if (!registerError) return;

        registerError.textContent = message;
        registerError.classList.remove("d-none");
    }

    function showSuccess(message: string) {
        if (!registerSuccess) return;

        registerSuccess.textContent = message;
        registerSuccess.classList.remove("d-none");
    }

    function hideMessages() {
        registerError?.classList.add("d-none");
        registerSuccess?.classList.add("d-none");

        if (registerError) {
            registerError.textContent = "";
        }

        if (registerSuccess) {
            registerSuccess.textContent = "";
        }
    }

    function getErrorMessage(data: unknown): string {
        const messages: string[] = [];

        function collectErrors(value: unknown) {
            if (typeof value === "string") {
                messages.push(value);
                return;
            }

            if (Array.isArray(value)) {
                value.forEach(collectErrors);
                return;
            }

            if (value && typeof value === "object") {
                Object.values(value).forEach(collectErrors);
            }
        }

        collectErrors(data);

        return messages.length > 0
            ? messages.join(" ")
            : "ثبت‌نام انجام نشد. لطفاً اطلاعات واردشده را بررسی کنید.";
    }

    registerForm?.addEventListener("submit", async (event) => {
        event.preventDefault();

        if (!registerForm || !registerSubmit) {
            return;
        }

        hideMessages();

        registerSubmit.disabled = true;
        registerSubmit.textContent = "در حال ایجاد حساب...";

        const formData = new FormData(registerForm);

        const role = String(
            formData.get("role") ?? "",
        );

        const email = String(
            formData.get("email") ?? "",
        );

        const password = String(
            formData.get("password") ?? "",
        );

        const confirmPassword = String(
            formData.get("confirm_password") ?? "",
        );

        const firstName = String(
            formData.get("first_name") ?? "",
        );

        const lastName = String(
            formData.get("last_name") ?? "",
        );

        const phoneNumber = String(
            formData.get("phone_number") ?? "",
        );

        try {
            const endpoint =
                role === "therapist"
                    ? `${API_BASE_URL}/therapist/register/`
                    : `${API_BASE_URL}/patient/register/`;

            const response = await fetch(endpoint, {
                method: "POST",
                headers: {
                    "Content-Type": "application/json",
                },
                body: JSON.stringify({
                    user: {
                        email,
                        password,

                        // Backend currently expects this typo.
                        confrim_password: confirmPassword,
                    },
                    first_name: firstName,
                    last_name: lastName,
                    phone_number: phoneNumber,
                }),
            });

            const data = await response.json();

            if (!response.ok) {
                throw new Error(
                    getErrorMessage(data),
                );
            }

            showSuccess(
                data.message ||
                    "ثبت‌نام با موفقیت انجام شد.",
            );

            registerForm.reset();

            setTimeout(() => {
                window.location.href = "/";
            }, 1200);
        } catch (error) {
            showError(
                error instanceof Error
                    ? error.message
                    : "خطایی رخ داد. لطفاً دوباره تلاش کنید.",
            );
        } finally {
            registerSubmit.disabled = false;
            registerSubmit.textContent = "ایجاد حساب کاربری";
        }
    });
</script>
