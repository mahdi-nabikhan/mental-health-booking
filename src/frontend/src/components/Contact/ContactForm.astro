
---
const contactFormIntro: string = "برای دریافت مشاوره رایگان، این فرم را تکمیل و ارسال کنید"
const actionUrl: string = "https://api.web3forms.com/submit"
const ACCESS_KEY: string = import.meta.env.WEB3_FORMS_API_KEY

if(!ACCESS_KEY) console.error(`Missing environment variable: ${ACCESS_KEY}`)
---

<section
  class="container-fluid d-flex flex-column justify-content-center align-items-center py-5 over-x"
  id="form-wrapper"
  aria-labelledby="contact-form-title"
>
  <h2
    class="col-11 col-lg-7 col-xl-8 text-center mb-5 lh-base"
    id="contact-form-title"
    data-aos="fade-down"
    data-aos-duration="1500"
  >
    {contactFormIntro}
  </h2>

  <form class="row g-3 col-12 col-lg-11" action={actionUrl} method="POST">
    <input type="hidden" name="access_key" value={ACCESS_KEY}>
    <input type="hidden" name="redirect" value="/">
    <input type="hidden" name="subject" value="Contact Email">
    <input type="hidden" name="from_name" value="Psychotherapist Astro Site">

    <input type="checkbox" name="botcheck" id="" style="display: none;">

    <!---- نام و نام خانوادگی ---->
    <div class="col-md-6">
      <label for="inputName" class="form-label">نام و نام خانوادگی</label>
      <input
        type="text"
        name="fullname"
        class="form-control"
        id="inputName"
        placeholder="نام و نام خانوادگی خود را وارد کنید"
        required
        aria-label="نام و نام خانوادگی"
      >
    </div>

    <!---- ایمیل ---->
    <div class="col-md-6">
      <label for="inputEmail4" class="form-label">ایمیل</label>
      <input
        type="email"
        name="email"
        class="form-control"
        id="inputEmail4"
        placeholder="ایمیل خود را وارد کنید"
        required
        aria-label="ایمیل"
      >
    </div>

    <!---- تلفن ---->
    <div class="col-md-6">
      <label for="inputPhone" class="form-label">شماره تلفن</label>
      <input
        type="tel"
        name="phone"
        class="form-control"
        id="inputPhone"
        placeholder="شماره تلفن خود را وارد کنید"
        required
        aria-label="شماره تلفن"
      >
    </div>

    <!---- آدرس ---->
    <div class="col-md-6">
      <label for="inputAddress" class="form-label">آدرس</label>
      <input
        type="text"
        name="address"
        class="form-control"
        id="inputAddress"
        placeholder="آدرس خود را وارد کنید"
        required
        aria-label="آدرس"
      >
    </div>

    <!---- شهر ---->
    <div class="col-md-6">
      <label for="inputCity" class="form-label">شهر</label>
      <input
        type="text"
        name="city"
        class="form-control"
        id="inputCity"
        placeholder="شهر خود را وارد کنید"
        required
        aria-label="شهر"
      >
    </div>

    <!---- تاریخ تولد ---->
    <div class="col-md-6">
      <label for="inputDate" class="form-label">تاریخ تولد</label>
      <input
        type="date"
        name="birthdate"
        class="form-control"
        id="inputDate"
        required
        aria-label="تاریخ تولد"
      >
    </div>

    <!---- پیام ---->
    <div class="form-floating">
      <textarea
        class="form-control"
        name="message"
        placeholder="پیام خود را بنویسید"
        id="floatingTextarea2"
        style="height: 150px"
        required
        aria-label="پیام"
      ></textarea>

      <label for="floatingTextarea2" id="textarea-label">
        پیام
      </label>
    </div>

    <!---- دکمه‌ها ---->
    <div class="col-12 d-flex flex-column flex-sm-row justify-content-center mt-4">
      <button
        type="submit"
        class="btn btn-success mx-4 mb-3 mb-sm-0 px-5 py-2 rounded-pill"
        aria-label="ارسال فرم درخواست مشاوره"
      >
        ارسال
      </button>

      <button
        type="reset"
        class="btn btn-warning mx-4 px-5 py-2 rounded-pill"
        aria-label="پاک کردن تمام اطلاعات فرم"
      >
        پاک کردن
      </button>
    </div>
  </form>
</section>
