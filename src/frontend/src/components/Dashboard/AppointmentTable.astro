
---
import { API_BASE_URL } from "../../config/api";


interface Patient {
    id?: number;
    first_name?: string;
    last_name?: string;
    phone_number?: string;
    user?: {
        id?: number;
        email?: string;
    };
}

interface AppointmentSlot {
    id: number;
    date: string;
    time: string;
    created_at: string;
}

interface Appointment {
    id: number;
    reason: string;
    status: string;
    created_at: string;
    updated_at: string;
    slot: AppointmentSlot;
    patient: Patient;
}

interface AppointmentsResponse {
    links: {
        next: string | null;
        previous: string | null;
    };
    count: number;
    results: Appointment[];
}
---

<div class="appointments-card">
    <div class="card-header">
        <div>
            <h2>نوبت‌های امروز</h2>
            <p>برنامه شما برای امروز</p>
        </div>

        <a
            href="/therapist/appointments"
            class="view-all"
        >
            مشاهده همه
            <i class="fa-solid fa-arrow-left"></i>
        </a>
    </div>

    <div
        id="appointment-loading"
        class="state-message"
    >
        <i class="fa-solid fa-spinner fa-spin"></i>
        <span>در حال دریافت نوبت‌ها...</span>
    </div>

    <div
        id="appointment-error"
        class="state-message error"
        hidden
    >
        <i class="fa-solid fa-circle-exclamation"></i>
        <span>دریافت نوبت‌ها با خطا مواجه شد.</span>
    </div>

    <div
        id="appointment-empty"
        class="state-message"
        hidden
    >
        <i class="fa-regular fa-calendar-xmark"></i>
        <span>امروز هیچ نوبت رزرو شده‌ای ندارید.</span>
    </div>

    <div
        id="appointment-table"
        class="table-wrapper"
        hidden
    >
        <table>
            <thead>
                <tr>
                    <th class="time-column">ساعت</th>
                    <th>بیمار</th>
                    <th>علت مراجعه</th>
                    <th class="status-column">وضعیت</th>
                </tr>
            </thead>

            <tbody id="appointment-table-body"></tbody>
        </table>
    </div>
</div>

<script>
   const API_URL =`${API_BASE_URL}/booking/appointments/today/?page_size=100`;

    const loadingElement =
        document.getElementById(
            "appointment-loading"
        ) as HTMLElement;

    const errorElement =
        document.getElementById(
            "appointment-error"
        ) as HTMLElement;

    const emptyElement =
        document.getElementById(
            "appointment-empty"
        ) as HTMLElement;

    const tableElement =
        document.getElementById(
            "appointment-table"
        ) as HTMLElement;

    const tableBody =
        document.getElementById(
            "appointment-table-body"
        ) as HTMLTableSectionElement;

    const getPatientName = (
        patient: Patient
    ): string => {
        const fullName = [
            patient.first_name,
            patient.last_name,
        ]
            .filter(Boolean)
            .join(" ");

        return (
            fullName ||
            patient.user?.email ||
            "بیمار"
        );
    };

    const getPatientInitial = (
        patient: Patient
    ): string => {
        const name = getPatientName(patient);

        return name.charAt(0);
    };

    const formatTime = (
        time: string
    ): string => {
        return time.slice(0, 5);
    };

    const getStatusLabel = (
        status: string
    ): string => {
        switch (status) {
            case "scheduled":
                return "رزرو شده";

            case "completed":
                return "تکمیل شده";

            case "cancelled":
                return "لغو شده";

            default:
                return status;
        }
    };

    const getStatusClass = (
        status: string
    ): string => {
        switch (status) {
            case "completed":
                return "completed";

            case "cancelled":
                return "cancelled";

            case "scheduled":
            default:
                return "scheduled";
        }
    };

    const renderAppointments = (
        appointments: Appointment[]
    ) => {
        tableBody.innerHTML = "";

        appointments.forEach(
            (appointment) => {
                const patientName =
                    getPatientName(
                        appointment.patient
                    );

                const patientInitial =
                    getPatientInitial(
                        appointment.patient
                    );

                const row =
                    document.createElement(
                        "tr"
                    );

                /*
                 * Time
                 */
                const timeCell =
                    document.createElement(
                        "td"
                    );

                timeCell.className =
                    "appointment-time";

                timeCell.textContent =
                    formatTime(
                        appointment.slot.time
                    );

                /*
                 * Patient
                 */
                const patientCell =
                    document.createElement(
                        "td"
                    );

                const patientWrapper =
                    document.createElement(
                        "div"
                    );

                patientWrapper.className =
                    "patient-cell";

                const avatar =
                    document.createElement(
                        "div"
                    );

                avatar.className =
                    "patient-avatar";

                avatar.textContent =
                    patientInitial;

                const patientNameElement =
                    document.createElement(
                        "span"
                    );

                patientNameElement.className =
                    "patient-name";

                patientNameElement.textContent =
                    patientName;

                patientWrapper.appendChild(
                    avatar
                );

                patientWrapper.appendChild(
                    patientNameElement
                );

                patientCell.appendChild(
                    patientWrapper
                );

                /*
                 * Reason
                 */
                const reasonCell =
                    document.createElement(
                        "td"
                    );

                reasonCell.className =
                    "session-type";

                reasonCell.textContent =
                    appointment.reason ||
                    "ثبت نشده";

                /*
                 * Status
                 */
                const statusCell =
                    document.createElement(
                        "td"
                    );

                const status =
                    document.createElement(
                        "span"
                    );

                status.className =
                    `status ${getStatusClass(
                        appointment.status
                    )}`;

                status.textContent =
                    getStatusLabel(
                        appointment.status
                    );

                statusCell.appendChild(
                    status
                );

                /*
                 * Append row
                 */
                row.appendChild(timeCell);
                row.appendChild(
                    patientCell
                );
                row.appendChild(
                    reasonCell
                );
                row.appendChild(
                    statusCell
                );

                tableBody.appendChild(row);
            }
        );
    };

    const showLoading = () => {
        loadingElement.hidden = false;
        errorElement.hidden = true;
        emptyElement.hidden = true;
        tableElement.hidden = true;
    };

    const showError = () => {
        loadingElement.hidden = true;
        errorElement.hidden = false;
        emptyElement.hidden = true;
        tableElement.hidden = true;
    };

    const showEmpty = () => {
        loadingElement.hidden = true;
        errorElement.hidden = true;
        emptyElement.hidden = false;
        tableElement.hidden = true;
    };

    const showTable = () => {
        loadingElement.hidden = true;
        errorElement.hidden = true;
        emptyElement.hidden = true;
        tableElement.hidden = false;
    };

    const loadAppointments = async () => {
        showLoading();

        try {
            const response = await fetch(
                API_URL,
                {
                    method: "GET",
                    credentials: "include",
                    headers: {
                        Accept:
                            "application/json",
                    },
                }
            );

            if (!response.ok) {
                const errorText =
                    await response.text();

                console.error(
                    "Appointment API error:",
                    {
                        status:
                            response.status,
                        statusText:
                            response.statusText,
                        body: errorText,
                    }
                );

                throw new Error(
                    `Appointment request failed: ${response.status}`
                );
            }

            const data: AppointmentsResponse =
                await response.json();

            if (
                !data.results ||
                data.results.length === 0
            ) {
                showEmpty();
                return;
            }

            renderAppointments(
                data.results
            );

            showTable();
        } catch (error) {
            console.error(
                "Failed to load today's appointments:",
                error
            );

            showError();
        }
    };

    loadAppointments();
</script>

<style>
    .appointments-card {
        width: 100%;
        background: #ffffff;
        border: 1px solid #eeeeee;
        border-radius: 16px;
        overflow: hidden;
        direction: rtl;
    }

    /* =========================
       Header
    ========================= */

    .card-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        padding: 22px 24px;
        border-bottom: 1px solid #eeeeee;
    }

    .card-header h2 {
        margin: 0 0 5px;
        color: #222222;
        font-size: 17px;
        font-weight: 700;
    }

    .card-header p {
        margin: 0;
        color: #999999;
        font-size: 12px;
    }

    .view-all {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        color: #444444;
        font-size: 12px;
        font-weight: 600;
        text-decoration: none;
        white-space: nowrap;
        transition: color 0.2s ease;
    }

    .view-all:hover {
        color: #000000;
    }

    .view-all i {
        font-size: 10px;
    }

    /* =========================
       Table
    ========================= */

    .table-wrapper {
        width: 100%;
        overflow-x: auto;
    }

    table {
        width: 100%;
        min-width: 620px;
        border-collapse: collapse;
        table-layout: fixed;
    }

    thead {
        background: #fafafa;
    }

    th {
        height: 46px;
        padding: 0 24px;
        border-bottom: 1px solid #eeeeee;
        color: #999999;
        font-size: 11px;
        font-weight: 600;
        text-align: right;
        white-space: nowrap;
    }

    td {
        height: 68px;
        padding: 0 24px;
        border-bottom: 1px solid #f1f1f1;
        color: #555555;
        font-size: 13px;
        text-align: right;
        vertical-align: middle;
    }

    tbody tr:last-child td {
        border-bottom: none;
    }

    tbody tr {
        transition: background 0.2s ease;
    }

    tbody tr:hover {
        background: #fafafa;
    }

    /* Column widths */

    th:nth-child(1),
    td:nth-child(1) {
        width: 100px;
    }

    th:nth-child(2),
    td:nth-child(2) {
        width: 30%;
    }

    th:nth-child(3),
    td:nth-child(3) {
        width: auto;
    }

    th:nth-child(4),
    td:nth-child(4) {
        width: 120px;
    }

    /* =========================
       Time
    ========================= */

    .appointment-time {
        color: #222222;
        font-size: 13px;
        font-weight: 700;
        direction: ltr;
        text-align: right;
        white-space: nowrap;
    }

    /* =========================
       Patient
    ========================= */

    .patient-cell {
        display: flex;
        align-items: center;
        gap: 10px;
        min-width: 0;
    }

    .patient-avatar {
        width: 34px;
        height: 34px;
        min-width: 34px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: #f1f1f1;
        color: #555555;
        font-size: 12px;
        font-weight: 700;
    }

    .patient-name {
        overflow: hidden;
        color: #333333;
        font-size: 13px;
        font-weight: 600;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    /* =========================
       Reason
    ========================= */

    .session-type {
        max-width: 300px;
        overflow: hidden;
        color: #777777;
        font-size: 12px;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    /* =========================
       Status
    ========================= */

    .status {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 78px;
        padding: 6px 10px;
        border-radius: 7px;
        font-size: 10px;
        font-weight: 600;
        white-space: nowrap;
    }

    .status.scheduled {
        background: #f1f1f1;
        color: #333333;
    }

    .status.completed {
        background: #e8e8e8;
        color: #555555;
    }

    .status.cancelled {
        background: #f5f5f5;
        color: #888888;
    }

    /* =========================
       Loading / Error / Empty
    ========================= */

    .state-message {
        min-height: 180px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 9px;
        color: #999999;
        font-size: 13px;
    }

    .state-message i {
        font-size: 15px;
    }

    .state-message.error {
        color: #c62828;
    }

    [hidden] {
        display: none !important;
    }

    /* =========================
       Responsive
    ========================= */

    @media (max-width: 768px) {
        .card-header {
            padding: 18px;
        }

        th,
        td {
            padding: 0 18px;
        }

        table {
            min-width: 580px;
        }
    }

    @media (max-width: 480px) {
        .card-header {
            padding: 16px;
        }

        .card-header h2 {
            font-size: 15px;
        }

        .card-header p {
            font-size: 11px;
        }

        .view-all {
            font-size: 11px;
        }

        .view-all span {
            display: none;
        }

        th,
        td {
            padding: 0 14px;
        }

        table {
            min-width: 540px;
        }
    }
</style>
