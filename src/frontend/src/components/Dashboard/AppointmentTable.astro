
---
interface Patient {
    id?: number;
    first_name?: string;
    last_name?: string;
    user?: {
        id?: number;
        email?: string;
    };
}

interface AppointmentSlot {
    id: number;
    date: string;
    time: string;
}

interface Appointment {
    id: number;
    slot: AppointmentSlot;
    patient: Patient;
    reason: string;
    status: string;
    created_at: string;
    updated_at: string;
}

interface AppointmentsResponse {
    links: {
        next: string | null;
        previous: string | null;
    };
    count: number;
    results: Appointment[];
}
---

<div class="appointments-card">
    <div class="card-header">
        <div>
            <h2>نوبت‌های امروز</h2>
            <p>برنامه شما برای امروز</p>
        </div>

        <a href="/therapist/appointments">
            مشاهده همه
        </a>
    </div>

    <div id="appointment-loading" class="state-message">
        <span>در حال دریافت نوبت‌ها...</span>
    </div>

    <div id="appointment-error" class="state-message error" hidden>
        <span>دریافت نوبت‌ها با خطا مواجه شد.</span>
    </div>

    <div id="appointment-empty" class="state-message" hidden>
        <span>امروز هیچ نوبت رزرو شده‌ای ندارید.</span>
    </div>

    <div id="appointment-table" class="table-wrapper" hidden>
        <table>
            <thead>
                <tr>
                    <th>ساعت</th>
                    <th>بیمار</th>
                    <th>علت مراجعه</th>
                    <th>وضعیت</th>
                </tr>
            </thead>

            <tbody id="appointment-table-body"></tbody>
        </table>
    </div>
</div>

<script>
    const API_URL =
        "http://localhost:8000/api/v1/booking/appointments/today/?page_size=100";

    const loadingElement = document.getElementById(
        "appointment-loading"
    ) as HTMLElement;

    const errorElement = document.getElementById(
        "appointment-error"
    ) as HTMLElement;

    const emptyElement = document.getElementById(
        "appointment-empty"
    ) as HTMLElement;

    const tableElement = document.getElementById(
        "appointment-table"
    ) as HTMLElement;

    const tableBody = document.getElementById(
        "appointment-table-body"
    ) as HTMLTableSectionElement;

    const getPatientName = (patient: Patient): string => {
        const fullName = [
            patient.first_name,
            patient.last_name,
        ]
            .filter(Boolean)
            .join(" ");

        return fullName || patient.user?.email || "بیمار";
    };

    const getPatientInitial = (patient: Patient): string => {
        const name = getPatientName(patient);

        return name.charAt(0);
    };

    const formatTime = (time: string): string => {
        return time.slice(0, 5);
    };

    const getStatusLabel = (status: string): string => {
        switch (status) {
            case "scheduled":
                return "رزرو شده";

            case "completed":
                return "تکمیل شده";

            case "cancelled":
                return "لغو شده";

            default:
                return status;
        }
    };

    const getStatusClass = (status: string): string => {
        switch (status) {
            case "completed":
                return "completed";

            case "cancelled":
                return "cancelled";

            default:
                return "scheduled";
        }
    };

    const renderAppointments = (appointments: Appointment[]) => {
        tableBody.innerHTML = "";

        appointments.forEach((appointment) => {
            const patientName = getPatientName(appointment.patient);
            const patientInitial = getPatientInitial(appointment.patient);

            const row = document.createElement("tr");

            row.innerHTML = `
                <td class="appointment-time">
                    ${formatTime(appointment.slot.time)}
                </td>

                <td>
                    <div class="patient-cell">
                        <div class="patient-avatar">
                            ${patientInitial}
                        </div>

                        <span>${patientName}</span>
                    </div>
                </td>

                <td class="session-type">
                    ${appointment.reason || "ثبت نشده"}
                </td>

                <td>
                    <span class="status ${getStatusClass(
                        appointment.status
                    )}">
                        ${getStatusLabel(appointment.status)}
                    </span>
                </td>
            `;

            tableBody.appendChild(row);
        });
    };

    const loadAppointments = async () => {
        try {
            const response = await fetch(API_URL, {
                method: "GET",
                credentials: "include",
            });

            if (response.status === 401) {
                throw new Error("UNAUTHORIZED");
            }

            if (!response.ok) {
                throw new Error("REQUEST_FAILED");
            }

            const data: AppointmentsResponse = await response.json();

            loadingElement.hidden = true;

            if (!data.results || data.results.length === 0) {
                emptyElement.hidden = false;
                return;
            }

            renderAppointments(data.results);

            tableElement.hidden = false;
        } catch (error) {
            console.error(
                "Failed to load today's appointments:",
                error
            );

            loadingElement.hidden = true;
            errorElement.hidden = false;
        }
    };

    loadAppointments();
</script>

<style>
    .appointments-card {
        background: #ffffff;
        border: 1px solid #eeeeee;
        border-radius: 12px;
        overflow: hidden;
    }

    .card-header {
        padding: 22px 24px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        border-bottom: 1px solid #eeeeee;
    }

    .card-header h2 {
        margin: 0 0 5px;
        color: #222222;
        font-size: 17px;
        font-weight: 600;
    }

    .card-header p {
        margin: 0;
        color: #999999;
        font-size: 12px;
    }

    .card-header a {
        color: #222222;
        font-size: 12px;
        text-decoration: none;
        font-weight: 600;
    }

    .card-header a:hover {
        text-decoration: underline;
    }

    .table-wrapper {
        overflow-x: auto;
    }

    table {
        width: 100%;
        border-collapse: collapse;
    }

    th {
        padding: 13px 24px;
        text-align: left;
        color: #999999;
        background: #fafafa;
        font-size: 11px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.4px;
    }

    td {
        padding: 15px 24px;
        border-top: 1px solid #eeeeee;
        color: #555555;
        font-size: 13px;
    }

    .appointment-time {
        color: #222222;
        font-weight: 600;
        white-space: nowrap;
    }

    .patient-cell {
        display: flex;
        align-items: center;
        gap: 10px;
        color: #333333;
        font-weight: 500;
        white-space: nowrap;
    }

    .patient-avatar {
        width: 30px;
        height: 30px;
        min-width: 30px;
        border-radius: 50%;
        background: #f1f1f1;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #555555;
        font-size: 11px;
        font-weight: 600;
    }

    .session-type {
        color: #777777;
        max-width: 280px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .status {
        display: inline-flex;
        padding: 5px 9px;
        border-radius: 20px;
        font-size: 10px;
        font-weight: 600;
        white-space: nowrap;
    }

    .status.scheduled {
        background: #f1f1f1;
        color: #333333;
    }

    .status.completed {
        background: #e9e9e9;
        color: #666666;
    }

    .status.cancelled {
        background: #f5f5f5;
        color: #888888;
    }

    .state-message {
        min-height: 160px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #999999;
        font-size: 13px;
    }

    .state-message.error {
        color: #c62828;
    }

    @media (max-width: 768px) {
        .card-header {
            padding: 18px;
        }

        th,
        td {
            padding: 13px 18px;
        }
    }
</style>
