---
const currentPath = Astro.url.pathname;

const menuItems = [
    {
        label: "Dashboard",
        href: "/patient",
        icon: "fa-solid fa-house",
    },
    {
        label: "Appointments",
        href: "/patient/appointments",
        icon: "fa-solid fa-calendar-check",
    },
    {
        label: "Available Slots",
        href: "/patient/slots",
        icon: "fa-solid fa-calendar-days",
    },
    {
        label: "Profile",
        href: "/patient/profile",
        icon: "fa-solid fa-user",
    },
    {
        label: "Settings",
        href: "/patient/settings",
        icon: "fa-solid fa-gear",
    },
];

const isActive = (href: string) => {
    if (href === "/patient") {
        return currentPath === "/patient" || currentPath === "/patient/";
    }

    return currentPath.startsWith(href);
};
---

<aside class="patient-sidebar">
    <div class="sidebar-header">
        <div class="logo">
            <i class="fa-solid fa-brain"></i>
        </div>

        <div class="brand">
            <span class="brand-name">MindCare</span>
            <span class="brand-role">Patient Panel</span>
        </div>
    </div>

    <nav class="sidebar-nav">
        <p class="nav-title">MENU</p>

        {menuItems.map((item) => (
            <a
                href={item.href}
                class:list={["nav-item", { active: isActive(item.href) }]}
            >
                <i class={item.icon}></i>
                <span>{item.label}</span>
            </a>
        ))}
    </nav>

    <div class="sidebar-footer">
        <button id="patient-logout" class="logout-btn" type="button">
            <i class="fa-solid fa-right-from-bracket"></i>
            <span>Logout</span>
        </button>
    </div>
</aside>

<script>
    const logoutButton =
        document.querySelector<HTMLButtonElement>("#patient-logout");

    logoutButton?.addEventListener("click", () => {
        window.location.href = "/login";
    });
</script>

<style>
    .patient-sidebar {
        position: fixed;
        top: 0;
        left: 0;
        z-index: 1000;

        width: 250px;
        height: 100vh;

        display: flex;
        flex-direction: column;

        background: #ffffff;
        border-right: 1px solid #e5e7eb;
    }

    .sidebar-header {
        height: 80px;

        display: flex;
        align-items: center;
        gap: 12px;

        padding: 0 24px;

        border-bottom: 1px solid #e5e7eb;
    }

    .logo {
        width: 42px;
        height: 42px;

        display: flex;
        align-items: center;
        justify-content: center;

        border-radius: 10px;

        background: #111827;
        color: #ffffff;

        font-size: 18px;
    }

    .brand {
        display: flex;
        flex-direction: column;
    }

    .brand-name {
        font-size: 17px;
        font-weight: 700;
        color: #111827;
    }

    .brand-role {
        margin-top: 2px;

        font-size: 12px;
        color: #9ca3af;
    }

    .sidebar-nav {
        flex: 1;
        padding: 24px 14px;
    }

    .nav-title {
        margin: 0 12px 12px;

        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.08em;

        color: #9ca3af;
    }

    .nav-item {
        display: flex;
        align-items: center;
        gap: 14px;

        margin-bottom: 5px;
        padding: 12px 14px;

        border-radius: 8px;

        color: #6b7280;
        text-decoration: none;

        font-size: 14px;
        font-weight: 500;

        transition:
            background 0.2s ease,
            color 0.2s ease;
    }

    .nav-item i {
        width: 20px;
        text-align: center;
        font-size: 15px;
    }

    .nav-item:hover {
        background: #f3f4f6;
        color: #111827;
    }

    .nav-item.active {
        background: #111827;
        color: #ffffff;
    }

    .sidebar-footer {
        padding: 16px 14px;

        border-top: 1px solid #e5e7eb;
    }

    .logout-btn {
        width: 100%;

        display: flex;
        align-items: center;
        gap: 14px;

        padding: 12px 14px;

        border: 0;
        border-radius: 8px;

        background: transparent;
        color: #6b7280;

        font: inherit;
        font-size: 14px;
        font-weight: 500;

        cursor: pointer;

        transition:
            background 0.2s ease,
            color 0.2s ease;
    }

    .logout-btn:hover {
        background: #fef2f2;
        color: #dc2626;
    }

    .logout-btn i {
        width: 20px;
        text-align: center;
    }

    @media (max-width: 768px) {
        .patient-sidebar {
            width: 70px;
        }

        .sidebar-header {
            justify-content: center;
            padding: 0;
        }

        .brand,
        .nav-title,
        .nav-item span,
        .logout-btn span {
            display: none;
        }

        .sidebar-nav {
            padding: 24px 10px;
        }

        .nav-item {
            justify-content: center;
            padding: 13px;
        }

        .sidebar-footer {
            padding: 16px 10px;
        }

        .logout-btn {
            justify-content: center;
            padding: 13px;
        }
    }
</style>