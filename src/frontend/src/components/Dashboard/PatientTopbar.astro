---
---

<header class="patient-topbar">
    <div class="topbar-left">
        <button
            id="mobile-menu-toggle"
            class="mobile-menu-btn"
            type="button"
            aria-label="باز کردن منو"
        >
            <i class="fa-solid fa-bars"></i>
        </button>

        <div>
            <h1>پنل بیمار</h1>
            <p>مدیریت نوبت‌ها و پروفایل شما</p>
        </div>
    </div>

    <div class="topbar-actions">
        <button
            class="notification-btn"
            type="button"
            aria-label="اعلان‌ها"
        >
            <i class="fa-solid fa-bell"></i>
        </button>

        <a href="/patient/profile" class="patient-profile">
            <div class="avatar">
                <i class="fa-solid fa-user"></i>
            </div>

            <div class="profile-info">
                <span class="profile-name">بیمار</span>
                <span class="profile-role">بیمار</span>
            </div>
        </a>
    </div>
</header>

<script>
    const menuButton =
        document.querySelector<HTMLButtonElement>("#mobile-menu-toggle");

    const sidebar =
        document.querySelector<HTMLElement>(".patient-sidebar");

    menuButton?.addEventListener("click", () => {
        sidebar?.classList.toggle("mobile-open");
    });
</script>

<style>
    .patient-topbar {
        height: 80px;

        display: flex;
        align-items: center;
        justify-content: space-between;

        padding: 0 30px;

        background: #ffffff;
        border-bottom: 1px solid #e5e7eb;
    }

    .topbar-left {
        display: flex;
        align-items: center;
        gap: 16px;
    }

    .topbar-left h1 {
        margin: 0;

        color: #111827;

        font-size: 21px;
        font-weight: 700;
    }

    .topbar-left p {
        margin: 4px 0 0;

        color: #9ca3af;

        font-size: 13px;
    }

    .mobile-menu-btn {
        display: none;

        width: 40px;
        height: 40px;

        align-items: center;
        justify-content: center;

        border: 1px solid #e5e7eb;
        border-radius: 8px;

        background: #ffffff;
        color: #374151;

        cursor: pointer;
    }

    .topbar-actions {
        display: flex;
        align-items: center;
        gap: 20px;
    }

    .notification-btn {
        width: 40px;
        height: 40px;

        display: flex;
        align-items: center;
        justify-content: center;

        border: 0;
        border-radius: 50%;

        background: transparent;
        color: #6b7280;

        cursor: pointer;

        transition:
            background 0.2s ease,
            color 0.2s ease;
    }

    .notification-btn:hover {
        background: #f3f4f6;
        color: #111827;
    }

    .patient-profile {
        display: flex;
        align-items: center;
        gap: 10px;

        text-decoration: none;
    }

    .avatar {
        width: 40px;
        height: 40px;

        display: flex;
        align-items: center;
        justify-content: center;

        border-radius: 50%;

        background: #f3f4f6;
        color: #374151;
    }

    .profile-info {
        display: flex;
        flex-direction: column;
    }

    .profile-name {
        color: #111827;

        font-size: 14px;
        font-weight: 600;
    }

    .profile-role {
        margin-top: 2px;

        color: #9ca3af;

        font-size: 11px;
    }

    @media (max-width: 768px) {
        .patient-topbar {
            padding: 0 20px;
        }

        .mobile-menu-btn {
            display: flex;
        }

        .profile-info,
        .notification-btn {
            display: none;
        }
    }
</style>