---
interface Props {
    title: string;
    value: string | number;
    description: string;
    icon: string;
}

const { title, value, description, icon } = Astro.props;
---

<div class="stat-card">
    <div class="stat-card-header">
        <span class="stat-title">{title}</span>

        <div class="stat-icon">
            <i class={icon}></i>
        </div>
    </div>

    <div class="stat-value">
        {value}
    </div>

    <div class="stat-description">
        {description}
    </div>
</div>

<style>
    .stat-card {
        background: #ffffff;
        border: 1px solid #eeeeee;
        border-radius: 12px;
        padding: 22px;
    }

    .stat-card-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 18px;
    }

    .stat-title {
        color: #777777;
        font-size: 13px;
    }

    .stat-icon {
        width: 38px;
        height: 38px;
        border-radius: 9px;
        background: #f5f5f5;
        color: #333333;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .stat-value {
        color: #222222;
        font-size: 30px;
        line-height: 1;
        font-weight: 600;
        margin-bottom: 10px;
    }

    .stat-description {
        color: #999999;
        font-size: 12px;
    }
</style>