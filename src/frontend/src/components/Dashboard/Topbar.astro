---
---

<header class="therapist-topbar">
    <div class="topbar-left">
        <button
            id="mobile-menu-button"
            class="mobile-menu-button"
            aria-label="Open menu"
        >
            <i class="fa-solid fa-bars"></i>
        </button>

        <div>
            <p class="page-label">Therapist Panel</p>
            <h1>Dashboard</h1>
        </div>
    </div>

    <div class="topbar-right">
        <button class="notification-button" aria-label="Notifications">
            <i class="fa-regular fa-bell"></i>
            <span class="notification-dot"></span>
        </button>

        <div class="therapist-profile">
            <div class="profile-avatar">
                <i class="fa-solid fa-user-doctor"></i>
            </div>

            <div class="profile-info">
                <strong>Therapist</strong>
                <span>Professional Account</span>
            </div>

            <i class="fa-solid fa-chevron-down profile-arrow"></i>
        </div>
    </div>
</header>

<script>
    const mobileMenuButton =
        document.querySelector<HTMLButtonElement>("#mobile-menu-button");

    const sidebar =
        document.querySelector<HTMLElement>(".therapist-sidebar");

    mobileMenuButton?.addEventListener("click", () => {
        sidebar?.classList.toggle("mobile-open");
    });
</script>

<style>
    .therapist-topbar {
        height: 80px;
        padding: 0 30px;
        background: #ffffff;
        border-bottom: 1px solid #eeeeee;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .topbar-left,
    .topbar-right {
        display: flex;
        align-items: center;
    }

    .topbar-left {
        gap: 15px;
    }

    .page-label {
        margin: 0 0 2px;
        color: #999999;
        font-size: 11px;
    }

    .topbar-left h1 {
        margin: 0;
        color: #222222;
        font-size: 22px;
        font-weight: 600;
    }

    .mobile-menu-button {
        display: none;
        border: 0;
        background: transparent;
        font-size: 20px;
        cursor: pointer;
    }

    .topbar-right {
        gap: 22px;
    }

    .notification-button {
        position: relative;
        width: 40px;
        height: 40px;
        border: 1px solid #eeeeee;
        border-radius: 50%;
        background: #ffffff;
        color: #555555;
        cursor: pointer;
    }

    .notification-dot {
        position: absolute;
        top: 7px;
        right: 7px;
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: #222222;
    }

    .therapist-profile {
        display: flex;
        align-items: center;
        gap: 10px;
        cursor: pointer;
    }

    .profile-avatar {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: #f2f2f2;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #555555;
    }

    .profile-info {
        display: flex;
        flex-direction: column;
    }

    .profile-info strong {
        color: #222222;
        font-size: 13px;
        font-weight: 600;
    }

    .profile-info span {
        color: #999999;
        font-size: 11px;
    }

    .profile-arrow {
        margin-left: 5px;
        color: #999999;
        font-size: 10px;
    }

    @media (max-width: 768px) {
        .therapist-topbar {
            padding: 0 20px;
        }

        .mobile-menu-button {
            display: block;
        }

        .profile-info,
        .profile-arrow {
            display: none;
        }
    }
</style>