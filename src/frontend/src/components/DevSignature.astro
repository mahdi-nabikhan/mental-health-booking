---
import { getCurrentYear } from "@utils/getCurrentYear"
---

<section
  class="dev-signature d-flex justify-content-center align-items-center me-lg-4"
  aria-label="بخش کوتاه امضای توسعه‌دهنده"
>
  <p class="dev-signing mb-0 text-center text-white">
    <a
      class="dev-link me-1"
      href="https://github.com/MartinXCVI/"
      target="_blank"
      rel="noreferrer noopener"
      title="رفتن به حساب گیت‌هاب MartinXCVI"
      aria-label="رفتن به حساب گیت‌هاب MartinXCVI"
    >
      MartinXCVI <i class="fa-brands fa-github" aria-hidden="true"></i>
    </a>
  </p>

  <p class="mb-0" aria-label={`حق نشر ${getCurrentYear()}`}>
    | &#169; {getCurrentYear()}
  </p>
</section>