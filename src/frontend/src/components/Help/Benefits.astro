---
const currentPath = Astro.url.pathname;
---

<aside class="therapist-sidebar">
    <div class="sidebar-brand">
        <a href="/therapist">
            <span class="brand-icon">
                <i class="fa-solid fa-brain"></i>
            </span>
            <span class="brand-text">تراپی</span>
        </a>
    </div>

    <nav class="sidebar-nav">
        <p class="nav-section-title">اصلی</p>

        <a
            href="/therapist"
            class:list={[
                "nav-item",
                { active: currentPath === "/therapist" }
            ]}
        >
            <i class="fa-solid fa-chart-line"></i>
            <span>داشبورد</span>
        </a>

        <a
            href="/therapist/patients"
            class:list={[
                "nav-item",
                { active: currentPath.startsWith("/therapist/patients") }
            ]}
        >
            <i class="fa-solid fa-users"></i>
            <span>بیماران</span>
        </a>

        <a
            href="/therapist/appointments"
            class:list={[
                "nav-item",
                { active: currentPath.startsWith("/therapist/appointments") }
            ]}
        >
            <i class="fa-solid fa-calendar-check"></i>
            <span>نوبت‌ها</span>
        </a>

        <a
            href="/therapist/slots"
            class:list={[
                "nav-item",
                { active: currentPath.startsWith("/therapist/slots") }
            ]}
        >
            <i class="fa-solid fa-calendar-plus"></i>
            <span>زمان‌های موجود</span>
        </a>

        <p class="nav-section-title">حساب کاربری</p>

        <a
            href="/therapist/profile"
            class:list={[
                "nav-item",
                { active: currentPath.startsWith("/therapist/profile") }
            ]}
        >
            <i class="fa-solid fa-user-doctor"></i>
            <span>پروفایل</span>
        </a>

        <a
            href="/therapist/settings"
            class:list={[
                "nav-item",
                { active: currentPath.startsWith("/therapist/settings") }
            ]}
        >
            <i class="fa-solid fa-gear"></i>
            <span>تنظیمات</span>
        </a>
    </nav>

    <div class="sidebar-footer">
        <button id="logout-button" class="logout-button">
            <i class="fa-solid fa-right-from-bracket"></i>
            <span>خروج</span>
        </button>
    </div>
</aside>

<script>
    const logoutButton =
        document.querySelector<HTMLButtonElement>("#logout-button");

    logoutButton?.addEventListener("click", async () => {
        /*
         * Logout endpoint will be added later.
         * For now redirect to login.
         */
        window.location.href = "/login";
    });
</script>

<style>
    .therapist-sidebar {
        position: fixed;
        top: 0;
        left: 0;
        width: 250px;
        height: 100vh;
        background: #ffffff;
        border-right: 1px solid #eeeeee;
        display: flex;
        flex-direction: column;
        z-index: 1000;
    }

    .sidebar-brand {
        height: 80px;
        display: flex;
        align-items: center;
        padding: 0 25px;
        border-bottom: 1px solid #eeeeee;
    }

    .sidebar-brand a {
        display: flex;
        align-items: center;
        gap: 12px;
        text-decoration: none;
        color: #222222;
        font-size: 21px;
        font-weight: 600;
    }

    .brand-icon {
        width: 38px;
        height: 38px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #222222;
        color: #ffffff;
        font-size: 17px;
    }

    .sidebar-nav {
        flex: 1;
        padding: 25px 15px;
        overflow-y: auto;
    }

    .nav-section-title {
        margin: 15px 12px 10px;
        color: #999999;
        font-size: 10px;
        font-weight: 600;
        letter-spacing: 1px;
    }

    .nav-item {
        display: flex;
        align-items: center;
        gap: 13px;
        padding: 12px 14px;
        margin-bottom: 5px;
        border-radius: 8px;
        color: #666666;
        text-decoration: none;
        font-size: 14px;
        transition: 0.2s ease;
    }

    .nav-item i {
        width: 18px;
        text-align: center;
        font-size: 14px;
    }

    .nav-item:hover {
        background: #f5f5f5;
        color: #222222;
    }

    .nav-item.active {
        background: #222222;
        color: #ffffff;
    }

    .sidebar-footer {
        padding: 15px;
        border-top: 1px solid #eeeeee;
    }

    .logout-button {
        width: 100%;
        border: 0;
        background: transparent;
        color: #777777;
        padding: 12px 14px;
        display: flex;
        align-items: center;
        gap: 13px;
        border-radius: 8px;
        cursor: pointer;
        font-size: 14px;
        text-align: left;
    }

    .logout-button:hover {
        background: #f5f5f5;
        color: #222222;
    }

    @media (max-width: 768px) {
        .therapist-sidebar {
            width: 70px;
        }

        .sidebar-brand {
            justify-content: center;
            padding: 0;
        }

        .brand-text,
        .nav-item span,
        .nav-section-title,
        .logout-button span {
            display: none;
        }

        .sidebar-brand a {
            gap: 0;
        }

        .nav-item,
        .logout-button {
            justify-content: center;
            padding: 13px;
        }

        .nav-item i,
        .logout-button i {
            width: auto;
        }
    }
</style>