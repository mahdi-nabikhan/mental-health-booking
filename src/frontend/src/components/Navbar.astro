
<nav class="navbar navbar-expand-lg bg-body-tertiary" id="navigation">
  <div class="container-fluid" id="navigation-wrapper">
    <button
      class="navbar-toggler"
      type="button"
      data-bs-toggle="collapse"
      data-bs-target="#navbarNav"
      aria-controls="navbarNav"
      aria-expanded="false"
      aria-label="باز و بسته کردن منوی ناوبری"
    >
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarNav">
      <ul class="navbar-nav">

        <li class="nav-item">
          <a
            class="nav-link"
            href="/"
            title="رفتن به صفحه اصلی"
            aria-label="رفتن به صفحه اصلی"
          >
            خانه
          </a>
        </li>

        <li class="nav-item">
          <a
            class="nav-link"
            href="/about"
            title="رفتن به صفحه درباره من"
            aria-label="رفتن به صفحه درباره من"
          >
            درباره من
          </a>
        </li>

        <li class="nav-item">
          <a
            class="nav-link"
            href="/main-slot"
            title="رفتن به صفحه رزرو نوبت"
            aria-label="رفتن به صفحه رزرو نوبت"
          >
            رزرو نوبت
          </a>
        </li>

        <li class="nav-item" id="profile-nav-item" hidden>
          <a
            class="nav-link"
            href="/patient"
            title="مشاهده پروفایل شما"
            aria-label="مشاهده پروفایل شما"
          >
            پروفایل شما
          </a>
        </li>

        <li class="nav-item">
          <a
            class="nav-link"
            href="/contact"
            title="رفتن به صفحه تماس"
            aria-label="رفتن به صفحه تماس"
          >
            تماس با من
          </a>
        </li>

        <li class="nav-item" id="login-nav-item" hidden>
          <a
            class="nav-link"
            href="/login"
            title="ورود به حساب کاربری"
            aria-label="ورود به حساب کاربری"
          >
            ورود
          </a>
        </li>

        <li class="nav-item" id="register-nav-item" hidden>
          <a
            class="nav-link"
            href="/register"
            title="ثبت‌نام"
            aria-label="ثبت‌نام"
          >
            ثبت‌نام
          </a>
        </li>

        <li class="nav-item" id="logout-nav-item" hidden>
          <button
            class="nav-link"
            type="button"
            id="logout-button"
            title="خروج از حساب کاربری"
            aria-label="خروج از حساب کاربری"
          >
            خروج
          </button>
        </li>

      </ul>
    </div>
  </div>
</nav>

<script>
  const profileUrl =
    "http://localhost:8000/api/v1/accounts/patient/profile/";

  const logoutUrl =
    "http://localhost:8000/api/v1/accounts/logout/";

  const profileNavItem = document.getElementById("profile-nav-item");
  const loginNavItem = document.getElementById("login-nav-item");
  const registerNavItem = document.getElementById("register-nav-item");
  const logoutNavItem = document.getElementById("logout-nav-item");
  const logoutButton = document.getElementById("logout-button");

  const currentPath = window.location.pathname;

  const navLinks = document.querySelectorAll(
    ".navbar-nav .nav-link"
  );

  navLinks.forEach((link) => {
    const href = link.getAttribute("href");

    if (href === currentPath) {
      link.classList.add("active");
    }
  });

  const showLoggedInState = () => {
    profileNavItem?.removeAttribute("hidden");
    logoutNavItem?.removeAttribute("hidden");

    loginNavItem?.setAttribute("hidden", "");
    registerNavItem?.setAttribute("hidden", "");
  };

  const showLoggedOutState = () => {
    profileNavItem?.setAttribute("hidden", "");
    logoutNavItem?.setAttribute("hidden", "");

    loginNavItem?.removeAttribute("hidden");
    registerNavItem?.removeAttribute("hidden");
  };

  const logout = async () => {
    if (!logoutButton) {
      return;
    }

    logoutButton.setAttribute("disabled", "");

    try {
      const response = await fetch(logoutUrl, {
        method: "POST",
        credentials: "include",
        headers: {
          Accept: "application/json",
        },
      });

      if (response.ok) {
        window.location.href = "/login";
        return;
      }

      console.error("Logout failed:", response.status);
    } catch (error) {
      console.error("Failed to logout:", error);
    } finally {
      logoutButton.removeAttribute("disabled");
    }
  };

  logoutButton?.addEventListener("click", logout);

  const checkAuthentication = async () => {
    try {
      const response = await fetch(profileUrl, {
        method: "GET",
        credentials: "include",
        headers: {
          Accept: "application/json",
        },
      });

      if (response.ok) {
        showLoggedInState();
      } else {
        showLoggedOutState();
      }
    } catch (error) {
      console.error("Failed to check authentication:", error);
      showLoggedOutState();
    }
  };

  checkAuthentication();
</script>

