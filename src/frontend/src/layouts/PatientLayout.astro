
---
import PatientSidebar from "../components/Dashboard/PatientSidebar.astro";
import PatientTopbar from "../components/Dashboard/PatientTopbar.astro";

interface Props {
    title?: string;
}

const { title = "Patient Dashboard" } = Astro.props;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />

        <meta
            name="viewport"
            content="width=device-width, initial-scale=1.0"
        />

        <title>{title}</title>

        <link
            rel="stylesheet"
            href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css"
        />
    </head>

    <body>
        <PatientSidebar />

        <div class="patient-layout">
            <PatientTopbar />

            <main class="patient-content">
                <slot />
            </main>
        </div>
    </body>
</html>

<style>
    :global(*) {
        box-sizing: border-box;
    }

    :global(body) {
        margin: 0;
        background: #f8f8f8;
        color: #222222;
        font-family:
            Arial,
            Helvetica,
            sans-serif;
    }

    .patient-layout {
        margin-left: 250px;
        min-height: 100vh;
    }

    .patient-content {
        padding: 30px;
    }

    @media (max-width: 768px) {
        .patient-layout {
            margin-left: 70px;
        }

        .patient-content {
            padding: 20px;
        }
    }
</style>
