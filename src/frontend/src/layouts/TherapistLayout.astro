---
import TherapistSidebar from "../components/Dashboard/TherapistSidebar.astro";
import Topbar from "../components/Dashboard/Topbar.astro";

interface Props {
    title?: string;
}

const { title = "Therapist Dashboard" } = Astro.props;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />

        <meta
            name="viewport"
            content="width=device-width, initial-scale=1.0"
        />

        <title>{title}</title>

        <link
            rel="stylesheet"
            href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css"
        />
    </head>

    <body>
        <TherapistSidebar />

        <div class="therapist-layout">
            <Topbar />

            <main class="therapist-content">
                <slot />
            </main>
        </div>
    </body>
</html>

<style>
    :global(*) {
        box-sizing: border-box;
    }

    :global(body) {
        margin: 0;
        background: #f8f8f8;
        color: #222222;
        font-family:
            Arial,
            Helvetica,
            sans-serif;
    }

    .therapist-layout {
        margin-left: 250px;
        min-height: 100vh;
    }

    .therapist-content {
        padding: 30px;
    }

    @media (max-width: 768px) {
        .therapist-layout {
            margin-left: 70px;
        }

        .therapist-content {
            padding: 20px;
        }
    }
</style>