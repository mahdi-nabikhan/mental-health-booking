---

import Layout from "@layouts/Layout.astro";

const errorIntro: string = "متأسفانه مشکلی پیش آمده است..."
const errorText: string = "یا صفحه‌ای که به دنبال آن هستید وجود ندارد."
-----------------------------------------------------------------------

<Layout title="۴۰۴ - صفحه یافت نشد"> 
  <main 
    class="w-100 d-flex flex-column justify-content-center align-items-center over-x" 
    id="error-main" 
    aria-labelledby="error-404-title" 
  > 
    <h1 
      class="mb-3 col-11 text-center" 
      id="error-404-title" 
      data-aos="fade-right" 
      data-aos-duration="1500" 
    > 
      {errorIntro} 
    </h1> 
    <h2 
      class="mb-5 col-11 text-center" 
      data-aos="fade-left" 
      data-aos-duration="1500" 
    > 
      {errorText} 
    </h2> 
    <a 
      href='/' 
      class='error-btn btn' 
      title="بازگشت به صفحه اصلی" 
      aria-label="بازگشت به صفحه اصلی" 
    > 
      بازگشت به سایت 
    </a> 
  </main> 
</Layout>
