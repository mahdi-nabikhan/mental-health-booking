
---
import Layout from '@layouts/Layout.astro';

import Navbar from '@components/Navbar.astro';
import WhyTherapy from '@components/Help/WhyTherapy.astro';
import HelpBg from '@components/Help/HelpBg.astro';
import HelpProblems from '@components/Help/HelpProblems.astro';
import Benefits from '@components/Help/Benefits.astro';
import HelpContact from '@components/Help/HelpContact.astro';
import Footer from '@components/Footer.astro';

const intro: string = "دریافت کمک";

interface Therapist {
  id: number;
  first_name: string;
  last_name: string;
  phone_number: string;
  user: {
    email: string;
    id: number;
  };
}

interface AppointmentSlot {
  id: number;
  date: string;
  time: string;
  created_at: string;
  therapist: Therapist;
}

let appointmentSlots: AppointmentSlot[] = [];

try {
  const response = await fetch(
    'http://localhost:8000/api/v1/booking/appointment-slots/'
  );

  if (response.ok) {
    appointmentSlots = await response.json();
  }
} catch (error) {
  console.error('Failed to fetch appointment slots:', error);
}
---

<Layout title="روان‌درمانگر: دریافت کمک">
  <header class="header" id="help-header" aria-labelledby="help-hero-title">
    <Navbar />

    <h1 class="hero-title" id="help-hero-title">
      {intro}
    </h1>
  </header>

  <main id="index-main" class="main">
    <WhyTherapy />

    <HelpBg />

    <HelpProblems />

    <Benefits />

    <!-- زمان‌های مشاوره -->
    <section
      class="appointment-slots"
      aria-labelledby="appointment-slots-title"
    >
      <div class="appointment-slots-container">
        <h2 id="appointment-slots-title">
          زمان‌های مشاوره موجود
        </h2>

        {appointmentSlots.length > 0 ? (
          <div class="slots-grid">
            {appointmentSlots.map((slot) => (
              <article class="slot-card">
                <div class="slot-date">
                  <span>تاریخ</span>
                  <strong>{slot.date}</strong>
                </div>

                <div class="slot-time">
                  <span>ساعت</span>
                  <strong>{slot.time.slice(0, 5)}</strong>
                </div>

                <div class="slot-therapist">
                  <span>روان‌درمانگر</span>
                  <strong>
                    {slot.therapist.first_name} {slot.therapist.last_name}
                  </strong>
                </div>

                <button
                  type="button"
                  class="book-slot-btn"
                  data-slot-id={slot.id}
                >
                  رزرو نوبت
                </button>
              </article>
            ))}
          </div>
        ) : (
          <div class="empty-slots">
            <p>
              در حال حاضر زمان مشاوره‌ای برای رزرو وجود ندارد.
            </p>
          </div>
        )}
      </div>
    </section>

    <HelpContact />
  </main>

  <Footer />
</Layout>

