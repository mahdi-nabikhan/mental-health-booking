
---
import Layout from '@layouts/Layout.astro';
import Navbar from '@components/Navbar.astro';
import Footer from '@components/Footer.astro';

const intro = 'رزرو نوبت';

interface Therapist {
  id: number;
  first_name: string;
  last_name: string;
  phone_number: string;
  user: {
    email: string;
    id: number;
  };
}

interface AppointmentSlot {
  id: number;
  date: string;
  time: string;
  created_at: string;
  therapist: Therapist;
}

interface AppointmentSlotsResponse {
  links: {
    next: string | null;
    previous: string | null;
  };
  count: number;
  results: AppointmentSlot[];
}

let appointmentSlots: AppointmentSlot[] = [];
let totalCount = 0;

const currentPage = Math.max(
  1,
  Number(Astro.url.searchParams.get('page') ?? '1')
);

try {
  const response = await fetch(
    `http://localhost:8000/api/v1/booking/appointment-slots/?page=${currentPage}`
  );

  if (response.ok) {
    const data: AppointmentSlotsResponse = await response.json();

    appointmentSlots = Array.isArray(data.results)
      ? data.results
      : [];

    totalCount = data.count ?? 0;
  }
} catch (error) {
  console.warn('Appointment slots are currently unavailable.');
}

const pageSize = 4;
const totalPages = Math.ceil(totalCount / pageSize);
---

<Layout title="روان‌درمانگر: رزرو نوبت">
  <header class="header" id="help-header">
    <Navbar />

    <h1 class="hero-title" id="help-hero-title">
      {intro}
    </h1>
  </header>

  <main class="main" id="index-main">
    <section
      class="appointment-slots"
      aria-labelledby="appointment-slots-title"
    >
      <div class="appointment-slots-container">

        <div class="appointment-slots-heading">
          <span class="appointment-slots-label">
            رزرو آنلاین
          </span>

          <h2 id="appointment-slots-title">
            زمان‌های مشاوره موجود
          </h2>

          <p>
            زمان مناسب خود را انتخاب کنید و برای دریافت مشاوره نوبت رزرو کنید.
          </p>
        </div>

        {appointmentSlots.length > 0 ? (
          <>
            <div class="slots-grid">
              {appointmentSlots.map((slot) => (
                <article class="slot-card">

                  <div class="slot-card-header">
                    <div class="slot-icon">
                      <i class="fa-regular fa-calendar"></i>
                    </div>

                    <span class="available-badge">
                      زمان آزاد
                    </span>
                  </div>

                  <div class="slot-info">

                    <div class="slot-info-item">
                      <span class="slot-info-label">
                        تاریخ
                      </span>

                      <strong class="slot-info-value">
                        {slot.date}
                      </strong>
                    </div>

                    <div class="slot-info-item">
                      <span class="slot-info-label">
                        ساعت
                      </span>

                      <strong class="slot-info-value slot-time-value">
                        {slot.time.slice(0, 5)}
                      </strong>
                    </div>

                    <div class="slot-info-item therapist-info">
                      <span class="slot-info-label">
                        روان‌درمانگر
                      </span>

                      <strong class="slot-info-value">
                        {slot.therapist.first_name}
                        {' '}
                        {slot.therapist.last_name}
                      </strong>
                    </div>

                  </div>

                  <button
                    type="button"
                    class="book-slot-btn"
                    data-slot-id={slot.id}
                    data-slot-date={slot.date}
                    data-slot-time={slot.time.slice(0, 5)}
                    data-slot-therapist={`${slot.therapist.first_name} ${slot.therapist.last_name}`}
                  >
                    <span>
                      رزرو نوبت
                    </span>

                    <i class="fa-solid fa-arrow-left"></i>
                  </button>

                </article>
              ))}
            </div>

            {totalPages > 1 && (
              <nav
                class="pagination"
                aria-label="صفحه‌بندی نوبت‌ها"
              >

                {currentPage > 1 && (
                  <a
                    href={`/main-slot?page=${currentPage - 1}`}
                    class="pagination-btn"
                    aria-label="صفحه قبلی"
                  >
                    <i class="fa-solid fa-arrow-right"></i>

                    <span>
                      قبلی
                    </span>
                  </a>
                )}

                <span class="pagination-current">
                  صفحه {currentPage} از {totalPages}
                </span>

                {currentPage < totalPages && (
                  <a
                    href={`/main-slot?page=${currentPage + 1}`}
                    class="pagination-btn"
                    aria-label="صفحه بعدی"
                  >
                    <span>
                      بعدی
                    </span>

                    <i class="fa-solid fa-arrow-left"></i>
                  </a>
                )}

              </nav>
            )}
          </>
        ) : (
          <div class="empty-slots">

            <div class="empty-slots-icon">
              <i class="fa-regular fa-calendar-xmark"></i>
            </div>

            <h3>
              در حال حاضر نوبت آزادی وجود ندارد
            </h3>

            <p>
              در حال حاضر زمان مشاوره‌ای برای رزرو وجود ندارد.
              لطفاً بعداً دوباره مراجعه کنید.
            </p>

          </div>
        )}

      </div>
    </section>
  </main>

  <!-- Booking Modal -->

  <div
    class="booking-modal"
    id="booking-modal"
    aria-hidden="true"
  >
    <div
      class="booking-modal-overlay"
      data-close-modal
    ></div>

    <div
      class="booking-modal-content"
      role="dialog"
      aria-modal="true"
      aria-labelledby="booking-modal-title"
    >

      <button
        type="button"
        class="booking-modal-close"
        data-close-modal
        aria-label="بستن"
      >
        <i class="fa-solid fa-xmark"></i>
      </button>

      <div class="booking-modal-header">

        <div class="booking-modal-icon">
          <i class="fa-regular fa-calendar-check"></i>
        </div>

        <div>
          <span class="booking-modal-label">
            رزرو نوبت
          </span>

          <h2 id="booking-modal-title">
            تأیید رزرو جلسه
          </h2>
        </div>

      </div>

      <div class="selected-slot">

        <div class="selected-slot-item">
          <span>
            تاریخ
          </span>

          <strong id="modal-slot-date">
            -
          </strong>
        </div>

        <div class="selected-slot-item">
          <span>
            ساعت
          </span>

          <strong id="modal-slot-time">
            -
          </strong>
        </div>

        <div class="selected-slot-item">
          <span>
            روان‌درمانگر
          </span>

          <strong id="modal-slot-therapist">
            -
          </strong>
        </div>

      </div>

      <form id="booking-form">

        <div class="booking-form-group">

          <label for="booking-reason">
            دلیل مراجعه
          </label>

          <textarea
            id="booking-reason"
            name="reason"
            rows="4"
            placeholder="لطفاً دلیل مراجعه خود را بنویسید..."
            required
          ></textarea>

        </div>

        <div
          class="booking-error"
          id="booking-error"
          role="alert"
        ></div>

        <div class="booking-modal-actions">

          <button
            type="button"
            class="booking-cancel-btn"
            data-close-modal
          >
            انصراف
          </button>

          <button
            type="submit"
            class="booking-submit-btn"
            id="booking-submit-btn"
          >
            <span id="booking-submit-text">
              تأیید و رزرو نوبت
            </span>

            <span
              id="booking-submit-loading"
              hidden
            >
              در حال رزرو...
            </span>
          </button>

        </div>

      </form>

    </div>
  </div>

  <Footer />
</Layout>

<style>
  /* =========================
     Appointment Slots
  ========================= */

  .appointment-slots {
    padding: 90px 20px;
    background: #f8fafc;
    direction: rtl;
  }

  .appointment-slots-container {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
  }

  .appointment-slots-heading {
    max-width: 700px;
    margin: 0 auto 45px;
    text-align: center;
  }

  .appointment-slots-label {
    display: inline-block;
    margin-bottom: 12px;
    padding: 7px 16px;
    border-radius: 30px;
    background: #eef2f3;
    color: #52636a;
    font-size: 13px;
    font-weight: 600;
  }

  .appointment-slots-heading h2 {
    margin: 0 0 14px;
    color: #263238;
    font-size: 34px;
    font-weight: 600;
    line-height: 1.5;
  }

  .appointment-slots-heading p {
    margin: 0;
    color: #7a858c;
    font-size: 15px;
    line-height: 1.9;
  }

  .slots-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 24px;
  }

  .slot-card {
    display: flex;
    flex-direction: column;
    min-height: 350px;
    padding: 25px;
    background: #ffffff;
    border: 1px solid #e8ecef;
    border-radius: 18px;
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.05);
    transition:
      transform 0.25s ease,
      box-shadow 0.25s ease,
      border-color 0.25s ease;
  }

  .slot-card:hover {
    transform: translateY(-5px);
    border-color: #d9e0e3;
    box-shadow: 0 15px 38px rgba(0, 0, 0, 0.09);
  }

  .slot-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 20px;
  }

  .slot-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: 12px;
    background: #f1f4f5;
    color: #455a64;
    font-size: 19px;
  }

  .available-badge {
    padding: 6px 11px;
    border-radius: 20px;
    background: #f1f7f3;
    color: #4f765d;
    font-size: 12px;
    font-weight: 600;
  }

  .slot-info {
    margin-bottom: 22px;
  }

  .slot-info-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 15px;
    padding: 14px 0;
    border-bottom: 1px solid #eef1f3;
  }

  .slot-info-label {
    color: #7a858c;
    font-size: 13px;
  }

  .slot-info-value {
    color: #263238;
    font-size: 15px;
    font-weight: 600;
  }

  .slot-time-value {
    direction: ltr;
  }

  .therapist-info {
    border-bottom: none;
  }

  .book-slot-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    width: 100%;
    min-height: 50px;
    margin-top: auto;
    padding: 12px 18px;
    border: none;
    border-radius: 11px;
    background: #263238;
    color: #ffffff;
    font-family: inherit;
    font-size: 15px;
    font-weight: 600;
    cursor: pointer;
    transition:
      background 0.2s ease,
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }

  .book-slot-btn:hover {
    background: #37474f;
    transform: translateY(-1px);
    box-shadow: 0 7px 18px rgba(38, 50, 56, 0.18);
  }

  .book-slot-btn i {
    font-size: 13px;
    transition: transform 0.2s ease;
  }

  .book-slot-btn:hover i {
    transform: translateX(-3px);
  }

  .book-slot-btn:active {
    transform: translateY(0);
    box-shadow: none;
  }

  /* =========================
     Pagination
  ========================= */

  .pagination {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    margin-top: 45px;
    direction: rtl;
  }

  .pagination-btn,
  .pagination-current {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 44px;
    padding: 8px 16px;
    border-radius: 10px;
    font-size: 14px;
    text-decoration: none;
  }

  .pagination-btn {
    background: #263238;
    color: #ffffff;
    transition:
      background 0.2s ease,
      transform 0.2s ease;
  }

  .pagination-btn:hover {
    background: #37474f;
    color: #ffffff;
    transform: translateY(-1px);
  }

  .pagination-current {
    min-width: 130px;
    background: #eef2f3;
    color: #263238;
    font-weight: 600;
  }

  /* =========================
     Empty State
  ========================= */

  .empty-slots {
    max-width: 650px;
    margin: 0 auto;
    padding: 45px 30px;
    text-align: center;
    background: #ffffff;
    border: 1px solid #e8ecef;
    border-radius: 18px;
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.04);
  }

  .empty-slots-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 58px;
    height: 58px;
    margin: 0 auto 18px;
    border-radius: 50%;
    background: #f1f4f5;
    color: #718087;
    font-size: 22px;
  }

  .empty-slots h3 {
    margin: 0 0 10px;
    color: #263238;
    font-size: 19px;
    font-weight: 600;
  }

  .empty-slots p {
    max-width: 450px;
    margin: 0 auto;
    color: #7a858c;
    font-size: 14px;
    line-height: 1.9;
  }

  /* =========================
     Booking Modal
  ========================= */

  .booking-modal {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 20px;
  }

  .booking-modal.is-open {
    display: flex;
  }

  .booking-modal-overlay {
    position: absolute;
    inset: 0;
    background: rgba(20, 27, 31, 0.55);
    backdrop-filter: blur(4px);
  }

  .booking-modal-content {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 540px;
    max-height: calc(100vh - 40px);
    overflow-y: auto;
    padding: 30px;
    background: #ffffff;
    border: 1px solid #e8ecef;
    border-radius: 20px;
    box-shadow: 0 25px 70px rgba(0, 0, 0, 0.18);
    direction: rtl;
    animation: bookingModalShow 0.2s ease;
  }

  @keyframes bookingModalShow {
    from {
      opacity: 0;
      transform: translateY(15px) scale(0.98);
    }

    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  .booking-modal-close {
    position: absolute;
    top: 18px;
    left: 18px;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border: none;
    border-radius: 50%;
    background: #f1f4f5;
    color: #54636a;
    font-size: 15px;
    cursor: pointer;
    transition:
      background 0.2s ease,
      color 0.2s ease;
  }

  .booking-modal-close:hover {
    background: #e5eaec;
    color: #263238;
  }

  .booking-modal-header {
    display: flex;
    align-items: center;
    gap: 15px;
    margin-bottom: 25px;
  }

  .booking-modal-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    flex-shrink: 0;
    border-radius: 14px;
    background: #f1f4f5;
    color: #455a64;
    font-size: 20px;
  }

  .booking-modal-label {
    display: block;
    margin-bottom: 3px;
    color: #7a858c;
    font-size: 12px;
  }

  .booking-modal-header h2 {
    margin: 0;
    color: #263238;
    font-size: 23px;
    font-weight: 600;
  }

  .selected-slot {
    margin-bottom: 25px;
    padding: 5px 18px;
    background: #f8fafb;
    border: 1px solid #e8ecef;
    border-radius: 13px;
  }

  .selected-slot-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 13px 0;
    border-bottom: 1px solid #e8ecef;
  }

  .selected-slot-item:last-child {
    border-bottom: none;
  }

  .selected-slot-item span {
    color: #7a858c;
    font-size: 13px;
  }

  .selected-slot-item strong {
    color: #263238;
    font-size: 14px;
  }

  #modal-slot-time {
    direction: ltr;
  }

  .booking-form-group {
    margin-bottom: 18px;
  }

  .booking-form-group label {
    display: block;
    margin-bottom: 9px;
    color: #263238;
    font-size: 14px;
    font-weight: 600;
  }

  .booking-form-group textarea {
    display: block;
    width: 100%;
    min-height: 115px;
    padding: 13px 15px;
    border: 1px solid #dfe5e8;
    border-radius: 11px;
    outline: none;
    background: #ffffff;
    color: #263238;
    font-family: inherit;
    font-size: 14px;
    line-height: 1.8;
    resize: vertical;
    transition:
      border-color 0.2s ease,
      box-shadow 0.2s ease;
  }

  .booking-form-group textarea:focus {
    border-color: #90a4ae;
    box-shadow: 0 0 0 3px rgba(144, 164, 174, 0.12);
  }

  .booking-form-group textarea::placeholder {
    color: #a1aaaf;
  }

  .booking-error {
    display: none;
    margin-bottom: 15px;
    padding: 11px 13px;
    border-radius: 10px;
    background: #fff3f3;
    color: #b54444;
    font-size: 13px;
    line-height: 1.7;
  }

  .booking-error.is-visible {
    display: block;
  }

  .booking-modal-actions {
    display: flex;
    gap: 10px;
  }

  .booking-cancel-btn,
  .booking-submit-btn {
    min-height: 48px;
    padding: 11px 18px;
    border-radius: 10px;
    font-family: inherit;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
  }

  .booking-cancel-btn {
    flex: 0 0 auto;
    border: 1px solid #dfe5e8;
    background: #ffffff;
    color: #54636a;
  }

  .booking-cancel-btn:hover {
    background: #f7f9fa;
  }

  .booking-submit-btn {
    flex: 1;
    border: none;
    background: #263238;
    color: #ffffff;
    transition:
      background 0.2s ease,
      opacity 0.2s ease;
  }

  .booking-submit-btn:hover:not(:disabled) {
    background: #37474f;
  }

  .booking-submit-btn:disabled {
    opacity: 0.65;
    cursor: not-allowed;
  }

  /* =========================
     Responsive
  ========================= */

  @media (max-width: 1200px) {
    .slots-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 992px) {
    .appointment-slots-heading h2 {
      font-size: 30px;
    }
  }

  @media (max-width: 640px) {
    .appointment-slots {
      padding: 65px 16px;
    }

    .appointment-slots-heading {
      margin-bottom: 30px;
    }

    .appointment-slots-heading h2 {
      font-size: 26px;
    }

    .appointment-slots-heading p {
      font-size: 14px;
    }

    .slots-grid {
      grid-template-columns: 1fr;
      gap: 18px;
    }

    .slot-card {
      min-height: auto;
      padding: 22px;
    }

    .pagination {
      gap: 8px;
    }

    .pagination-btn,
    .pagination-current {
      min-height: 40px;
      padding: 7px 12px;
      font-size: 13px;
    }

    .pagination-current {
      min-width: auto;
    }

    .booking-modal {
      padding: 12px;
    }

    .booking-modal-content {
      padding: 25px 20px;
      border-radius: 17px;
    }

    .booking-modal-header h2 {
      font-size: 20px;
    }

    .booking-modal-actions {
      flex-direction: column-reverse;
    }

    .booking-cancel-btn,
    .booking-submit-btn {
      width: 100%;
    }
  }
</style>

<script>
  const modal = document.getElementById(
    'booking-modal'
  ) as HTMLDivElement | null;

  const form = document.getElementById(
    'booking-form'
  ) as HTMLFormElement | null;

  const reasonInput = document.getElementById(
    'booking-reason'
  ) as HTMLTextAreaElement | null;

  const modalSlotDate = document.getElementById(
    'modal-slot-date'
  );

  const modalSlotTime = document.getElementById(
    'modal-slot-time'
  );

  const modalSlotTherapist = document.getElementById(
    'modal-slot-therapist'
  );

  const errorBox = document.getElementById(
    'booking-error'
  );

  const submitButton = document.getElementById(
    'booking-submit-btn'
  ) as HTMLButtonElement | null;

  const submitText = document.getElementById(
    'booking-submit-text'
  ) as HTMLSpanElement | null;

  const submitLoading = document.getElementById(
    'booking-submit-loading'
  ) as HTMLSpanElement | null;

  let selectedSlotId: number | null = null;

  const openModal = (
    button: HTMLButtonElement
  ) => {
    if (!modal || !reasonInput) {
      return;
    }

    selectedSlotId = Number(
      button.dataset.slotId
    );

    if (!selectedSlotId) {
      return;
    }

    if (modalSlotDate) {
      modalSlotDate.textContent =
        button.dataset.slotDate ?? '-';
    }

    if (modalSlotTime) {
      modalSlotTime.textContent =
        button.dataset.slotTime ?? '-';
    }

    if (modalSlotTherapist) {
      modalSlotTherapist.textContent =
        button.dataset.slotTherapist ?? '-';
    }

    reasonInput.value = '';

    if (errorBox) {
      errorBox.textContent = '';
      errorBox.classList.remove(
        'is-visible'
      );
    }

    modal.classList.add('is-open');
    modal.setAttribute(
      'aria-hidden',
      'false'
    );

    document.body.style.overflow = 'hidden';

    setTimeout(() => {
      reasonInput.focus();
    }, 100);
  };

  const closeModal = () => {
    if (!modal || !reasonInput) {
      return;
    }

    modal.classList.remove('is-open');

    modal.setAttribute(
      'aria-hidden',
      'true'
    );

    document.body.style.overflow = '';

    selectedSlotId = null;

    reasonInput.value = '';

    if (errorBox) {
      errorBox.textContent = '';
      errorBox.classList.remove(
        'is-visible'
      );
    }
  };

  document
    .querySelectorAll<HTMLButtonElement>(
      '.book-slot-btn'
    )
    .forEach((button) => {
      button.addEventListener(
        'click',
        () => {
          openModal(button);
        }
      );
    });

  document
    .querySelectorAll<HTMLElement>(
      '[data-close-modal]'
    )
    .forEach((element) => {
      element.addEventListener(
        'click',
        closeModal
      );
    });

  document.addEventListener(
    'keydown',
    (event) => {
      if (
        event.key === 'Escape' &&
        modal?.classList.contains(
          'is-open'
        )
      ) {
        closeModal();
      }
    }
  );

  form?.addEventListener(
    'submit',
    async (event) => {
      event.preventDefault();

      if (
        !selectedSlotId ||
        !reasonInput ||
        !submitButton ||
        !submitText ||
        !submitLoading
      ) {
        return;
      }

      const reason =
        reasonInput.value.trim();

      if (!reason) {
        if (errorBox) {
          errorBox.textContent =
            'لطفاً دلیل مراجعه را وارد کنید.';

          errorBox.classList.add(
            'is-visible'
          );
        }

        reasonInput.focus();

        return;
      }

      submitButton.disabled = true;

      submitText.hidden = true;
      submitLoading.hidden = false;

      if (errorBox) {
        errorBox.textContent = '';
        errorBox.classList.remove(
          'is-visible'
        );
      }

      try {
        const response = await fetch(
          `http://localhost:8000/api/v1/booking/appointments/create/${selectedSlotId}/`,
          {
            method: 'POST',
            credentials: 'include',
            headers: {
              'Content-Type':
                'application/json',
            },
            body: JSON.stringify({
              reason,
            }),
          }
        );

        const data =
          await response
            .json()
            .catch(() => null);

        if (!response.ok) {
          if (response.status === 401) {
            throw new Error(
              'برای رزرو نوبت ابتدا باید وارد حساب کاربری خود شوید.'
            );
          }

          if (response.status === 409) {
            throw new Error(
              'این نوبت قبلاً رزرو شده است.'
            );
          }

          throw new Error(
            data?.detail ||
            'رزرو نوبت انجام نشد. لطفاً دوباره تلاش کنید.'
          );
        }

        closeModal();

        alert(
          'نوبت شما با موفقیت رزرو شد.'
        );

        window.location.reload();
      } catch (error) {
        if (errorBox) {
          errorBox.textContent =
            error instanceof Error
              ? error.message
              : 'خطایی هنگام رزرو نوبت رخ داد.';

          errorBox.classList.add(
            'is-visible'
          );
        }
      } finally {
        submitButton.disabled = false;

        submitText.hidden = false;
        submitLoading.hidden = true;
      }
    }
  );
</script>

