---
import Layout from '@layouts/Layout.astro';
import Navbar from '@components/Navbar.astro';
import Footer from '@components/Footer.astro';

const intro = 'رزرو نوبت';
---

<Layout title={intro}>
  <Navbar />

  <main class="booking-page">
    <section class="hero-section">
      <div class="hero-content">
        <span class="hero-badge">
          رزرو آنلاین
        </span>

        <h1>
          رزرو نوبت مشاوره
        </h1>

        <p>
          زمان مناسب خود را انتخاب کنید و برای جلسه
          مشاوره نوبت بگیرید.
        </p>
      </div>
    </section>

    <section class="slots-section">
      <div class="section-header">
        <div>
          <span class="section-label">
            نوبت‌های موجود
          </span>

          <h2>
            زمان‌های مشاوره
          </h2>

          <p>
            یکی از زمان‌های آزاد را برای رزرو جلسه
            انتخاب کنید.
          </p>
        </div>

        <div
          id="slots-count"
          class="slots-count"
          hidden
        ></div>
      </div>

      <!-- Loading -->
      <div
        id="slots-loading"
        class="empty-state"
      >
        <div class="empty-icon">
          <svg
            viewBox="0 0 24 24"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              d="M12 3V6M12 18V21M3 12H6M18 12H21M5.64 5.64L7.76 7.76M16.24 16.24L18.36 18.36M5.64 18.36L7.76 16.24M16.24 7.76L18.36 5.64"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
            />
          </svg>
        </div>

        <h3>
          در حال دریافت نوبت‌ها...
        </h3>

        <p>
          لطفاً چند لحظه صبر کنید.
        </p>
      </div>

      <!-- API Error -->
      <div
        id="slots-error"
        class="empty-state"
        hidden
      >
        <div class="empty-icon">
          <svg
            viewBox="0 0 24 24"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              d="M12 8V13M12 16.5V17M10.29 3.86L2.82 17C2.04 18.37 3.03 20.08 4.61 20.08H19.39C20.97 20.08 21.96 18.37 21.18 17L13.71 3.86C12.92 2.48 11.08 2.48 10.29 3.86Z"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </div>

        <h3>
          دریافت نوبت‌ها با مشکل مواجه شد
        </h3>

        <p id="slots-error-message">
          ارتباط با سرور برقرار نشد.
        </p>

        <button
          type="button"
          id="retry-slots"
          class="book-button retry-button"
        >
          تلاش مجدد
        </button>
      </div>

      <!-- Empty State -->
      <div
        id="slots-empty"
        class="empty-state"
        hidden
      >
        <div class="empty-icon">
          <svg
            viewBox="0 0 24 24"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              d="M7 3V6M17 3V6M4 9H20M6 5H18C19.1046 5 20 5.89543 20 7V19C20 20.1046 19.1046 21 18 21H6C4.89543 21 4 20.1046 4 19V7C4 5.89543 4.89543 5 6 5Z"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </div>

        <h3>
          در حال حاضر نوبتی موجود نیست
        </h3>

        <p>
          در حال حاضر هیچ زمان آزادی برای رزرو
          وجود ندارد.
        </p>
      </div>

      <!-- Slots -->
      <div
        id="slots-grid"
        class="slots-grid"
        hidden
      ></div>

      <!-- Pagination -->
      <nav
        id="pagination"
        class="pagination"
        aria-label="صفحه‌بندی"
        hidden
      >
        <button
          type="button"
          id="previous-page"
          class="pagination-button"
        >
          قبلی
        </button>

        <div
          id="pagination-pages"
          class="pagination-pages"
        ></div>

        <button
          type="button"
          id="next-page"
          class="pagination-button"
        >
          بعدی
        </button>
      </nav>
    </section>
  </main>

  <!-- Booking Modal -->
  <div
    id="booking-modal"
    class="booking-modal"
    aria-hidden="true"
  >
    <div
      class="booking-modal-content"
      role="dialog"
      aria-modal="true"
      aria-labelledby="booking-modal-title"
    >
      <button
        type="button"
        id="close-modal"
        class="close-modal"
        aria-label="بستن"
      >
        ×
      </button>

      <div class="modal-header">
        <span class="modal-label">
          رزرو نوبت
        </span>

        <h2 id="booking-modal-title">
          تکمیل رزرو
        </h2>

        <p>
          اطلاعات نوبت را بررسی کنید و دلیل مراجعه
          خود را وارد کنید.
        </p>
      </div>

      <div class="selected-slot">
        <div class="selected-slot-item">
          <span>
            تاریخ
          </span>

          <strong id="modal-date">
            -
          </strong>
        </div>

        <div class="selected-slot-item">
          <span>
            ساعت
          </span>

          <strong id="modal-time">
            -
          </strong>
        </div>

        <div class="selected-slot-item">
          <span>
            روان‌درمانگر
          </span>

          <strong id="modal-therapist">
            -
          </strong>
        </div>
      </div>

      <form id="booking-form">
        <div class="form-group">
          <label for="reason">
            دلیل مراجعه
          </label>

          <textarea
            id="reason"
            name="reason"
            rows="5"
            required
            placeholder="لطفاً دلیل مراجعه خود را به صورت کوتاه وارد کنید..."
          ></textarea>
        </div>

        <div
          id="booking-error"
          class="booking-error"
          hidden
        ></div>

        <button
          type="submit"
          id="submit-booking"
          class="submit-booking"
        >
          <span id="submit-text">
            تأیید و رزرو نوبت
          </span>

          <span
            id="submit-loading"
            hidden
          >
            در حال ثبت...
          </span>
        </button>
      </form>
    </div>
  </div>

  <Footer />
</Layout>

<script is:inline>
  (() => {
    /*
     * =========================
     * API
     * =========================
     */

    const APPOINTMENT_SLOTS_URL =
      '/api/v1/booking/appointment-slots/available/';

    const BOOKING_URL = (slotId) =>
      `/api/v1/booking/appointments/create/${slotId}/`;

    const PAGE_SIZE = 4;

    /*
     * =========================
     * DOM
     * =========================
     */

    const slotsLoading =
      document.getElementById(
        'slots-loading'
      );

    const slotsError =
      document.getElementById(
        'slots-error'
      );

    const slotsErrorMessage =
      document.getElementById(
        'slots-error-message'
      );

    const slotsEmpty =
      document.getElementById(
        'slots-empty'
      );

    const slotsGrid =
      document.getElementById(
        'slots-grid'
      );

    const slotsCount =
      document.getElementById(
        'slots-count'
      );

    const retrySlots =
      document.getElementById(
        'retry-slots'
      );

    const pagination =
      document.getElementById(
        'pagination'
      );

    const paginationPages =
      document.getElementById(
        'pagination-pages'
      );

    const previousPage =
      document.getElementById(
        'previous-page'
      );

    const nextPage =
      document.getElementById(
        'next-page'
      );

    /*
     * =========================
     * Booking modal DOM
     * =========================
     */

    const modal =
      document.getElementById(
        'booking-modal'
      );

    const closeButton =
      document.getElementById(
        'close-modal'
      );

    const bookingForm =
      document.getElementById(
        'booking-form'
      );

    const reasonInput =
      document.getElementById(
        'reason'
      );

    const modalDate =
      document.getElementById(
        'modal-date'
      );

    const modalTime =
      document.getElementById(
        'modal-time'
      );

    const modalTherapist =
      document.getElementById(
        'modal-therapist'
      );

    const bookingError =
      document.getElementById(
        'booking-error'
      );

    const submitButton =
      document.getElementById(
        'submit-booking'
      );

    const submitText =
      document.getElementById(
        'submit-text'
      );

    const submitLoading =
      document.getElementById(
        'submit-loading'
      );

    /*
     * =========================
     * State
     * =========================
     */

    let currentPage = 1;
    let totalCount = 0;
    let totalPages = 0;
    let selectedSlotId = null;

    /*
     * =========================
     * Helpers
     * =========================
     */

    const getPageFromUrl = () => {
      const params =
        new URLSearchParams(
          window.location.search
        );

      const page =
        Number(
          params.get('page') || '1'
        );

      return Number.isFinite(page) &&
        page > 0
        ? Math.floor(page)
        : 1;
    };

    const updatePageUrl = (page) => {
      const url =
        new URL(
          window.location.href
        );

      if (page <= 1) {
        url.searchParams.delete(
          'page'
        );
      } else {
        url.searchParams.set(
          'page',
          String(page)
        );
      }

      window.history.pushState(
        {},
        '',
        url
      );
    };

    const formatTime = (time) => {
      if (!time) {
        return '-';
      }

      return String(time).slice(
        0,
        5
      );
    };

    const formatDate = (date) => {
      if (!date) {
        return '-';
      }

      const parts =
        String(date).split('-');

      if (parts.length !== 3) {
        return date;
      }

      const [
        year,
        month,
        day,
      ] = parts;

      return `${year}/${month}/${day}`;
    };

    const escapeHtml = (value) => {
      const div =
        document.createElement(
          'div'
        );

      div.textContent =
        value ?? '';

      return div.innerHTML;
    };

    /*
     * =========================
     * UI states
     * =========================
     */

    const showLoading = () => {
      slotsLoading.hidden = false;
      slotsError.hidden = true;
      slotsEmpty.hidden = true;
      slotsGrid.hidden = true;
      pagination.hidden = true;
      slotsCount.hidden = true;
    };

    const showError = (message) => {
      slotsLoading.hidden = true;
      slotsError.hidden = false;
      slotsEmpty.hidden = true;
      slotsGrid.hidden = true;
      pagination.hidden = true;
      slotsCount.hidden = true;

      slotsErrorMessage.textContent =
        message ||
        'ارتباط با سرور برقرار نشد.';
    };

    const showEmpty = () => {
      slotsLoading.hidden = true;
      slotsError.hidden = true;
      slotsEmpty.hidden = false;
      slotsGrid.hidden = true;
      pagination.hidden = true;

      if (totalCount > 0) {
        slotsCount.textContent =
          `${totalCount} نوبت موجود`;

        slotsCount.hidden = false;
      } else {
        slotsCount.hidden = true;
      }
    };

    const showSlots = () => {
      slotsLoading.hidden = true;
      slotsError.hidden = true;
      slotsEmpty.hidden = true;
      slotsGrid.hidden = false;

      if (totalCount > 0) {
        slotsCount.textContent =
          `${totalCount} نوبت موجود`;

        slotsCount.hidden = false;
      } else {
        slotsCount.hidden = true;
      }
    };

    /*
     * =========================
     * Render slots
     * =========================
     */

    const renderSlots = (slots) => {
      slotsGrid.innerHTML = '';

      slots.forEach((slot) => {
        const therapist =
          slot.therapist || {};

        const therapistName =
          `${therapist.first_name || ''} ${therapist.last_name || ''}`
            .trim() ||
          'روان‌درمانگر';

        const card =
          document.createElement(
            'article'
          );

        card.className =
          'slot-card';

        card.innerHTML = `
          <div class="slot-card-header">
            <div class="slot-icon">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
              >
                <path
                  d="M7 3V6M17 3V6M4 9H20M6 5H18C19.1046 5 20 5.89543 20 7V19C20 20.1046 19.1046 21 18 21H6C4.89543 21 4 20.1046 4 19V7C4 5.89543 4.89543 5 6 5Z"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </div>

            <span class="available-badge">
              آزاد
            </span>
          </div>

          <div class="slot-info">
            <div class="info-row">
              <span>
                تاریخ
              </span>

              <strong>
                ${escapeHtml(
                  formatDate(
                    slot.date
                  )
                )}
              </strong>
            </div>

            <div class="info-row">
              <span>
                ساعت
              </span>

              <strong>
                ${escapeHtml(
                  formatTime(
                    slot.time
                  )
                )}
              </strong>
            </div>

            <div class="info-row">
              <span>
                روان‌درمانگر
              </span>

              <strong>
                ${escapeHtml(
                  therapistName
                )}
              </strong>
            </div>
          </div>

          <button
            type="button"
            class="book-button"
            data-slot-id="${escapeHtml(
              slot.id
            )}"
            data-slot-date="${escapeHtml(
              formatDate(
                slot.date
              )
            )}"
            data-slot-time="${escapeHtml(
              formatTime(
                slot.time
              )
            )}"
            data-therapist="${escapeHtml(
              therapistName
            )}"
          >
            رزرو نوبت
          </button>
        `;

        slotsGrid.appendChild(
          card
        );
      });
    };

    /*
     * =========================
     * Pagination
     * =========================
     */

    const renderPagination = () => {
      paginationPages.innerHTML = '';

      if (totalPages <= 1) {
        pagination.hidden = true;
        return;
      }

      pagination.hidden = false;

      previousPage.disabled =
        currentPage <= 1;

      nextPage.disabled =
        currentPage >= totalPages;

      previousPage.classList.toggle(
        'disabled',
        currentPage <= 1
      );

      nextPage.classList.toggle(
        'disabled',
        currentPage >= totalPages
      );

      for (
        let page = 1;
        page <= totalPages;
        page++
      ) {
        const button =
          document.createElement(
            'button'
          );

        button.type = 'button';

        button.className =
          'pagination-page';

        if (
          page === currentPage
        ) {
          button.classList.add(
            'active'
          );
        }

        button.textContent =
          String(page);

        button.addEventListener(
          'click',
          () => {
            loadSlots(page);
          }
        );

        paginationPages.appendChild(
          button
        );
      }
    };

    /*
     * =========================
     * Load appointment slots
     * =========================
     */

    const loadSlots = async (
      page = 1
    ) => {
      currentPage = Math.max(
        1,
        Number(page) || 1
      );

      showLoading();

      try {
        const url =
          `${APPOINTMENT_SLOTS_URL}?page=${currentPage}&page_size=${PAGE_SIZE}`;

        const response =
          await fetch(url, {
            method: 'GET',
            credentials: 'include',
            headers: {
              Accept:
                'application/json',
            },
          });

        const data =
          await response
            .json()
            .catch(() => ({}));

        if (!response.ok) {
          throw new Error(
            data.detail ||
              'دریافت نوبت‌ها انجام نشد.'
          );
        }

        const slots =
          Array.isArray(
            data.results
          )
            ? data.results
            : [];

        totalCount =
          Number(data.count) || 0;

        totalPages =
          Math.ceil(
            totalCount /
              PAGE_SIZE
          );

        if (
          totalPages > 0 &&
          currentPage > totalPages
        ) {
          loadSlots(totalPages);
          return;
        }

        updatePageUrl(
          currentPage
        );

        if (slots.length === 0) {
          showEmpty();
          return;
        }

        renderSlots(slots);
        renderPagination();
        showSlots();

        window.scrollTo({
          top: 0,
          behavior: 'smooth',
        });

      } catch (error) {
        console.error(
          'APPOINTMENT SLOTS ERROR:',
          error
        );

        showError(
          error instanceof Error
            ? error.message
            : 'ارتباط با سرور برقرار نشد.'
        );
      }
    };

    /*
     * =========================
     * Pagination buttons
     * =========================
     */

    previousPage.addEventListener(
      'click',
      () => {
        if (currentPage <= 1) {
          return;
        }

        loadSlots(
          currentPage - 1
        );
      }
    );

    nextPage.addEventListener(
      'click',
      () => {
        if (
          currentPage >=
          totalPages
        ) {
          return;
        }

        loadSlots(
          currentPage + 1
        );
      }
    );

    retrySlots.addEventListener(
      'click',
      () => {
        loadSlots(
          currentPage
        );
      }
    );

    /*
     * =========================
     * Browser back / forward
     * =========================
     */

    window.addEventListener(
      'popstate',
      () => {
        loadSlots(
          getPageFromUrl()
        );
      }
    );

    /*
     * =========================
     * Open booking modal
     * =========================
     */

    slotsGrid.addEventListener(
      'click',
      (event) => {
        const button =
          event.target.closest(
            '.book-button'
          );

        if (!button) {
          return;
        }

        selectedSlotId =
          button.getAttribute(
            'data-slot-id'
          );

        const date =
          button.getAttribute(
            'data-slot-date'
          );

        const time =
          button.getAttribute(
            'data-slot-time'
          );

        const therapist =
          button.getAttribute(
            'data-therapist'
          );

        modalDate.textContent =
          date || '-';

        modalTime.textContent =
          time || '-';

        modalTherapist.textContent =
          therapist ||
          'روان‌درمانگر';

        reasonInput.value = '';

        bookingError.hidden = true;
        bookingError.textContent = '';

        modal.classList.add(
          'show'
        );

        modal.setAttribute(
          'aria-hidden',
          'false'
        );

        document.body.style.overflow =
          'hidden';

        setTimeout(() => {
          reasonInput.focus();
        }, 50);
      }
    );

    /*
     * =========================
     * Close modal
     * =========================
     */

    const closeModal = () => {
      modal.classList.remove(
        'show'
      );

      modal.setAttribute(
        'aria-hidden',
        'true'
      );

      document.body.style.overflow =
        '';

      selectedSlotId = null;
    };

    closeButton.addEventListener(
      'click',
      closeModal
    );

    modal.addEventListener(
      'click',
      (event) => {
        if (
          event.target === modal
        ) {
          closeModal();
        }
      }
    );

    document.addEventListener(
      'keydown',
      (event) => {
        if (
          event.key === 'Escape' &&
          modal.classList.contains(
            'show'
          )
        ) {
          closeModal();
        }
      }
    );

    /*
     * =========================
     * Submit booking
     * =========================
     */

    bookingForm.addEventListener(
      'submit',
      async (event) => {
        event.preventDefault();

        const reason =
          reasonInput.value.trim();

        if (!selectedSlotId) {
          bookingError.textContent =
            'نوبت انتخاب نشده است.';

          bookingError.hidden =
            false;

          return;
        }

        if (!reason) {
          bookingError.textContent =
            'لطفاً دلیل مراجعه را وارد کنید.';

          bookingError.hidden =
            false;

          reasonInput.focus();

          return;
        }

        bookingError.hidden =
          true;

        submitButton.disabled =
          true;

        submitText.hidden =
          true;

        submitLoading.hidden =
          false;

        try {
          const response =
            await fetch(
              BOOKING_URL(
                selectedSlotId
              ),
              {
                method: 'POST',

                credentials:
                  'include',

                headers: {
                  'Content-Type':
                    'application/json',
                },

                body: JSON.stringify({
                  reason: reason,
                }),
              }
            );

          const data =
            await response
              .json()
              .catch(() => ({}));

          console.log(
            'BOOKING RESPONSE:',
            response.status,
            data
          );

          if (
            response.status ===
            401
          ) {
            bookingError.textContent =
              'برای رزرو نوبت ابتدا باید وارد حساب کاربری شوید.';

            bookingError.hidden =
              false;

            return;
          }

          if (
            response.status ===
            409
          ) {
            bookingError.textContent =
              data.detail ||
              'این نوبت قبلاً رزرو شده است.';

            bookingError.hidden =
              false;

            return;
          }

          if (!response.ok) {
            bookingError.textContent =
              data.detail ||
              'رزرو نوبت انجام نشد.';

            bookingError.hidden =
              false;

            return;
          }

          alert(
            'نوبت شما با موفقیت رزرو شد.'
          );

          window.location.reload();

        } catch (error) {
          console.error(
            'BOOKING ERROR:',
            error
          );

          bookingError.textContent =
            'ارتباط با سرور برقرار نشد.';

          bookingError.hidden =
            false;

        } finally {
          submitButton.disabled =
            false;

          submitText.hidden =
            false;

          submitLoading.hidden =
            true;
        }
      }
    );

    /*
     * =========================
     * Initial load
     * =========================
     */

    loadSlots(
      getPageFromUrl()
    );
  })();
</script>

<style>
  :global(body) {
    margin: 0;
    background: #f8f9fb;
    color: #20242a;
  }

  .booking-page {
    min-height: 70vh;
  }

  .hero-section {
    padding: 90px 20px 70px;
    text-align: center;
    background: linear-gradient(
      135deg,
