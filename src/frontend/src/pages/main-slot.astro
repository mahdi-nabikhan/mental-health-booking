---
import Layout from '@layouts/Layout.astro';
import Navbar from '@components/Navbar.astro';
import Footer from '@components/Footer.astro';

const intro = 'رزرو نوبت';

interface Therapist {
  id: number;
  first_name: string;
  last_name: string;
  phone_number: string;
  user: {
    email: string;
    id: number;
  };
}

interface AppointmentSlot {
  id: number;
  date: string;
  time: string;
  created_at: string;
  therapist: Therapist;
}

interface AppointmentSlotsResponse {
  links: {
    next: string | null;
    previous: string | null;
  };
  count: number;
  results: AppointmentSlot[];
}

let appointmentSlots: AppointmentSlot[] = [];
let totalCount = 0;

const currentPage = Math.max(
  1,
  Number(Astro.url.searchParams.get('page') ?? '1')
);

const pageSize = 4;

try {
  const response = await fetch(
    `http://localhost:8000/api/v1/booking/appointment-slots/available/?page=${currentPage}&page_size=${pageSize}`
  );

  if (response.ok) {
    const data: AppointmentSlotsResponse =
      await response.json();

    appointmentSlots = Array.isArray(data.results)
      ? data.results
      : [];

    totalCount = data.count ?? 0;
  }
} catch (error) {
  console.warn(
    'Appointment slots are currently unavailable.'
  );
}

const totalPages = Math.ceil(
  totalCount / pageSize
);

const formatTime = (time: string) => {
  return time.slice(0, 5);
};

const formatDate = (date: string) => {
  const [year, month, day] = date.split('-');

  return `${year}/${month}/${day}`;
};
---

<Layout title={intro}>
  <Navbar />

  <main class="booking-page">
    <section class="hero-section">
      <div class="hero-content">
        <span class="hero-badge">
          رزرو آنلاین
        </span>

        <h1>
          رزرو نوبت مشاوره
        </h1>

        <p>
          زمان مناسب خود را انتخاب کنید و برای جلسه
          مشاوره نوبت بگیرید.
        </p>
      </div>
    </section>

    <section class="slots-section">
      <div class="section-header">
        <div>
          <span class="section-label">
            نوبت‌های موجود
          </span>

          <h2>
            زمان‌های مشاوره
          </h2>

          <p>
            یکی از زمان‌های آزاد را برای رزرو جلسه
            انتخاب کنید.
          </p>
        </div>

        {
          totalCount > 0 && (
            <div class="slots-count">
              {totalCount} نوبت موجود
            </div>
          )
        }
      </div>

      {
        appointmentSlots.length > 0 ? (
          <>
            <div class="slots-grid">
              {appointmentSlots.map((slot) => {
                const therapistName =
                  `${slot.therapist.first_name} ${slot.therapist.last_name}`.trim();

                return (
                  <article class="slot-card">
                    <div class="slot-card-header">
                      <div class="slot-icon">
                        <svg
                          viewBox="0 0 24 24"
                          fill="none"
                          xmlns="http://www.w3.org/2000/svg"
                        >
                          <path
                            d="M7 3V6M17 3V6M4 9H20M6 5H18C19.1046 5 20 5.89543 20 7V19C20 20.1046 19.1046 21 18 21H6C4.89543 21 4 20.1046 4 19V7C4 5.89543 4.89543 5 6 5Z"
                            stroke="currentColor"
                            stroke-width="1.8"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                          />
                        </svg>
                      </div>

                      <span class="available-badge">
                        آزاد
                      </span>
                    </div>

                    <div class="slot-info">
                      <div class="info-row">
                        <span>
                          تاریخ
                        </span>

                        <strong>
                          {formatDate(slot.date)}
                        </strong>
                      </div>

                      <div class="info-row">
                        <span>
                          ساعت
                        </span>

                        <strong>
                          {formatTime(slot.time)}
                        </strong>
                      </div>

                      <div class="info-row">
                        <span>
                          روان‌درمانگر
                        </span>

                        <strong>
                          {therapistName ||
                            'روان‌درمانگر'}
                        </strong>
                      </div>
                    </div>

                    <button
                      type="button"
                      class="book-button"
                      data-slot-id={slot.id}
                      data-slot-date={formatDate(slot.date)}
                      data-slot-time={formatTime(slot.time)}
                      data-therapist={therapistName}
                    >
                      رزرو نوبت
                    </button>
                  </article>
                );
              })}
            </div>

            {
              totalPages > 1 && (
                <nav
                  class="pagination"
                  aria-label="صفحه‌بندی"
                >
                  <a
                    href={
                      currentPage > 1
                        ? `/main-slot?page=${currentPage - 1}`
                        : '#'
                    }
                    class:list={[
                      'pagination-button',
                      {
                        disabled:
                          currentPage <= 1,
                      },
                    ]}
                    aria-disabled={
                      currentPage <= 1
                    }
                  >
                    قبلی
                  </a>

                  <div class="pagination-pages">
                    {Array.from(
                      {
                        length: totalPages,
                      },
                      (_, index) => index + 1
                    ).map((page) => (
                      <a
                        href={`/main-slot?page=${page}`}
                        class:list={[
                          'pagination-page',
                          {
                            active:
                              page ===
                              currentPage,
                          },
                        ]}
                      >
                        {page}
                      </a>
                    ))}
                  </div>

                  <a
                    href={
                      currentPage < totalPages
                        ? `/main-slot?page=${currentPage + 1}`
                        : '#'
                    }
                    class:list={[
                      'pagination-button',
                      {
                        disabled:
                          currentPage >=
                          totalPages,
                      },
                    ]}
                    aria-disabled={
                      currentPage >=
                      totalPages
                    }
                  >
                    بعدی
                  </a>
                </nav>
              )
            }
          </>
        ) : (
          <div class="empty-state">
            <div class="empty-icon">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
              >
                <path
                  d="M7 3V6M17 3V6M4 9H20M6 5H18C19.1046 5 20 5.89543 20 7V19C20 20.1046 19.1046 21 18 21H6C4.89543 21 4 20.1046 4 19V7C4 5.89543 4 5 6 5Z"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </div>

            <h3>
              در حال حاضر نوبتی موجود نیست
            </h3>

            <p>
              در حال حاضر هیچ زمان آزادی برای رزرو
              وجود ندارد.
            </p>
          </div>
        )
      }
    </section>
  </main>

  <!-- Booking Modal -->
  <div
    id="booking-modal"
    class="booking-modal"
    aria-hidden="true"
  >
    <div
      class="booking-modal-content"
      role="dialog"
      aria-modal="true"
      aria-labelledby="booking-modal-title"
    >
      <button
        type="button"
        id="close-modal"
        class="close-modal"
        aria-label="بستن"
      >
        ×
      </button>

      <div class="modal-header">
        <span class="modal-label">
          رزرو نوبت
        </span>

        <h2 id="booking-modal-title">
          تکمیل رزرو
        </h2>

        <p>
          اطلاعات نوبت را بررسی کنید و دلیل مراجعه
          خود را وارد کنید.
        </p>
      </div>

      <div class="selected-slot">
        <div class="selected-slot-item">
          <span>
            تاریخ
          </span>

          <strong id="modal-date">
            -
          </strong>
        </div>

        <div class="selected-slot-item">
          <span>
            ساعت
          </span>

          <strong id="modal-time">
            -
          </strong>
        </div>

        <div class="selected-slot-item">
          <span>
            روان‌درمانگر
          </span>

          <strong id="modal-therapist">
            -
          </strong>
        </div>
      </div>

      <form id="booking-form">
        <div class="form-group">
          <label for="reason">
            دلیل مراجعه
          </label>

          <textarea
            id="reason"
            name="reason"
            rows="5"
            required
            placeholder="لطفاً دلیل مراجعه خود را به صورت کوتاه وارد کنید..."
          ></textarea>
        </div>

        <div
          id="booking-error"
          class="booking-error"
          hidden
        ></div>

        <button
          type="submit"
          id="submit-booking"
          class="submit-booking"
        >
          <span id="submit-text">
            تأیید و رزرو نوبت
          </span>

          <span
            id="submit-loading"
            hidden
          >
            در حال ثبت...
          </span>
        </button>
      </form>
    </div>
  </div>

  <Footer />
</Layout>

<script is:inline>
  (() => {
    const modal =
      document.getElementById(
        'booking-modal'
      );

    const closeButton =
      document.getElementById(
        'close-modal'
      );

    const bookingForm =
      document.getElementById(
        'booking-form'
      );

    const reasonInput =
      document.getElementById(
        'reason'
      );

    const modalDate =
      document.getElementById(
        'modal-date'
      );

    const modalTime =
      document.getElementById(
        'modal-time'
      );

    const modalTherapist =
      document.getElementById(
        'modal-therapist'
      );

    const bookingError =
      document.getElementById(
        'booking-error'
      );

    const submitButton =
      document.getElementById(
        'submit-booking'
      );

    const submitText =
      document.getElementById(
        'submit-text'
      );

    const submitLoading =
      document.getElementById(
        'submit-loading'
      );

    let selectedSlotId = null;

    console.log(
      'BOOKING SCRIPT LOADED'
    );


    /*
     * باز کردن مودال
     */
    const bookButtons =
      document.querySelectorAll(
        '.book-button'
      );

    console.log(
      'BOOK BUTTONS:',
      bookButtons.length
    );

    bookButtons.forEach(
      (button) => {
        button.addEventListener(
          'click',
          () => {
            console.log(
              'BOOK BUTTON CLICKED'
            );

            selectedSlotId =
              button.getAttribute(
                'data-slot-id'
              );

            const date =
              button.getAttribute(
                'data-slot-date'
              );

            const time =
              button.getAttribute(
                'data-slot-time'
              );

            const therapist =
              button.getAttribute(
                'data-therapist'
              );

            console.log({
              selectedSlotId,
              date,
              time,
              therapist,
            });

            modalDate.textContent =
              date || '-';

            modalTime.textContent =
              time || '-';

            modalTherapist.textContent =
              therapist ||
              'روان‌درمانگر';

            reasonInput.value = '';

            bookingError.hidden = true;
            bookingError.textContent = '';

            modal.classList.add(
              'show'
            );

            modal.setAttribute(
              'aria-hidden',
              'false'
            );

            document.body.style.overflow =
              'hidden';

            setTimeout(() => {
              reasonInput.focus();
            }, 50);
          }
        );
      }
    );


    /*
     * بستن مودال
     */
    closeButton.addEventListener(
      'click',
      () => {
        modal.classList.remove(
          'show'
        );

        modal.setAttribute(
          'aria-hidden',
          'true'
        );

        document.body.style.overflow =
          '';

        selectedSlotId = null;
      }
    );


    /*
     * بستن با کلیک بیرون
     */
    modal.addEventListener(
      'click',
      (event) => {
        if (
          event.target === modal
        ) {
          modal.classList.remove(
            'show'
          );

          modal.setAttribute(
            'aria-hidden',
            'true'
          );

          document.body.style.overflow =
            '';

          selectedSlotId = null;
        }
      }
    );


    /*
     * بستن با Escape
     */
    document.addEventListener(
      'keydown',
      (event) => {
        if (
          event.key === 'Escape' &&
          modal.classList.contains(
            'show'
          )
        ) {
          modal.classList.remove(
            'show'
          );

          modal.setAttribute(
            'aria-hidden',
            'true'
          );

          document.body.style.overflow =
            '';

          selectedSlotId = null;
        }
      }
    );


    /*
     * ارسال رزرو
     */
    bookingForm.addEventListener(
      'submit',
      async (event) => {
        event.preventDefault();

        const reason =
          reasonInput.value.trim();

        if (!selectedSlotId) {
          bookingError.textContent =
            'نوبت انتخاب نشده است.';

          bookingError.hidden = false;

          return;
        }

        if (!reason) {
          bookingError.textContent =
            'لطفاً دلیل مراجعه را وارد کنید.';

          bookingError.hidden = false;

          reasonInput.focus();

          return;
        }

        bookingError.hidden = true;

        submitButton.disabled = true;

        submitText.hidden = true;

        submitLoading.hidden = false;

        try {
          const response =
            await fetch(
              `http://localhost:8000/api/v1/booking/appointments/create/${selectedSlotId}/`,
              {
                method: 'POST',

                credentials: 'include',

                headers: {
                  'Content-Type':
                    'application/json',
                },

                body: JSON.stringify({
                  reason: reason,
                }),
              }
            );

          const data =
            await response
              .json()
              .catch(() => ({}));

          console.log(
            'BOOKING RESPONSE:',
            response.status,
            data
          );


          if (
            response.status === 401
          ) {
            bookingError.textContent =
              'برای رزرو نوبت ابتدا باید وارد حساب کاربری شوید.';

            bookingError.hidden = false;

            return;
          }


          if (
            response.status === 409
          ) {
            bookingError.textContent =
              data.detail ||
              'این نوبت قبلاً رزرو شده است.';

            bookingError.hidden = false;

            return;
          }


          if (!response.ok) {
            bookingError.textContent =
              data.detail ||
              'رزرو نوبت انجام نشد.';

            bookingError.hidden = false;

            return;
          }


          alert(
            'نوبت شما با موفقیت رزرو شد.'
          );

          window.location.reload();

        } catch (error) {
          console.error(
            'BOOKING ERROR:',
            error
          );

          bookingError.textContent =
            'ارتباط با سرور برقرار نشد.';

          bookingError.hidden = false;

        } finally {
          submitButton.disabled =
            false;

          submitText.hidden =
            false;

          submitLoading.hidden =
            true;
        }
      }
    );
  })();
</script>

<style>
  :global(body) {
    margin: 0;
    background: #f8f9fb;
    color: #20242a;
  }

  .booking-page {
    min-height: 70vh;
  }

  .hero-section {
    padding: 90px 20px 70px;
    text-align: center;
    background: linear-gradient(
      135deg,
      #f3f5f8 0%,
      #ffffff 100%
    );
  }

  .hero-content {
    max-width: 760px;
    margin: 0 auto;
  }

  .hero-badge {
    display: inline-flex;
    padding: 8px 16px;
    margin-bottom: 18px;
    border-radius: 999px;
    background: #eef1f5;
    color: #555d68;
    font-size: 14px;
    font-weight: 600;
  }

  .hero-content h1 {
    margin: 0 0 18px;
    font-size: clamp(32px, 5vw, 52px);
    line-height: 1.3;
    font-weight: 800;
  }

  .hero-content p {
    margin: 0;
    color: #69717c;
    font-size: 17px;
    line-height: 2;
  }

  .slots-section {
    max-width: 1180px;
    margin: 0 auto;
    padding: 70px 20px 100px;
  }

  .section-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 30px;
    margin-bottom: 35px;
  }

  .section-label {
    display: block;
    margin-bottom: 8px;
    color: #777f89;
    font-size: 14px;
    font-weight: 700;
  }

  .section-header h2 {
    margin: 0 0 10px;
    font-size: 30px;
    font-weight: 800;
  }

  .section-header p {
    margin: 0;
    color: #737b85;
    line-height: 1.8;
  }

  .slots-count {
    padding: 10px 16px;
    border: 1px solid #e6e9ed;
    border-radius: 10px;
    background: #fff;
    color: #555d67;
    font-size: 14px;
    font-weight: 600;
  }

  .slots-grid {
    display: grid;
    grid-template-columns:
      repeat(2, minmax(0, 1fr));
    gap: 20px;
  }

  .slot-card {
    padding: 26px;
    border: 1px solid #e5e8ec;
    border-radius: 18px;
    background: #fff;
    box-shadow:
      0 8px 30px rgba(20, 25, 30, 0.05);
  }

  .slot-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 24px;
  }

  .slot-icon {
    width: 46px;
    height: 46px;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 12px;
    background: #f1f3f6;
    color: #4f5761;
  }

  .slot-icon svg {
    width: 23px;
    height: 23px;
  }

  .available-badge {
    padding: 7px 12px;
    border-radius: 8px;
    background: #f1f3f6;
    color: #4d555f;
    font-size: 13px;
    font-weight: 700;
  }

  .slot-info {
    display: flex;
    flex-direction: column;
    gap: 15px;
    margin-bottom: 25px;
  }

  .info-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 15px;
  }

  .info-row span {
    color: #818892;
    font-size: 14px;
  }

  .info-row strong {
    color: #252a30;
    font-size: 15px;
  }

  .book-button {
    width: 100%;
    min-height: 48px;

    border: 0;
    border-radius: 11px;

    background: #252a30;
    color: #fff;

    cursor: pointer;

    font-family: inherit;
    font-size: 15px;
    font-weight: 700;
  }

  .book-button:hover {
    background: #171a1e;
  }

  .pagination {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 18px;
    margin-top: 45px;
  }

  .pagination-pages {
    display: flex;
    gap: 8px;
  }

  .pagination-button,
  .pagination-page {
    min-width: 42px;
    height: 42px;

    display: inline-flex;
    align-items: center;
    justify-content: center;

    padding: 0 12px;
    box-sizing: border-box;

    border: 1px solid #e2e5e9;
    border-radius: 9px;

    background: #fff;
    color: #454c55;

    text-decoration: none;

    font-size: 14px;
    font-weight: 600;
  }

  .pagination-page.active {
    background: #252a30;
    border-color: #252a30;
    color: #fff;
  }

  .pagination-button.disabled {
    opacity: 0.45;
    pointer-events: none;
  }

  .empty-state {
    padding: 70px 20px;

    border: 1px dashed #dfe3e8;
    border-radius: 18px;

    background: #fff;

    text-align: center;
  }

  .empty-icon {
    width: 60px;
    height: 60px;

    display: flex;
    align-items: center;
    justify-content: center;

    margin: 0 auto 20px;

    border-radius: 16px;

    background: #f1f3f5;
    color: #666e78;
  }

  .empty-icon svg {
    width: 28px;
    height: 28px;
  }

  .empty-state h3 {
    margin: 0 0 10px;
    font-size: 21px;
  }

  .empty-state p {
    max-width: 500px;
    margin: 0 auto;
    color: #747c86;
    line-height: 1.9;
  }


  /* =========================
     Booking Modal
     ========================= */

  .booking-modal {
    position: fixed;
    inset: 0;

    z-index: 999999;

    display: none;

    align-items: center;
    justify-content: center;

    padding: 20px;
    box-sizing: border-box;

    background: rgba(0, 0, 0, 0.55);
  }

  .booking-modal.show {
    display: flex;
  }

  .booking-modal-content {
    position: relative;

    width: min(100%, 540px);
    max-height: calc(100vh - 40px);

    overflow-y: auto;

    padding: 32px;
    box-sizing: border-box;

    border-radius: 20px;

    background: #fff;

    box-shadow:
      0 24px 70px rgba(0, 0, 0, 0.25);
  }

  .close-modal {
    position: absolute;

    top: 16px;
    left: 16px;

    width: 40px;
    height: 40px;

    display: flex;
    align-items: center;
    justify-content: center;

    padding: 0;

    border: 0;
    border-radius: 10px;

    background: #f1f3f5;
    color: #555d66;

    cursor: pointer;

    font-family: inherit;
    font-size: 26px;
    line-height: 1;
  }

  .modal-header {
    padding-left: 45px;
    margin-bottom: 25px;
  }

  .modal-label {
    display: block;
    margin-bottom: 7px;

    color: #7b838d;

    font-size: 13px;
    font-weight: 700;
  }

  .modal-header h2 {
    margin: 0 0 8px;

    font-size: 27px;
    font-weight: 800;
  }

  .modal-header p {
    margin: 0;

    color: #747c85;

    font-size: 14px;
    line-height: 1.9;
  }

  .selected-slot {
    display: grid;
    grid-template-columns:
      repeat(3, minmax(0, 1fr));

    gap: 10px;

    margin-bottom: 25px;
  }

  .selected-slot-item {
    min-width: 0;

    padding: 14px;

    border-radius: 12px;

    background: #f6f7f8;
  }

  .selected-slot-item span {
    display: block;

    margin-bottom: 7px;

    color: #818892;

    font-size: 12px;
  }

  .selected-slot-item strong {
