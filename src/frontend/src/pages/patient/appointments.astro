
---
import PatientLayout from "../../layouts/PatientLayout.astro";

const appointments = [
    {
        date: "Sep 15, 2026",
        time: "10:00 AM",
        therapist: "Dr. Sarah Johnson",
        type: "Individual Session",
        status: "scheduled",
    },
    {
        date: "Sep 18, 2026",
        time: "02:30 PM",
        therapist: "Dr. Michael Brown",
        type: "Consultation",
        status: "scheduled",
    },
    {
        date: "Sep 22, 2026",
        time: "11:00 AM",
        therapist: "Dr. Sarah Johnson",
        type: "Follow-up",
        status: "scheduled",
    },
    {
        date: "Sep 05, 2026",
        time: "04:00 PM",
        therapist: "Dr. Sarah Johnson",
        type: "Individual Session",
        status: "completed",
    },
    {
        date: "Aug 28, 2026",
        time: "01:00 PM",
        therapist: "Dr. Michael Brown",
        type: "Consultation",
        status: "completed",
    },
    {
        date: "Aug 20, 2026",
        time: "11:30 AM",
        therapist: "Dr. Sarah Johnson",
        type: "Follow-up",
        status: "cancelled",
    },
];

const upcomingAppointments = appointments.filter(
    (appointment) => appointment.status === "scheduled",
);

const pastAppointments = appointments.filter(
    (appointment) =>
        appointment.status === "completed" ||
        appointment.status === "cancelled",
);
---

<PatientLayout title="My Appointments">
    <div class="appointments-page">
        <!-- Page Header -->
        <section class="page-header">
            <div>
                <h2>My Appointments</h2>
                <p>
                    View and manage your upcoming and previous appointments.
                </p>
            </div>

            <a href="/patient/slots" class="primary-btn">
                <i class="fa-solid fa-calendar-plus"></i>
                Book Appointment
            </a>
        </section>

        <!-- Upcoming -->
        <section class="appointments-section">
            <div class="section-header">
                <div>
                    <h3>Upcoming Appointments</h3>
                    <p>Your scheduled sessions</p>
                </div>

                <span class="count-badge">
                    {upcomingAppointments.length}
                </span>
            </div>

            <div class="appointments-card">
                {
                    upcomingAppointments.length > 0 ? (
                        <div class="table-wrapper">
                            <table>
                                <thead>
                                    <tr>
                                        <th>Date</th>
                                        <th>Time</th>
                                        <th>Therapist</th>
                                        <th>Type</th>
                                        <th>Status</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>

                                <tbody>
                                    {upcomingAppointments.map(
                                        (appointment) => (
                                            <tr>
                                                <td>
                                                    {appointment.date}
                                                </td>

                                                <td>
                                                    {appointment.time}
                                                </td>

                                                <td>
                                                    <div class="therapist">
                                                        <div class="therapist-avatar">
                                                            <i class="fa-solid fa-user-doctor"></i>
                                                        </div>

                                                        <span>
                                                            {
                                                                appointment.therapist
                                                            }
                                                        </span>
                                                    </div>
                                                </td>

                                                <td>
                                                    {appointment.type}
                                                </td>

                                                <td>
                                                    <span class="status scheduled">
                                                        <span class="status-dot"></span>
                                                        Scheduled
                                                    </span>
                                                </td>

                                                <td>
                                                    <button
                                                        type="button"
                                                        class="action-btn cancel-btn"
                                                        data-action="cancel"
                                                    >
                                                        Cancel
                                                    </button>
                                                </td>
                                            </tr>
                                        ),
                                    )}
                                </tbody>
                            </table>
                        </div>
                    ) : (
                        <div class="empty-state">
                            <div class="empty-icon">
                                <i class="fa-solid fa-calendar-xmark"></i>
                            </div>

                            <h4>No upcoming appointments</h4>

                            <p>
                                You don't have any scheduled appointments.
                            </p>

                            <a
                                href="/patient/slots"
                                class="secondary-btn"
                            >
                                Find Available Slots
                            </a>
                        </div>
                    )
                }
            </div>
        </section>

        <!-- Appointment History -->
        <section class="appointments-section">
            <div class="section-header">
                <div>
                    <h3>Appointment History</h3>
                    <p>Your completed and cancelled sessions</p>
                </div>

                <span class="count-badge">
                    {pastAppointments.length}
                </span>
            </div>

            <div class="appointments-card">
                {
                    pastAppointments.length > 0 ? (
                        <div class="table-wrapper">
                            <table>
                                <thead>
                                    <tr>
                                        <th>Date</th>
                                        <th>Time</th>
                                        <th>Therapist</th>
                                        <th>Type</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>

                                <tbody>
                                    {pastAppointments.map((appointment) => (
                                        <tr>
                                            <td>{appointment.date}</td>

                                            <td>{appointment.time}</td>

                                            <td>
                                                <div class="therapist">
                                                    <div class="therapist-avatar">
                                                        <i class="fa-solid fa-user-doctor"></i>
                                                    </div>

                                                    <span>
                                                        {
                                                            appointment.therapist
                                                        }
                                                    </span>
                                                </div>
                                            </td>

                                            <td>{appointment.type}</td>

                                            <td>
                                                {
                                                    appointment.status ===
                                                    "completed" ? (
                                                        <span class="status completed">
                                                            <span class="status-dot"></span>
                                                            Completed
                                                        </span>
                                                    ) : (
                                                        <span class="status cancelled">
                                                            <span class="status-dot"></span>
                                                            Cancelled
                                                        </span>
                                                    )
                                                }
                                            </td>
                                        </tr>
                                    ))}
                                </tbody>
                            </table>
                        </div>
                    ) : (
                        <div class="empty-state">
                            <div class="empty-icon">
                                <i class="fa-solid fa-clock-rotate-left"></i>
                            </div>

                            <h4>No appointment history</h4>

                            <p>
                                Your completed and cancelled appointments
                                will appear here.
                            </p>
                        </div>
                    )
                }
            </div>
        </section>
    </div>
</PatientLayout>

<script>
    const cancelButtons =
        document.querySelectorAll<HTMLButtonElement>(
            '[data-action="cancel"]',
        );

    cancelButtons.forEach((button) => {
        button.addEventListener("click", () => {
            const confirmed = window.confirm(
                "Are you sure you want to cancel this appointment?",
            );

            if (!confirmed) {
                return;
            }

            /*
             * API cancellation will be connected here later.
             */
            window.alert(
                "Appointment cancellation will be connected to the API.",
            );
        });
    });
</script>

<style>
    .appointments-page {
        max-width: 1400px;
        margin: 0 auto;
    }

    .page-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;

        margin-bottom: 30px;
    }

    .page-header h2 {
        margin: 0;

        color: #111827;

        font-size: 24px;
        font-weight: 700;
    }

    .page-header p {
        margin: 7px 0 0;

        color: #9ca3af;

        font-size: 14px;
    }

    .primary-btn {
        display: inline-flex;
        align-items: center;
        gap: 9px;

        padding: 11px 17px;

        border: 0;
        border-radius: 8px;

        background: #111827;
        color: #ffffff;

        text-decoration: none;

        font-size: 13px;
        font-weight: 600;

        white-space: nowrap;

        transition:
            background 0.2s ease,
            transform 0.2s ease;
    }

    .primary-btn:hover {
        background: #1f2937;
        transform: translateY(-1px);
    }

    .appointments-section {
        margin-bottom: 30px;
    }

    .section-header {
        display: flex;
        align-items: center;
        justify-content: space-between;

        margin-bottom: 15px;
    }

    .section-header h3 {
        margin: 0;

        color: #111827;

        font-size: 18px;
        font-weight: 700;
    }

    .section-header p {
        margin: 5px 0 0;

        color: #9ca3af;

        font-size: 13px;
    }

    .count-badge {
        min-width: 30px;
        height: 30px;

        display: flex;
        align-items: center;
        justify-content: center;

        padding: 0 9px;

        border-radius: 15px;

        background: #f3f4f6;
        color: #374151;

        font-size: 12px;
        font-weight: 700;
    }

    .appointments-card {
        overflow: hidden;

        border: 1px solid #e5e7eb;
        border-radius: 12px;

        background: #ffffff;
    }

    .table-wrapper {
        width: 100%;
        overflow-x: auto;
    }

    table {
        width: 100%;
        min-width: 850px;

        border-collapse: collapse;
    }

    th {
        padding: 15px 18px;

        background: #f9fafb;
        border-bottom: 1px solid #e5e7eb;

        color: #6b7280;

        font-size: 11px;
        font-weight: 700;
        text-align: left;
        text-transform: uppercase;
    }

    td {
        padding: 17px 18px;

        border-bottom: 1px solid #f0f0f0;

        color: #374151;

        font-size: 13px;
    }

    tbody tr:last-child td {
        border-bottom: 0;
    }

    tbody tr:hover {
        background: #fafafa;
    }

    .therapist {
        display: flex;
        align-items: center;
        gap: 10px;

        color: #111827;
        font-weight: 500;
    }

    .therapist-avatar {
        width: 34px;
        height: 34px;

        flex-shrink: 0;

        display: flex;
        align-items: center;
        justify-content: center;

        border-radius: 50%;

        background: #f3f4f6;
        color: #6b7280;

        font-size: 13px;
    }

    .status {
        display: inline-flex;
        align-items: center;
        gap: 7px;

        font-size: 12px;
        font-weight: 600;
    }

    .status-dot {
        width: 7px;
        height: 7px;

        border-radius: 50%;
    }

    .status.scheduled {
        color: #15803d;
    }

    .status.scheduled .status-dot {
        background: #22c55e;
    }

    .status.completed {
        color: #2563eb;
    }

    .status.completed .status-dot {
        background: #3b82f6;
    }

    .status.cancelled {
        color: #dc2626;
    }

    .status.cancelled .status-dot {
        background: #ef4444;
    }

    .action-btn {
        padding: 7px 12px;

        border-radius: 6px;

        font-size: 12px;
        font-weight: 600;

        cursor: pointer;
    }

    .cancel-btn {
        border: 1px solid #fecaca;

        background: #ffffff;
        color: #dc2626;
    }

    .cancel-btn:hover {
        background: #fef2f2;
    }

    .empty-state {
        padding: 55px 20px;

        display: flex;
        flex-direction: column;
        align-items: center;

        text-align: center;
    }

    .empty-icon {
        width: 58px;
        height: 58px;

        display: flex;
        align-items: center;
        justify-content: center;

        margin-bottom: 15px;

        border-radius: 50%;

        background: #f3f4f6;
        color: #9ca3af;

        font-size: 22px;
    }

    .empty-state h4 {
        margin: 0;

        color: #111827;

        font-size: 16px;
    }

    .empty-state p {
        margin: 7px 0 18px;

        color: #9ca3af;

        font-size: 13px;
    }

    .secondary-btn {
        padding: 10px 16px;

        border: 1px solid #d1d5db;
        border-radius: 8px;

        color: #374151;

        text-decoration: none;

        font-size: 13px;
        font-weight: 600;
    }

    .secondary-btn:hover {
        background: #f9fafb;
    }

    @media (max-width: 768px) {
        .page-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .primary-btn {
            width: 100%;
            justify-content: center;
        }

        .section-header {
            align-items: flex-start;
        }
    }
</style>
