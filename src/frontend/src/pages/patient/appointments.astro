---
import PatientLayout from '../../layouts/PatientLayout.astro';
---

<PatientLayout title="نوبت‌های من">

    <div class="appointments-container">

        <!-- =========================
             Header
        ========================== -->

        <section class="page-header">

            <div>
                <h1>نوبت‌های من</h1>

                <p>
                    نوبت‌های رزروشده و تاریخچه مراجعه‌های شما
                </p>
            </div>

        </section>


        <!-- =========================
             Upcoming Appointments
        ========================== -->

        <section class="appointments-section">

            <div class="section-header">

                <div>
                    <h2>نوبت‌های پیش‌رو</h2>

                    <p>
                        نوبت‌های رزروشده آینده
                    </p>
                </div>

            </div>


            <!-- Loading -->

            <div
                id="upcomingLoading"
                class="state-message"
            >
                در حال دریافت نوبت‌ها...
            </div>


            <!-- Error -->

            <div
                id="upcomingError"
                class="state-message error-message hidden"
            >
                دریافت نوبت‌ها انجام نشد.
                لطفاً دوباره تلاش کنید.
            </div>


            <!-- Empty -->

            <div
                id="upcomingEmpty"
                class="state-message hidden"
            >
                در حال حاضر نوبت رزروشده‌ای ندارید.
            </div>


            <!-- Table -->

            <div
                id="upcomingTableWrapper"
                class="table-wrapper hidden"
            >

                <table class="appointments-table">

                    <thead>

                        <tr>
                            <th>تراپیست</th>
                            <th>تاریخ</th>
                            <th>زمان</th>
                            <th>دلیل مراجعه</th>
                            <th>وضعیت</th>
                        </tr>

                    </thead>

                    <tbody id="upcomingTableBody">
                    </tbody>

                </table>

            </div>

        </section>


        <!-- =========================
             Appointment History
        ========================== -->

        <section class="appointments-section">

            <div class="section-header">

                <div>
                    <h2>تاریخچه نوبت‌ها</h2>

                    <p>
                        نوبت‌های تکمیل‌شده و لغوشده
                    </p>
                </div>

            </div>


            <!-- Loading -->

            <div
                id="historyLoading"
                class="state-message"
            >
                در حال دریافت تاریخچه...
            </div>


            <!-- Error -->

            <div
                id="historyError"
                class="state-message error-message hidden"
            >
                دریافت تاریخچه نوبت‌ها انجام نشد.
            </div>


            <!-- Empty -->

            <div
                id="historyEmpty"
                class="state-message hidden"
            >
                هنوز سابقه‌ای برای نوبت‌های شما ثبت نشده است.
            </div>


            <!-- Table -->

            <div
                id="historyTableWrapper"
                class="table-wrapper hidden"
            >

                <table class="appointments-table">

                    <thead>

                        <tr>
                            <th>تراپیست</th>
                            <th>تاریخ</th>
                            <th>زمان</th>
                            <th>دلیل مراجعه</th>
                            <th>وضعیت</th>
                        </tr>

                    </thead>

                    <tbody id="historyTableBody">
                    </tbody>

                </table>

            </div>

        </section>

    </div>

</PatientLayout>


<style>

    .appointments-container {
        width: 100%;
        padding: 30px;
        direction: rtl;
    }


    /* =========================
       Page Header
    ========================== */

    .page-header {
        background: #ffffff;
        border: 1px solid #e8e8e8;
        border-radius: 14px;
        padding: 28px;
        margin-bottom: 24px;
    }


    .page-header h1 {
        margin: 0 0 8px;
        font-size: 26px;
        font-weight: 700;
        color: #222;
    }


    .page-header p {
        margin: 0;
        color: #777;
        font-size: 14px;
        line-height: 1.8;
    }


    /* =========================
       Section
    ========================== */

    .appointments-section {
        background: #ffffff;
        border: 1px solid #e8e8e8;
        border-radius: 14px;
        padding: 24px;
        margin-bottom: 24px;
    }


    .section-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 20px;
    }


    .section-header h2 {
        margin: 0 0 7px;
        font-size: 20px;
        font-weight: 700;
        color: #222;
    }


    .section-header p {
        margin: 0;
        color: #777;
        font-size: 14px;
        line-height: 1.8;
    }


    /* =========================
       States
    ========================== */

    .state-message {
        padding: 32px 20px;
        text-align: center;
        color: #777;
        font-size: 14px;
        line-height: 1.8;
    }


    .error-message {
        color: #c62828;
    }


    .hidden {
        display: none !important;
    }


    /* =========================
       Table
    ========================== */

    .table-wrapper {
        width: 100%;
        overflow-x: auto;
    }


    .appointments-table {
        width: 100%;
        border-collapse: collapse;
    }


    .appointments-table th,
    .appointments-table td {
        padding: 15px 14px;
        text-align: right;
        border-bottom: 1px solid #eeeeee;
        font-size: 14px;
        white-space: nowrap;
    }


    .appointments-table th {
        background: #fafafa;
        color: #555;
        font-weight: 600;
    }


    .appointments-table td {
        color: #333;
    }


    .appointments-table tbody tr:last-child td {
        border-bottom: none;
    }


    .appointments-table tbody tr:hover {
        background: #fcfcfc;
    }


    /* =========================
       Status
    ========================== */

    .status-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;

        padding: 5px 12px;

        border-radius: 20px;

        font-size: 12px;
        font-weight: 600;

        white-space: nowrap;
    }


    .status-scheduled {
        background: #e8f5e9;
        color: #2e7d32;
    }


    .status-completed {
        background: #e3f2fd;
        color: #1565c0;
    }


    .status-cancelled {
        background: #ffebee;
        color: #c62828;
    }


    .status-unknown {
        background: #f5f5f5;
        color: #666;
    }


    /* =========================
       Therapist
    ========================== */

    .therapist-name {
        font-weight: 600;
        color: #333;
    }


    /* =========================
       Responsive
    ========================== */

    @media (max-width: 900px) {

        .appointments-container {
            padding: 20px;
        }

        .appointments-section {
            padding: 20px;
        }

    }


    @media (max-width: 600px) {

        .appointments-container {
            padding: 15px;
        }


        .page-header {
            padding: 20px;
        }


        .appointments-section {
            padding: 16px;
        }


        .page-header h1 {
            font-size: 22px;
        }


        .section-header {
            align-items: flex-start;
            flex-direction: column;
        }


        .appointments-table th,
        .appointments-table td {
            padding: 12px 8px;
            font-size: 12px;
        }

    }

</style>


<script>

    interface Appointment {

        id: number;

        therapist_id: number;

        date: string;

        time: string;

        reason: string;

        status:
            | "scheduled"
            | "completed"
            | "cancelled";

        created_at: string;
    }


    /*
     * =========================
     * Helpers
     * =========================
     */


    function showElement(id: string) {

        document
            .getElementById(id)
            ?.classList.remove("hidden");
    }


    function hideElement(id: string) {

        document
            .getElementById(id)
            ?.classList.add("hidden");
    }


    function formatPersianDate(
        dateString: unknown
    ) {

        if (
            !dateString ||
            typeof dateString !== "string"
        ) {
            return "-";
        }


        const date = new Date(
            `${dateString}T00:00:00`
        );


        if (Number.isNaN(date.getTime())) {
            return dateString;
        }


        try {

            const parts =
                new Intl.DateTimeFormat(
                    "fa-IR-u-ca-persian",
                    {
                        day: "2-digit",
                        month: "2-digit",
                        year: "numeric",
                    }
                ).formatToParts(date);


            const day =
                parts.find(
                    (part) =>
                        part.type === "day"
                )?.value ?? "";


            const month =
                parts.find(
                    (part) =>
                        part.type === "month"
                )?.value ?? "";


            const year =
                parts.find(
                    (part) =>
                        part.type === "year"
                )?.value ?? "";


            if (
                !day ||
                !month ||
                !year
            ) {
                return dateString;
            }


            return `${year}/${month}/${day}`;

        } catch {

            return dateString;

        }

    }


    function formatTime(
        timeString: unknown
    ) {

        if (
            !timeString ||
            typeof timeString !== "string"
        ) {
            return "-";
        }


        return timeString.slice(0, 5);
    }


    function getTherapistName(
        therapistId: number
    ) {

        return `تراپیست #${therapistId}`;
    }


    function getStatusLabel(
        status: Appointment["status"]
    ) {

        switch (status) {

            case "scheduled":
                return "رزرو شده";

            case "completed":
                return "تکمیل شده";

            case "cancelled":
                return "لغو شده";

            default:
                return status ?? "-";

        }

    }


    function getStatusClass(
        status: Appointment["status"]
    ) {

        switch (status) {

            case "scheduled":
                return "status-scheduled";

            case "completed":
                return "status-completed";

            case "cancelled":
                return "status-cancelled";

            default:
                return "status-unknown";

        }

    }


    /*
     * =========================
     * Render Appointments
     * =========================
     */


    function renderAppointments(
        appointments: Appointment[],
        bodyId: string
    ) {

        const body =
            document.getElementById(bodyId);


        if (!body) {
            return;
        }


        body.innerHTML =
            appointments
                .map(
                    (appointment) => `
                        <tr>

                            <td>
                                <span class="therapist-name">
                                    ${getTherapistName(
                                        appointment.therapist_id
                                    )}
                                </span>
                            </td>

                            <td>
                                ${formatPersianDate(
                                    appointment.date
                                )}
                            </td>

                            <td>
                                ${formatTime(
                                    appointment.time
                                )}
                            </td>

                            <td>
                                ${
                                    appointment.reason ||
                                    "-"
                                }
                            </td>

                            <td>
                                <span
                                    class="status-badge ${getStatusClass(
                                        appointment.status
                                    )}"
                                >
                                    ${getStatusLabel(
                                        appointment.status
                                    )}
                                </span>
                            </td>

                        </tr>
                    `
                )
                .join("");

    }


    /*
     * =========================
     * Load Patient Appointments
     * =========================
     *
     * Actual API:
     *
     * GET
     * /api/v1/booking/patient/appointments/
     *
     * Authentication:
     *
     * credentials: "include"
     *
     */


    async function loadAppointments() {

        try {

            const response =
                await fetch(
                    "/api/v1/booking/patient/appointments/",
                    {
                        method: "GET",

                        credentials: "include",

                        headers: {
                            "Accept":
                                "application/json",
                        },
                    }
                );


            if (!response.ok) {

                throw new Error(
                    `HTTP ${response.status}`
                );

            }


            const data =
                await response.json() as
                    Appointment[];


            console.log(
                "PATIENT APPOINTMENTS:",
                data
            );


            const appointments =
                Array.isArray(data)
                    ? data
                    : [];


            /*
             * Separate upcoming/history
             */

            const upcomingAppointments =
                appointments.filter(
                    (appointment) =>
                        appointment.status ===
                        "scheduled"
                );


            const historyAppointments =
                appointments.filter(
                    (appointment) =>
                        appointment.status ===
                            "completed" ||
                        appointment.status ===
                            "cancelled"
                );


            /*
             * =========================
             * Upcoming
             * =========================
             */


            hideElement(
                "upcomingLoading"
            );


            if (
                upcomingAppointments.length === 0
            ) {

                showElement(
                    "upcomingEmpty"
                );

            } else {

                renderAppointments(
                    upcomingAppointments,
                    "upcomingTableBody"
                );


                showElement(
                    "upcomingTableWrapper"
                );

            }


            /*
             * =========================
             * History
             * =========================
             */


            hideElement(
                "historyLoading"
            );


            if (
                historyAppointments.length === 0
            ) {

                showElement(
                    "historyEmpty"
                );

            } else {

                renderAppointments(
                    historyAppointments,
                    "historyTableBody"
                );


                showElement(
                    "historyTableWrapper"
                );

            }


        } catch (error) {

            console.error(
                "Failed to load patient appointments:",
                error
            );


            hideElement(
                "upcomingLoading"
            );

            hideElement(
                "historyLoading"
            );


            showElement(
                "upcomingError"
            );

            showElement(
                "historyError"
            );

        }

    }


    /*
     * =========================
     * Initialize
     * =========================
     */


    document.addEventListener(
        "DOMContentLoaded",
        () => {

            loadAppointments();

        }
    );

</script>

