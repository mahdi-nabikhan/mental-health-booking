---

import PatientLayout from "../../layouts/PatientLayout.astro";

const appointments = [
{
date: "۱۵ سپتامبر ۲۰۲۶",
time: "۱۰:۰۰",
therapist: "دکتر سارا جانسون",
type: "جلسه فردی",
status: "scheduled",
},
{
date: "۱۸ سپتامبر ۲۰۲۶",
time: "۱۴:۳۰",
therapist: "دکتر مایکل براون",
type: "جلسه مشاوره",
status: "scheduled",
},
{
date: "۲۲ سپتامبر ۲۰۲۶",
time: "۱۱:۰۰",
therapist: "دکتر سارا جانسون",
type: "جلسه پیگیری",
status: "scheduled",
},
{
date: "۵ سپتامبر ۲۰۲۶",
time: "۱۶:۰۰",
therapist: "دکتر سارا جانسون",
type: "جلسه فردی",
status: "completed",
},
{
date: "۲۸ آگوست ۲۰۲۶",
time: "۱۳:۰۰",
therapist: "دکتر مایکل براون",
type: "جلسه مشاوره",
status: "completed",
},
{
date: "۲۰ آگوست ۲۰۲۶",
time: "۱۱:۳۰",
therapist: "دکتر سارا جانسون",
type: "جلسه پیگیری",
status: "cancelled",
},
];

const upcomingAppointments = appointments.filter(
(appointment) => appointment.status === "scheduled",
);

const pastAppointments = appointments.filter(
(appointment) =>
appointment.status === "completed" ||
appointment.status === "cancelled",
);
--

<PatientLayout title="نوبت‌های من">
    <div class="appointments-page">
        <!-- Page Header -->
        <section class="page-header">
            <div>
                <h2>نوبت‌های من</h2>
                <p>
                    نوبت‌های پیش‌رو و قبلی خود را مشاهده و مدیریت کنید.
                </p>
            </div>

```
        <a href="/patient/slots" class="primary-btn">
            <i class="fa-solid fa-calendar-plus"></i>
            رزرو نوبت
        </a>
    </section>

    <!-- Upcoming -->
    <section class="appointments-section">
        <div class="section-header">
            <div>
                <h3>نوبت‌های پیش‌رو</h3>
                <p>جلسات برنامه‌ریزی‌شده شما</p>
            </div>

            <span class="count-badge">
                {upcomingAppointments.length}
            </span>
        </div>

        <div class="appointments-card">
            {
                upcomingAppointments.length > 0 ? (
                    <div class="table-wrapper">
                        <table>
                            <thead>
                                <tr>
                                    <th>تاریخ</th>
                                    <th>ساعت</th>
                                    <th>روان‌درمانگر</th>
                                    <th>نوع جلسه</th>
                                    <th>وضعیت</th>
                                    <th>عملیات</th>
                                </tr>
                            </thead>

                            <tbody>
                                {upcomingAppointments.map(
                                    (appointment) => (
                                        <tr>
                                            <td>
                                                {appointment.date}
                                            </td>

                                            <td>
                                                {appointment.time}
                                            </td>

                                            <td>
                                                <div class="therapist">
                                                    <div class="therapist-avatar">
                                                        <i class="fa-solid fa-user-doctor"></i>
                                                    </div>

                                                    <span>
                                                        {
                                                            appointment.therapist
                                                        }
                                                    </span>
                                                </div>
                                            </td>

                                            <td>
                                                {appointment.type}
                                            </td>

                                            <td>
                                                <span class="status scheduled">
                                                    <span class="status-dot"></span>
                                                    برنامه‌ریزی‌شده
                                                </span>
                                            </td>

                                            <td>
                                                <button
                                                    type="button"
                                                    class="action-btn cancel-btn"
                                                    data-action="cancel"
                                                >
                                                    لغو نوبت
                                                </button>
                                            </td>
                                        </tr>
                                    ),
                                )}
                            </tbody>
                        </table>
                    </div>
                ) : (
                    <div class="empty-state">
                        <div class="empty-icon">
                            <i class="fa-solid fa-calendar-xmark"></i>
                        </div>

                        <h4>نوبت پیش‌رویی وجود ندارد</h4>

                        <p>
                            در حال حاضر هیچ نوبت برنامه‌ریزی‌شده‌ای ندارید.
                        </p>

                        <a
                            href="/patient/slots"
                            class="secondary-btn"
                        >
                            مشاهده زمان‌های آزاد
                        </a>
                    </div>
                )
            }
        </div>
    </section>

    <!-- Appointment History -->
    <section class="appointments-section">
        <div class="section-header">
            <div>
                <h3>تاریخچه نوبت‌ها</h3>
                <p>جلسات تکمیل‌شده و لغوشده شما</p>
            </div>

            <span class="count-badge">
                {pastAppointments.length}
            </span>
        </div>

        <div class="appointments-card">
            {
                pastAppointments.length > 0 ? (
                    <div class="table-wrapper">
                        <table>
                            <thead>
                                <tr>
                                    <th>تاریخ</th>
                                    <th>ساعت</th>
                                    <th>روان‌درمانگر</th>
                                    <th>نوع جلسه</th>
                                    <th>وضعیت</th>
                                </tr>
                            </thead>

                            <tbody>
                                {pastAppointments.map((appointment) => (
                                    <tr>
                                        <td>{appointment.date}</td>

                                        <td>{appointment.time}</td>

                                        <td>
                                            <div class="therapist">
                                                <div class="therapist-avatar">
                                                    <i class="fa-solid fa-user-doctor"></i>
                                                </div>

                                                <span>
                                                    {
                                                        appointment.therapist
                                                    }
                                                </span>
                                            </div>
                                        </td>

                                        <td>{appointment.type}</td>

                                        <td>
                                            {
                                                appointment.status ===
                                                "completed" ? (
                                                    <span class="status completed">
                                                        <span class="status-dot"></span>
                                                        تکمیل‌شده
                                                    </span>
                                                ) : (
                                                    <span class="status cancelled">
                                                        <span class="status-dot"></span>
                                                        لغوشده
                                                    </span>
                                                )
                                            }
                                        </td>
                                    </tr>
                                ))}
                            </tbody>
                        </table>
                    </div>
                ) : (
                    <div class="empty-state">
                        <div class="empty-icon">
                            <i class="fa-solid fa-clock-rotate-left"></i>
                        </div>

                        <h4>تاریخچه‌ای از نوبت‌ها وجود ندارد</h4>

                        <p>
                            نوبت‌های تکمیل‌شده و لغوشده شما در اینجا نمایش داده خواهند شد.
                        </p>
                    </div>
                )
            }
        </div>
    </section>
</div>
```

</PatientLayout>

<script>
    const cancelButtons =
        document.querySelectorAll<HTMLButtonElement>(
            '[data-action="cancel"]',
        );

    cancelButtons.forEach((button) => {
        button.addEventListener("click", () => {
            const confirmed = window.confirm(
                "آیا مطمئن هستید که می‌خواهید این نوبت را لغو کنید؟",
            );

            if (!confirmed) {
                return;
            }

            /*
             * API cancellation will be connected here later.
             */
            window.alert(
                "قابلیت لغو نوبت در آینده به API متصل خواهد شد.",
            );
        });
    });
</script>

<style>
    .appointments-page {
        max-width: 1400px;
        margin: 0 auto;
    }

    .page-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;

        margin-bottom: 30px;
    }

    .page-header h2 {
        margin: 0;

        color: #111827;

        font-size: 24px;
        font-weight: 700;
    }

    .page-header p {
        margin: 7px 0 0;

        color: #9ca3af;

        font-size: 14px;
    }

    .primary-btn {
        display: inline-flex;
        align-items: center;
        gap: 9px;

        padding: 11px 17px;

        border: 0;
        border-radius: 8px;

        background: #111827;
        color: #ffffff;

        text-decoration: none;

        font-size: 13px;
        font-weight: 600;

        white-space: nowrap;

        transition:
            background 0.2s ease,
            transform 0.2s ease;
    }

    .primary-btn:hover {
        background: #1f2937;
        transform: translateY(-1px);
    }

    .appointments-section {
        margin-bottom: 30px;
    }

    .section-header {
        display: flex;
        align-items: center;
        justify-content: space-between;

        margin-bottom: 15px;
    }

    .section-header h3 {
        margin: 0;

        color: #111827;

        font-size: 18px;
        font-weight: 700;
    }

    .section-header p {
        margin: 5px 0 0;

        color: #9ca3af;

        font-size: 13px;
    }

    .count-badge {
        min-width: 30px;
        height: 30px;

        display: flex;
        align-items: center;
        justify-content: center;

        padding: 0 9px;

        border-radius: 15px;

        background: #f3f4f6;
        color: #374151;

        font-size: 12px;
        font-weight: 700;
    }

    .appointments-card {
        overflow: hidden;

        border: 1px solid #e5e7eb;
        border-radius: 12px;

        background: #ffffff;
    }

    .table-wrapper {
        width: 100%;
        overflow-x: auto;
    }

    table {
        width: 100%;
        min-width: 850px;

        border-collapse: collapse;
    }

    th {
        padding: 15px 18px;

        background: #f9fafb;
        border-bottom: 1px solid #e5e7eb;

        color: #6b7280;

        font-size: 11px;
        font-weight: 700;
        text-align: left;
        text-transform: uppercase;
    }

    td {
        padding: 17px 18px;

        border-bottom: 1px solid #f0f0f0;

        color: #374151;

        font-size: 13px;
    }

    tbody tr:last-child td {
        border-bottom: 0;
    }

    tbody tr:hover {
        background: #fafafa;
    }

    .therapist {
        display: flex;
        align-items: center;
        gap: 10px;

        color: #111827;
        font-weight: 500;
    }

    .therapist-avatar {
        width: 34px;
        height: 34px;

        flex-shrink: 0;

        display: flex;
        align-items: center;
        justify-content: center;

        border-radius: 50%;

        background: #f3f4f6;
        color: #6b7280;

        font-size: 13px;
    }

    .status {
        display: inline-flex;
        align-items: center;
        gap: 7px;

        font-size: 12px;
        font-weight: 600;
    }

    .status-dot {
        width: 7px;
        height: 7px;

        border-radius: 50%;
    }

    .status.scheduled {
        color: #15803d;
    }

    .status.scheduled .status-dot {
        background: #22c55e;
    }

    .status.completed {
        color: #2563eb;
    }

    .status.completed .status-dot {
        background: #3b82f6;
    }

    .status.cancelled {
        color: #dc2626;
    }

    .status.cancelled .status-dot {
        background: #ef4444;
    }

    .action-btn {
        padding: 7px 12px;

        border-radius: 6px;

        font-size: 12px;
        font-weight: 600;

        cursor: pointer;
    }

    .cancel-btn {
        border: 1px solid #fecaca;

        background: #ffffff;
        color: #dc2626;
    }

    .cancel-btn:hover {
        background: #fef2f2;
    }

    .empty-state {
        padding: 55px 20px;

        display: flex;
        flex-direction: column;
        align-items: center;

        text-align: center;
    }

    .empty-icon {
        width: 58px;
        height: 58px;

        display: flex;
        align-items: center;
        justify-content: center;

        margin-bottom: 15px;

        border-radius: 50%;

        background: #f3f4f6;
        color: #9ca3af;

        font-size: 22px;
    }

    .empty-state h4 {
        margin: 0;

        color: #111827;

        font-size: 16px;
    }

    .empty-state p {
        margin: 7px 0 18px;

        color: #9ca3af;

        font-size: 13px;
    }

    .secondary-btn {
        padding: 10px 16px;

        border: 1px solid #d1d5db;
        border-radius: 8px;

        color: #374151;

        text-decoration: none;

        font-size: 13px;
        font-weight: 600;
    }

    .secondary-btn:hover {
        background: #f9fafb;
    }

    @media (max-width: 768px) {
        .page-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .primary-btn {
            width: 100%;
            justify-content: center;
        }

        .section-header {
            align-items: flex-start;
        }
    }
</style>
