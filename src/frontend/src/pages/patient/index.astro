---
import PatientLayout from "../../layouts/PatientLayout.astro";
import PatientStatCard from "../../components/Dashboard/PatientStatCard.astro";

const stats = [
    {
        title: "نوبت‌های پیش‌رو",
        value: 3,
        description: "نوبت‌های برنامه‌ریزی‌شده",
        icon: "fa-solid fa-calendar-check",
    },
    {
        title: "جلسات تکمیل‌شده",
        value: 8,
        description: "جلسات با موفقیت تکمیل‌شده",
        icon: "fa-solid fa-circle-check",
    },
    {
        title: "مجموع جلسات",
        value: 11,
        description: "جلسات شما",
        icon: "fa-solid fa-clock-rotate-left",
    },
];

const upcomingAppointments = [
    {
        date: "۱۵ سپتامبر ۲۰۲۶",
        time: "۱۰:۰۰",
        therapist: "دکتر سارا جانسون",
        type: "جلسه فردی",
        status: "برنامه‌ریزی‌شده",
    },
    {
        date: "۱۸ سپتامبر ۲۰۲۶",
        time: "۱۴:۳۰",
        therapist: "دکتر مایکل براون",
        type: "جلسه مشاوره",
        status: "برنامه‌ریزی‌شده",
    },
    {
        date: "۲۲ سپتامبر ۲۰۲۶",
        time: "۱۱:۰۰",
        therapist: "دکتر سارا جانسون",
        type: "جلسه پیگیری",
        status: "برنامه‌ریزی‌شده",
    },
];
---

<PatientLayout title="داشبورد بیمار">
    <div class="dashboard">
        <!-- Welcome -->
        <section class="welcome-section">
            <div>
                <h2>خوش آمدید!</h2>
                <p>
                    نوبت‌های خود را مدیریت کنید و جلساتتان را پیگیری کنید.
                </p>
            </div>
        </section>

        <!-- Statistics -->
        <section class="stats-grid">
            {
                stats.map((stat) => (
                    <PatientStatCard
                        title={stat.title}
                        value={stat.value}
                        description={stat.description}
                        icon={stat.icon}
                    />
                ))
            }
        </section>

        <!-- Upcoming Appointments -->
        <section class="appointments-section">
            <div class="section-header">
                <div>
                    <h3>نوبت‌های پیش‌رو</h3>
                    <p>جلسات برنامه‌ریزی‌شده بعدی شما</p>
                </div>

                <a href="/patient/appointments" class="view-all">
                    مشاهده همه
                    <i class="fa-solid fa-arrow-right"></i>
                </a>
            </div>

            <div class="appointments-card">
                {
                    upcomingAppointments.length > 0 ? (
                        <div class="table-wrapper">
                            <table>
                                <thead>
                                    <tr>
                                        <th>تاریخ</th>
                                        <th>ساعت</th>
                                        <th>روان‌درمانگر</th>
                                        <th>نوع جلسه</th>
                                        <th>وضعیت</th>
                                    </tr>
                                </thead>

                                <tbody>
                                    {upcomingAppointments.map((appointment) => (
                                        <tr>
                                            <td>{appointment.date}</td>

                                            <td>{appointment.time}</td>

                                            <td>
                                                <div class="therapist">
                                                    <div class="therapist-avatar">
                                                        <i class="fa-solid fa-user-doctor"></i>
                                                    </div>

                                                    <span>
                                                        {appointment.therapist}
                                                    </span>
                                                </div>
                                            </td>

                                            <td>{appointment.type}</td>

                                            <td>
                                                <span class="status">
                                                    <span class="status-dot"></span>
                                                    {appointment.status}
                                                </span>
                                            </td>
                                        </tr>
                                    ))}
                                </tbody>
                            </table>
                        </div>
                    ) : (
                        <div class="empty-state">
                            <div class="empty-icon">
                                <i class="fa-solid fa-calendar-xmark"></i>
                            </div>

                            <h4>نوبت پیش‌رویی وجود ندارد</h4>

                            <p>
                                هنوز هیچ نوبت برنامه‌ریزی‌شده‌ای ندارید.
                            </p>
                        </div>
                    )
                }
            </div>
        </section>
    </div>
</PatientLayout>

<style>
    .dashboard {
        max-width: 1400px;
        margin: 0 auto;
    }

    .welcome-section {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;

        margin-bottom: 30px;
        padding: 28px 30px;

        border-radius: 14px;

        background: #111827;
        color: #ffffff;
    }

    .welcome-section h2 {
        margin: 0;

        font-size: 24px;
        font-weight: 700;
    }

    .welcome-section p {
        margin: 7px 0 0;

        color: #d1d5db;
        font-size: 14px;
    }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 18px;

        margin-bottom: 30px;
    }

    .appointments-section {
        margin-bottom: 30px;
    }

    .section-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;

        margin-bottom: 15px;
    }

    .section-header h3 {
        margin: 0;

        color: #111827;

        font-size: 18px;
        font-weight: 700;
    }

    .section-header p {
        margin: 5px 0 0;

        color: #9ca3af;

        font-size: 13px;
    }

    .view-all {
        display: inline-flex;
        align-items: center;
        gap: 7px;

        color: #374151;

        text-decoration: none;

        font-size: 13px;
        font-weight: 600;
    }

    .view-all:hover {
        color: #111827;
    }

    .appointments-card {
        overflow: hidden;

        border: 1px solid #e5e7eb;
        border-radius: 12px;

        background: #ffffff;
    }

    .table-wrapper {
        width: 100%;
        overflow-x: auto;
    }

    table {
        width: 100%;
        min-width: 800px;

        border-collapse: collapse;
    }

    th {
        padding: 15px 18px;

        background: #f9fafb;
        border-bottom: 1px solid #e5e7eb;

        color: #6b7280;

        font-size: 11px;
        font-weight: 700;
        text-align: left;
        text-transform: uppercase;
    }

    td {
        padding: 17px 18px;

        border-bottom: 1px solid #f0f0f0;

        color: #374151;

        font-size: 13px;
    }

    tbody tr:last-child td {
        border-bottom: 0;
    }

    tbody tr:hover {
        background: #fafafa;
    }

    .therapist {
        display: flex;
        align-items: center;
        gap: 10px;

        color: #111827;
        font-weight: 500;
    }

    .therapist-avatar {
        width: 32px;
        height: 32px;

        display: flex;
        align-items: center;
        justify-content: center;

        border-radius: 50%;

        background: #f3f4f6;
        color: #6b7280;

        font-size: 13px;
    }

    .status {
        display: inline-flex;
        align-items: center;
        gap: 7px;

        color: #15803d;

        font-size: 12px;
        font-weight: 600;
    }

    .status-dot {
        width: 7px;
        height: 7px;

        border-radius: 50%;

        background: #22c55e;
    }

    .empty-state {
        padding: 55px 20px;

        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
    }

    .empty-icon {
        width: 58px;
        height: 58px;

        display: flex;
        align-items: center;
        justify-content: center;

        margin-bottom: 15px;

        border-radius: 50%;

        background: #f3f4f6;
        color: #9ca3af;

        font-size: 22px;
    }

    .empty-state h4 {
        margin: 0;

        color: #111827;

        font-size: 16px;
    }

    .empty-state p {
        margin: 7px 0 0;

        color: #9ca3af;

        font-size: 13px;
    }

    @media (max-width: 1100px) {
        .stats-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @media (max-width: 768px) {
        .welcome-section {
            align-items: flex-start;
            flex-direction: column;
        }

        .stats-grid {
            grid-template-columns: 1fr;
        }

        .section-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .view-all {
            align-self: flex-end;
        }
    }
</style>