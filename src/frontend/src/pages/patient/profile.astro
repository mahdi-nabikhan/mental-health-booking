---

import PatientLayout from "../../layouts/PatientLayout.astro";

const patient = {
firstName: "Mahdi",
lastName: "Nabikhan",
email: "[patient@example.com](mailto:patient@example.com)",
phoneNumber: "09123456789",
};
--

<PatientLayout title="پروفایل من">
    <div class="profile-page">
        <!-- Page Header -->
        <section class="page-header">
            <div>
                <h2>پروفایل من</h2>
                <p>
                    اطلاعات شخصی خود را مشاهده و مدیریت کنید.
                </p>
            </div>
        </section>

```
    <div class="profile-grid">
        <!-- Profile Summary -->
        <section class="profile-card profile-summary">
            <div class="avatar-large">
                <i class="fa-solid fa-user"></i>
            </div>

            <h3>
                {patient.firstName} {patient.lastName}
            </h3>

            <p>بیمار</p>

            <div class="summary-divider"></div>

            <div class="summary-item">
                <i class="fa-solid fa-envelope"></i>

                <div>
                    <span>ایمیل</span>
                    <strong>{patient.email}</strong>
                </div>
            </div>

            <div class="summary-item">
                <i class="fa-solid fa-phone"></i>

                <div>
                    <span>شماره تلفن</span>
                    <strong>{patient.phoneNumber}</strong>
                </div>
            </div>
        </section>

        <!-- Personal Information -->
        <section class="profile-card">
            <div class="card-header">
                <div>
                    <h3>اطلاعات شخصی</h3>
                    <p>
                        اطلاعات شخصی خود را به‌روزرسانی کنید.
                    </p>
                </div>
            </div>

            <form id="profile-form">
                <div class="form-grid">
                    <div class="form-group">
                        <label for="first-name">
                            نام
                        </label>

                        <input
                            id="first-name"
                            name="first_name"
                            type="text"
                            value={patient.firstName}
                            required
                        />
                    </div>

                    <div class="form-group">
                        <label for="last-name">
                            نام خانوادگی
                        </label>

                        <input
                            id="last-name"
                            name="last_name"
                            type="text"
                            value={patient.lastName}
                            required
                        />
                    </div>

                    <div class="form-group full-width">
                        <label for="email">
                            آدرس ایمیل
                        </label>

                        <input
                            id="email"
                            name="email"
                            type="email"
                            value={patient.email}
                            disabled
                        />

                        <small>
                            آدرس ایمیل از این قسمت قابل تغییر نیست.
                        </small>
                    </div>

                    <div class="form-group full-width">
                        <label for="phone-number">
                            شماره تلفن
                        </label>

                        <input
                            id="phone-number"
                            name="phone_number"
                            type="tel"
                            value={patient.phoneNumber}
                            required
                        />
                    </div>
                </div>

                <div
                    id="profile-message"
                    class="message d-none"
                    role="alert"
                ></div>

                <div class="form-actions">
                    <button
                        id="save-profile"
                        type="submit"
                        class="save-btn"
                    >
                        <i class="fa-solid fa-check"></i>
                        ذخیره تغییرات
                    </button>
                </div>
            </form>
        </section>
    </div>

    <!-- Security -->
    <section class="profile-card security-card">
        <div class="card-header">
            <div>
                <h3>امنیت</h3>
                <p>
                    رمز عبور حساب خود را مدیریت کنید.
                </p>
            </div>
        </div>

        <div class="security-content">
            <div class="security-info">
                <div class="security-icon">
                    <i class="fa-solid fa-lock"></i>
                </div>

                <div>
                    <h4>رمز عبور</h4>
                    <p>
                        با استفاده از یک رمز عبور قوی، حساب خود را ایمن نگه دارید.
                    </p>
                </div>
            </div>

            <a
                href="/patient/settings"
                class="change-password-btn"
            >
                تغییر رمز عبور
            </a>
        </div>
    </section>
</div>
```

</PatientLayout>

<script>
    const form =
        document.querySelector<HTMLFormElement>("#profile-form");

    const message =
        document.querySelector<HTMLDivElement>("#profile-message");

    const saveButton =
        document.querySelector<HTMLButtonElement>("#save-profile");

    form?.addEventListener("submit", async (event) => {
        event.preventDefault();

        if (!form || !message || !saveButton) {
            return;
        }

        message.classList.add("d-none");
        message.textContent = "";

        saveButton.disabled = true;
        saveButton.innerHTML =
            '<i class="fa-solid fa-spinner fa-spin"></i> در حال ذخیره...';

        /*
         * The real profile update API will be connected here.
         */

        await new Promise((resolve) => setTimeout(resolve, 700));

        message.textContent =
            "قابلیت ذخیره تغییرات پروفایل در آینده به API متصل خواهد شد.";

        message.className = "message success";

        saveButton.disabled = false;
        saveButton.innerHTML =
            '<i class="fa-solid fa-check"></i> ذخیره تغییرات';
    });
</script>

<style>
    .profile-page {
        max-width: 1200px;
        margin: 0 auto;
    }

    .page-header {
        margin-bottom: 30px;
    }

    .page-header h2 {
        margin: 0;

        color: #111827;

        font-size: 24px;
        font-weight: 700;
    }

    .page-header p {
        margin: 7px 0 0;

        color: #9ca3af;

        font-size: 14px;
    }

    .profile-grid {
        display: grid;
        grid-template-columns: 300px 1fr;
        gap: 20px;

        margin-bottom: 20px;
    }

    .profile-card {
        border: 1px solid #e5e7eb;
        border-radius: 12px;

        background: #ffffff;
    }

    .profile-summary {
        padding: 30px;

        display: flex;
        flex-direction: column;
        align-items: center;

        text-align: center;
    }

    .avatar-large {
        width: 90px;
        height: 90px;

        display: flex;
        align-items: center;
        justify-content: center;

        margin-bottom: 18px;

        border-radius: 50%;

        background: #f3f4f6;
        color: #374151;

        font-size: 30px;
    }

    .profile-summary h3 {
        margin: 0;

        color: #111827;

        font-size: 18px;
        font-weight: 700;
    }

    .profile-summary > p {
        margin: 6px 0 0;

        color: #9ca3af;

        font-size: 13px;
    }

    .summary-divider {
        width: 100%;
        height: 1px;

        margin: 25px 0;

        background: #e5e7eb;
    }

    .summary-item {
        width: 100%;

        display: flex;
        align-items: flex-start;
        gap: 12px;

        margin-bottom: 18px;

        text-align: left;
    }

    .summary-item:last-child {
        margin-bottom: 0;
    }

    .summary-item > i {
        width: 18px;

        margin-top: 2px;

        color: #6b7280;

        font-size: 14px;
    }

    .summary-item div {
        min-width: 0;

        display: flex;
        flex-direction: column;
        gap: 3px;
    }

    .summary-item span {
        color: #9ca3af;

        font-size: 11px;
    }

    .summary-item strong {
        overflow-wrap: anywhere;

        color: #374151;

        font-size: 12px;
        font-weight: 500;
    }

    .card-header {
        padding: 24px 26px;

        border-bottom: 1px solid #e5e7eb;
    }

    .card-header h3 {
        margin: 0;

        color: #111827;

        font-size: 17px;
        font-weight: 700;
    }

    .card-header p {
        margin: 5px 0 0;

        color: #9ca3af;

        font-size: 12px;
    }

    #profile-form {
        padding: 26px;
    }

    .form-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 20px;
    }

    .form-group {
        display: flex;
        flex-direction: column;
    }

    .full-width {
        grid-column: 1 / -1;
    }

    .form-group label {
        margin-bottom: 8px;

        color: #374151;

        font-size: 13px;
        font-weight: 600;
    }

    .form-group input {
        width: 100%;

        padding: 11px 13px;

        border: 1px solid #d1d5db;
        border-radius: 8px;

        outline: none;

        background: #ffffff;
        color: #111827;

        font-family: inherit;
        font-size: 13px;

        transition: border-color 0.2s ease;
    }

    .form-group input:focus {
        border-color: #6b7280;
    }

    .form-group input:disabled {
        background: #f9fafb;
        color: #9ca3af;
        cursor: not-allowed;
    }

    .form-group small {
        margin-top: 6px;

        color: #9ca3af;

        font-size: 11px;
    }

    .form-actions {
        display: flex;
        justify-content: flex-end;

        margin-top: 25px;
        padding-top: 20px;

        border-top: 1px solid #e5e7eb;
    }

    .save-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;

        padding: 10px 17px;

        border: 0;
        border-radius: 8px;

        background: #111827;
        color: #ffffff;

        font-family: inherit;
        font-size: 13px;
        font-weight: 600;

        cursor: pointer;
    }

    .save-btn:hover {
        background: #1f2937;
    }

    .save-btn:disabled {
        opacity: 0.6;
        cursor: not-allowed;
    }

    .message {
        margin-top: 18px;

        padding: 11px 13px;

        border-radius: 8px;

        font-size: 12px;
    }

    .message.success {
        background: #f0fdf4;
        color: #15803d;
        border: 1px solid #bbf7d0;
    }

    .d-none {
        display: none;
    }

    .security-card {
        margin-bottom: 30px;
    }

    .security-content {
        padding: 24px 26px;

        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
    }

    .security-info {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .security-icon {
        width: 42px;
        height: 42px;

        display: flex;
        align-items: center;
        justify-content: center;

        border-radius: 9px;

        background: #f3f4f6;
        color: #374151;
    }

    .security-info h4 {
        margin: 0;

        color: #111827;

        font-size: 14px;
    }

    .security-info p {
        margin: 4px 0 0;

        color: #9ca3af;

        font-size: 12px;
    }

    .change-password-btn {
        padding: 9px 14px;

        border: 1px solid #d1d5db;
        border-radius: 8px;

        color: #374151;

        text-decoration: none;

        font-size: 12px;
        font-weight: 600;

        white-space: nowrap;
    }

    .change-password-btn:hover {
        background: #f9fafb;
    }

    @media (max-width: 900px) {
        .profile-grid {
            grid-template-columns: 1fr;
        }
    }

    @media (max-width: 600px) {
        .form-grid {
            grid-template-columns: 1fr;
        }

        .full-width {
            grid-column: auto;
        }

        .security-content {
            align-items: flex-start;
            flex-direction: column;
        }

        .change-password-btn {
            width: 100%;
            text-align: center;
        }
    }
</style>
