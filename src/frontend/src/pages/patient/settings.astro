
---
import PatientLayout from "../../layouts/PatientLayout.astro";
---

<PatientLayout title="Settings">
    <div class="settings-page">
        <!-- Page Header -->
        <section class="page-header">
            <div>
                <h2>Settings</h2>
                <p>
                    Manage your account settings and security.
                </p>
            </div>
        </section>

        <!-- Security -->
        <section class="settings-card">
            <div class="card-header">
                <div class="header-icon">
                    <i class="fa-solid fa-lock"></i>
                </div>

                <div>
                    <h3>Password & Security</h3>
                    <p>
                        Change your password to keep your account secure.
                    </p>
                </div>
            </div>

            <form id="password-form">
                <div class="form-grid">
                    <div class="form-group full-width">
                        <label for="current-password">
                            Current Password
                        </label>

                        <input
                            id="current-password"
                            name="old_password"
                            type="password"
                            autocomplete="current-password"
                            placeholder="Enter your current password"
                            required
                        />
                    </div>

                    <div class="form-group">
                        <label for="new-password">
                            New Password
                        </label>

                        <input
                            id="new-password"
                            name="new_password"
                            type="password"
                            autocomplete="new-password"
                            placeholder="Enter your new password"
                            required
                        />
                    </div>

                    <div class="form-group">
                        <label for="confirm-password">
                            Confirm New Password
                        </label>

                        <input
                            id="confirm-password"
                            name="confirm_password"
                            type="password"
                            autocomplete="new-password"
                            placeholder="Confirm your new password"
                            required
                        />
                    </div>
                </div>

                <div class="password-hint">
                    <i class="fa-solid fa-circle-info"></i>

                    <span>
                        Use a strong password that you don't use on other
                        websites.
                    </span>
                </div>

                <div
                    id="password-message"
                    class="message d-none"
                    role="alert"
                ></div>

                <div class="form-actions">
                    <button
                        id="change-password-btn"
                        type="submit"
                        class="primary-btn"
                    >
                        <i class="fa-solid fa-key"></i>
                        Change Password
                    </button>
                </div>
            </form>
        </section>

        <!-- Account -->
        <section class="settings-card">
            <div class="card-header">
                <div class="header-icon">
                    <i class="fa-solid fa-user-gear"></i>
                </div>

                <div>
                    <h3>Account</h3>
                    <p>
                        Manage your account preferences.
                    </p>
                </div>
            </div>

            <div class="settings-list">
                <div class="setting-item">
                    <div class="setting-info">
                        <div class="setting-icon">
                            <i class="fa-solid fa-user"></i>
                        </div>

                        <div>
                            <h4>Profile Information</h4>
                            <p>
                                Update your name and phone number.
                            </p>
                        </div>
                    </div>

                    <a
                        href="/patient/profile"
                        class="secondary-btn"
                    >
                        Manage
                    </a>
                </div>

                <div class="setting-item">
                    <div class="setting-info">
                        <div class="setting-icon">
                            <i class="fa-solid fa-calendar-check"></i>
                        </div>

                        <div>
                            <h4>Appointments</h4>
                            <p>
                                View your upcoming and previous sessions.
                            </p>
                        </div>
                    </div>

                    <a
                        href="/patient/appointments"
                        class="secondary-btn"
                    >
                        View
                    </a>
                </div>
            </div>
        </section>

        <!-- Logout -->
        <section class="settings-card danger-card">
            <div class="card-header">
                <div class="header-icon danger-icon">
                    <i class="fa-solid fa-right-from-bracket"></i>
                </div>

                <div>
                    <h3>Sign Out</h3>
                    <p>
                        Sign out from your patient account.
                    </p>
                </div>
            </div>

            <div class="danger-content">
                <p>
                    You will need to sign in again to access your patient
                    dashboard.
                </p>

                <button
                    id="logout-button"
                    type="button"
                    class="logout-btn"
                >
                    <i class="fa-solid fa-right-from-bracket"></i>
                    Sign Out
                </button>
            </div>
        </section>
    </div>
</PatientLayout>

<script>
    const passwordForm =
        document.querySelector<HTMLFormElement>("#password-form");

    const passwordMessage =
        document.querySelector<HTMLDivElement>("#password-message");

    const changePasswordButton =
        document.querySelector<HTMLButtonElement>(
            "#change-password-btn",
        );

    passwordForm?.addEventListener("submit", async (event) => {
        event.preventDefault();

        if (
            !passwordForm ||
            !passwordMessage ||
            !changePasswordButton
        ) {
            return;
        }

        passwordMessage.className = "message d-none";
        passwordMessage.textContent = "";

        const formData = new FormData(passwordForm);

        const oldPassword = String(
            formData.get("old_password") ?? "",
        );

        const newPassword = String(
            formData.get("new_password") ?? "",
        );

        const confirmPassword = String(
            formData.get("confirm_password") ?? "",
        );

        if (newPassword !== confirmPassword) {
            passwordMessage.textContent =
                "New password and confirmation password do not match.";

            passwordMessage.className = "message error";

            return;
        }

        changePasswordButton.disabled = true;
        changePasswordButton.innerHTML =
            '<i class="fa-solid fa-spinner fa-spin"></i> Changing...';

        try {
            const response = await fetch(
                "http://localhost:8000/api/v1/accounts/change-password/",
                {
                    method: "PUT",
                    headers: {
                        "Content-Type": "application/json",
                    },
                    credentials: "include",
                    body: JSON.stringify({
                        old_password: oldPassword,
                        new_password: newPassword,
                    }),
                },
            );

            const data = await response.json();

            if (!response.ok) {
                const message =
                    data?.detail ||
                    data?.old_password?.[0] ||
                    data?.new_password?.[0] ||
                    "Unable to change password.";

                throw new Error(message);
            }

            passwordMessage.textContent =
                data?.message ||
                "Password changed successfully.";

            passwordMessage.className = "message success";

            passwordForm.reset();
        } catch (error) {
            passwordMessage.textContent =
                error instanceof Error
                    ? error.message
                    : "Something went wrong.";

            passwordMessage.className = "message error";
        } finally {
            changePasswordButton.disabled = false;
            changePasswordButton.innerHTML =
                '<i class="fa-solid fa-key"></i> Change Password';
        }
    });

    const logoutButton =
        document.querySelector<HTMLButtonElement>("#logout-button");

    logoutButton?.addEventListener("click", () => {
        const confirmed = window.confirm(
            "Are you sure you want to sign out?",
        );

        if (!confirmed) {
            return;
        }

        /*
         * Logout API will be added later.
         * Since authentication uses HttpOnly cookies,
         * the backend should clear those cookies.
         */

        window.location.href = "/login";
    });
</script>

<style>
    .settings-page {
        max-width: 1000px;
        margin: 0 auto;
    }

    .page-header {
        margin-bottom: 30px;
    }

    .page-header h2 {
        margin: 0;

        color: #111827;

        font-size: 24px;
        font-weight: 700;
    }

    .page-header p {
        margin: 7px 0 0;

        color: #9ca3af;

        font-size: 14px;
    }

    .settings-card {
        margin-bottom: 20px;

        overflow: hidden;

        border: 1px solid #e5e7eb;
        border-radius: 12px;

        background: #ffffff;
    }

    .card-header {
        display: flex;
        align-items: center;
        gap: 14px;

        padding: 24px 26px;

        border-bottom: 1px solid #e5e7eb;
    }

    .header-icon {
        width: 42px;
        height: 42px;

        flex-shrink: 0;

        display: flex;
        align-items: center;
        justify-content: center;

        border-radius: 9px;

        background: #f3f4f6;
        color: #374151;
    }

    .card-header h3 {
        margin: 0;

        color: #111827;

        font-size: 17px;
        font-weight: 700;
    }

    .card-header p {
        margin: 5px 0 0;

        color: #9ca3af;

        font-size: 12px;
    }

    #password-form {
        padding: 26px;
    }

    .form-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 20px;
    }

    .form-group {
        display: flex;
        flex-direction: column;
    }

    .full-width {
        grid-column: 1 / -1;
    }

    .form-group label {
        margin-bottom: 8px;

        color: #374151;

        font-size: 13px;
        font-weight: 600;
    }

    .form-group input {
        width: 100%;

        padding: 11px 13px;

        border: 1px solid #d1d5db;
        border-radius: 8px;

        outline: none;

        background: #ffffff;
        color: #111827;

        font-family: inherit;
        font-size: 13px;

        transition: border-color 0.2s ease;
    }

    .form-group input:focus {
        border-color: #6b7280;
    }

    .password-hint {
        display: flex;
        align-items: center;
        gap: 8px;

        margin-top: 18px;

        color: #9ca3af;

        font-size: 12px;
    }

    .password-hint i {
        color: #6b7280;
    }

    .message {
        margin-top: 18px;

        padding: 11px 13px;

        border-radius: 8px;

        font-size: 12px;
    }

    .message.success {
        border: 1px solid #bbf7d0;

        background: #f0fdf4;
        color: #15803d;
    }

    .message.error {
        border: 1px solid #fecaca;

        background: #fef2f2;
        color: #dc2626;
    }

    .d-none {
        display: none;
    }

    .form-actions {
        display: flex;
        justify-content: flex-end;

        margin-top: 25px;
        padding-top: 20px;

        border-top: 1px solid #e5e7eb;
    }

    .primary-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;

        padding: 10px 17px;

        border: 0;
        border-radius: 8px;

        background: #111827;
        color: #ffffff;

        font-family: inherit;
        font-size: 13px;
        font-weight: 600;

        cursor: pointer;
    }

    .primary-btn:hover {
        background: #1f2937;
    }

    .primary-btn:disabled {
        opacity: 0.6;
        cursor: not-allowed;
    }

    .settings-list {
        padding: 8px 26px;
    }

    .setting-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;

        padding: 20px 0;

        border-bottom: 1px solid #f0f0f0;
    }

    .setting-item:last-child {
        border-bottom: 0;
    }

    .setting-info {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .setting-icon {
        width: 40px;
        height: 40px;

        flex-shrink: 0;

        display: flex;
        align-items: center;
        justify-content: center;

        border-radius: 9px;

        background: #f3f4f6;
        color: #6b7280;
    }

    .setting-info h4 {
        margin: 0;

        color: #111827;

        font-size: 14px;
        font-weight: 600;
    }

    .setting-info p {
        margin: 4px 0 0;

        color: #9ca3af;

        font-size: 12px;
    }

    .secondary-btn {
        padding: 8px 14px;

        border: 1px solid #d1d5db;
        border-radius: 7px;

        background: #ffffff;
        color: #374151;

        text-decoration: none;

        font-size: 12px;
        font-weight: 600;

        white-space: nowrap;
    }

    .secondary-btn:hover {
        background: #f9fafb;
    }

    .danger-icon {
        background: #fef2f2;
        color: #dc2626;
    }

    .danger-content {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;

        padding: 24px 26px;
    }

    .danger-content p {
        margin: 0;

        color: #6b7280;

        font-size: 12px;
    }

    .logout-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;

        padding: 9px 15px;

        border: 1px solid #fecaca;
        border-radius: 8px;

        background: #ffffff;
        color: #dc2626;

        font-family: inherit;
        font-size: 12px;
        font-weight: 600;

        cursor: pointer;

        white-space: nowrap;
    }

    .logout-btn:hover {
        background: #fef2f2;
    }

    @media (max-width: 700px) {
        .form-grid {
            grid-template-columns: 1fr;
        }

        .full-width {
            grid-column: auto;
        }

        .setting-item,
        .danger-content {
            align-items: flex-start;
            flex-direction: column;
        }

        .secondary-btn,
        .logout-btn {
            width: 100%;
            text-align: center;
            justify-content: center;
        }
    }
</style>
