
---
import TherapistLayout from "../../layouts/TherapistLayout.astro";
import { API_BASE_URL } from "../../config/api";
---

<TherapistLayout title="نوبت‌ها">
  <main class="appointments-page">
    <div class="page-header">
      <div>
        <h1>مدیریت زمان‌های آزاد</h1>
        <p>زمان‌های آزاد خود را برای رزرو توسط بیماران مدیریت کنید.</p>
      </div>

      <button class="btn btn-primary" id="open-create-modal">
        + افزودن زمان آزاد
      </button>
    </div>

    <div class="stats">
      <div class="stat-card">
        <span class="stat-label">تعداد روزها</span>
        <strong id="days-count">0</strong>
      </div>

      <div class="stat-card">
        <span class="stat-label">تعداد زمان‌های آزاد</span>
        <strong id="slots-count">0</strong>
      </div>
    </div>

    <div id="loading" class="state-box">
      در حال دریافت زمان‌های آزاد...
    </div>

    <div id="error" class="state-box error-box hidden"></div>

    <div id="empty" class="state-box hidden">
      <div class="empty-icon">📅</div>
      <h3>زمان آزادی ثبت نشده است</h3>
      <p>برای شروع، یک زمان آزاد جدید اضافه کنید.</p>
    </div>

    <div id="table-container" class="table-container hidden">
      <table>
        <thead>
          <tr>
            <th>روز</th>
            <th>تاریخ</th>
            <th>زمان</th>
            <th>وضعیت</th>
            <th>عملیات</th>
          </tr>
        </thead>

        <tbody id="appointments-table-body"></tbody>
      </table>
    </div>
  </main>

  <!-- Create Modal -->
  <div class="modal-overlay hidden" id="create-modal">
    <div class="modal">
      <div class="modal-header">
        <div>
          <h2>افزودن زمان آزاد</h2>
          <p>یک تاریخ و زمان برای رزرو بیماران اضافه کنید.</p>
        </div>

        <button class="modal-close" data-close-modal="create-modal">
          ×
        </button>
      </div>

      <form id="create-form">
        <div class="form-group">
          <label for="create-date">تاریخ</label>
          <input
            id="create-date"
            name="date"
            type="date"
            required
          />
          <small>تاریخ به صورت میلادی انتخاب می‌شود.</small>
        </div>

        <div class="form-group">
          <label for="create-time">زمان</label>
          <input
            id="create-time"
            name="time"
            type="time"
            step="1"
            required
          />
        </div>

        <div id="create-error" class="form-error hidden"></div>

        <div class="modal-actions">
          <button
            type="button"
            class="btn btn-secondary"
            data-close-modal="create-modal"
          >
            انصراف
          </button>

          <button type="submit" class="btn btn-primary" id="create-submit">
            ایجاد زمان
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- Update Modal -->
  <div class="modal-overlay hidden" id="update-modal">
    <div class="modal">
      <div class="modal-header">
        <div>
          <h2>ویرایش زمان آزاد</h2>
          <p>تاریخ یا زمان این زمان آزاد را تغییر دهید.</p>
        </div>

        <button class="modal-close" data-close-modal="update-modal">
          ×
        </button>
      </div>

      <form id="update-form">
        <input type="hidden" id="update-id" />

        <div class="form-group">
          <label for="update-date">تاریخ</label>
          <input
            id="update-date"
            name="date"
            type="date"
            required
          />
          <small>تاریخ به صورت میلادی انتخاب می‌شود.</small>
        </div>

        <div class="form-group">
          <label for="update-time">زمان</label>
          <input
            id="update-time"
            name="time"
            type="time"
            step="1"
            required
          />
        </div>

        <div id="update-error" class="form-error hidden"></div>

        <div class="modal-actions">
          <button
            type="button"
            class="btn btn-secondary"
            data-close-modal="update-modal"
          >
            انصراف
          </button>

          <button type="submit" class="btn btn-primary" id="update-submit">
            ذخیره تغییرات
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- Delete Modal -->
  <div class="modal-overlay hidden" id="delete-modal">
    <div class="modal modal-small">
      <div class="modal-header">
        <div>
          <h2>حذف زمان آزاد</h2>
        </div>

        <button class="modal-close" data-close-modal="delete-modal">
          ×
        </button>
      </div>

      <div class="delete-content">
        <div class="delete-icon">⚠️</div>

        <p>
          آیا مطمئن هستید که می‌خواهید این زمان آزاد را حذف کنید؟
        </p>

        <div class="delete-info">
          <div>
            <span>تاریخ:</span>
            <strong id="delete-date"></strong>
          </div>

          <div>
            <span>زمان:</span>
            <strong id="delete-time"></strong>
          </div>
        </div>
      </div>

      <div id="delete-error" class="form-error hidden"></div>

      <div class="modal-actions">
        <button
          type="button"
          class="btn btn-secondary"
          data-close-modal="delete-modal"
        >
          انصراف
        </button>

        <button type="button" class="btn btn-danger" id="delete-submit">
          حذف
        </button>
      </div>
    </div>
  </div>
</TherapistLayout>

<style>
  .appointments-page {
    direction: rtl;
    text-align: right;
    padding: 24px;
  }

  .page-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    margin-bottom: 24px;
  }

  .page-header h1 {
    margin: 0 0 8px;
    font-size: 28px;
  }

  .page-header p {
    margin: 0;
    color: #6b7280;
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(180px, 1fr));
    gap: 16px;
    margin-bottom: 24px;
  }

  .stat-card {
    background: #fff;
    border: 1px solid #e5e7eb;
    border-radius: 12px;
    padding: 20px;
  }

  .stat-label {
    display: block;
    color: #6b7280;
    font-size: 14px;
    margin-bottom: 8px;
  }

  .stat-card strong {
    font-size: 28px;
  }

  .btn {
    border: 0;
    border-radius: 8px;
    padding: 10px 18px;
    cursor: pointer;
    font-size: 14px;
    font-family: inherit;
    transition: opacity 0.2s, transform 0.2s;
  }

  .btn:hover {
    opacity: 0.9;
  }

  .btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .btn-primary {
    background: #2563eb;
    color: #fff;
  }

  .btn-secondary {
    background: #e5e7eb;
    color: #111827;
  }

  .btn-danger {
    background: #dc2626;
    color: #fff;
  }

  .state-box {
    background: #fff;
    border: 1px solid #e5e7eb;
    border-radius: 12px;
    padding: 40px 20px;
    text-align: center;
    color: #6b7280;
  }

  .error-box,
  .form-error {
    color: #b91c1c;
    background: #fef2f2;
    border: 1px solid #fecaca;
  }

  .form-error {
    border-radius: 8px;
    padding: 10px 12px;
    margin-top: 14px;
    font-size: 14px;
  }

  .empty-icon {
    font-size: 42px;
    margin-bottom: 10px;
  }

  .state-box h3 {
    margin: 0 0 8px;
    color: #111827;
  }

  .state-box p {
    margin: 0;
  }

  .table-container {
    background: #fff;
    border: 1px solid #e5e7eb;
    border-radius: 12px;
    overflow-x: auto;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    direction: rtl;
  }

  th,
  td {
    padding: 15px 16px;
    border-bottom: 1px solid #e5e7eb;
    text-align: right;
    white-space: nowrap;
  }

  th {
    background: #f9fafb;
    font-weight: 600;
    color: #374151;
  }

  td {
    color: #4b5563;
  }

  tbody tr:last-child td {
    border-bottom: 0;
  }

  tbody tr:hover {
    background: #f9fafb;
  }

  .date-cell,
  .time-cell {
    direction: ltr;
    text-align: right;
    font-variant-numeric: tabular-nums;
  }

  .status {
    display: inline-flex;
    align-items: center;
    border-radius: 999px;
    padding: 5px 10px;
    font-size: 12px;
    font-weight: 600;
  }

  .status-available {
    background: #dcfce7;
    color: #166534;
  }

  .status-booked {
    background: #fef3c7;
    color: #92400e;
  }

  .status-unknown {
    background: #f3f4f6;
    color: #4b5563;
  }

  .actions {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 8px;
  }

  .action-btn {
    border: 0;
    border-radius: 7px;
    padding: 7px 11px;
    cursor: pointer;
    font-family: inherit;
    font-size: 13px;
  }

  .edit-btn {
    background: #dbeafe;
    color: #1d4ed8;
  }

  .delete-btn {
    background: #fee2e2;
    color: #b91c1c;
  }

  .modal-overlay {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
    background: rgba(0, 0, 0, 0.45);
  }

  .modal {
    width: min(500px, 100%);
    background: #fff;
    border-radius: 14px;
    padding: 24px;
    direction: rtl;
    text-align: right;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.15);
  }

  .modal-small {
    width: min(430px, 100%);
  }

  .modal-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 24px;
  }

  .modal-header h2 {
    margin: 0 0 6px;
    font-size: 21px;
  }

  .modal-header p {
    margin: 0;
    color: #6b7280;
    font-size: 14px;
  }

  .modal-close {
    border: 0;
    background: transparent;
    color: #6b7280;
    font-size: 28px;
    line-height: 1;
    cursor: pointer;
  }

  .form-group {
    margin-bottom: 18px;
  }

  .form-group label {
    display: block;
    margin-bottom: 8px;
    font-weight: 600;
    color: #374151;
  }

  .form-group input {
    width: 100%;
    box-sizing: border-box;
    border: 1px solid #d1d5db;
    border-radius: 8px;
    padding: 11px 12px;
    font-family: inherit;
    font-size: 15px;
    background: #fff;
    color: #111827;
  }

  .form-group input:focus {
    outline: none;
    border-color: #2563eb;
    box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1);
  }

  .form-group small {
    display: block;
    margin-top: 6px;
    color: #6b7280;
    font-size: 12px;
  }

  .modal-actions {
    display: flex;
    justify-content: flex-start;
    gap: 10px;
    margin-top: 24px;
  }

  .delete-content {
    text-align: center;
  }

  .delete-icon {
    font-size: 40px;
    margin-bottom: 12px;
  }

  .delete-content > p {
    color: #4b5563;
    line-height: 1.8;
    margin: 0 0 18px;
  }

  .delete-info {
    background: #f9fafb;
    border-radius: 8px;
    padding: 14px;
    text-align: right;
  }

  .delete-info div {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 5px 0;
  }

  .delete-info span {
    color: #6b7280;
  }

  .hidden {
    display: none !important;
  }

  @media (max-width: 700px) {
    .appointments-page {
      padding: 16px;
    }

    .page-header {
      flex-direction: column;
      align-items: stretch;
    }

    .stats {
      grid-template-columns: 1fr;
    }

    .page-header .btn {
      width: 100%;
    }

    .modal {
      padding: 18px;
    }
  }
</style>

<script define:vars={{ API_BASE_URL }}>
  interface Slot {
    id: number;
    time: string;
    status: string;
  }

  interface AppointmentDay {
    id: number;
    date: string;
    day_name: string;
    slots: Slot[];
  }

  interface AppointmentResponse {
    links?: {
      next: string | null;
      previous: string | null;
    };
    count: number;
    results: AppointmentDay[];
  }

  interface SlotDetail {
    id: number;
    date: string;
    time: string;
    created_at: string;
    therapist: unknown;
  }

  const TODAY_APPOINTMENTS_URL =
    `${API_BASE_URL}/booking/appointments/today/`;

  const CREATE_SLOT_URL =
    `${API_BASE_URL}/booking/create/appointment-slots/`;

  const SLOT_URL =
    `${API_BASE_URL}/booking/appointment-slots/`;

  const loading = document.getElementById("loading");
  const errorBox = document.getElementById("error");
  const emptyBox = document.getElementById("empty");
  const tableContainer = document.getElementById("table-container");
  const tableBody = document.getElementById("appointments-table-body");

  const daysCount = document.getElementById("days-count");
  const slotsCount = document.getElementById("slots-count");

  const createModal = document.getElementById("create-modal");
  const updateModal = document.getElementById("update-modal");
  const deleteModal = document.getElementById("delete-modal");

  const createForm = document.getElementById(
    "create-form"
  ) as HTMLFormElement;

  const updateForm = document.getElementById(
    "update-form"
  ) as HTMLFormElement;

  const createDate = document.getElementById(
    "create-date"
  ) as HTMLInputElement;

  const createTime = document.getElementById(
    "create-time"
  ) as HTMLInputElement;

  const updateId = document.getElementById(
    "update-id"
  ) as HTMLInputElement;

  const updateDate = document.getElementById(
    "update-date"
  ) as HTMLInputElement;

  const updateTime = document.getElementById(
    "update-time"
  ) as HTMLInputElement;

  const deleteDate = document.getElementById(
    "delete-date"
  );

  const deleteTime = document.getElementById(
    "delete-time"
  );

  const createError = document.getElementById("create-error");
  const updateError = document.getElementById("update-error");
  const deleteError = document.getElementById("delete-error");

  const createSubmit = document.getElementById(
    "create-submit"
  ) as HTMLButtonElement;

  const updateSubmit = document.getElementById(
    "update-submit"
  ) as HTMLButtonElement;

  const deleteSubmit = document.getElementById(
    "delete-submit"
  ) as HTMLButtonElement;

  let selectedDeleteId: number | null = null;

  function showElement(element: HTMLElement | null) {
    element?.classList.remove("hidden");
  }

  function hideElement(element: HTMLElement | null) {
    element?.classList.add("hidden");
  }

  function extractApiError(
    data: unknown,
    fallback: string
  ): string {
    if (data && typeof data === "object") {
      const messages = Object.values(
        data as Record<string, unknown>
      )
        .flatMap((value) =>
          Array.isArray(value) ? value : [value]
        )
        .filter(
          (value) =>
            typeof value === "string" ||
            typeof value === "number"
        )
        .map(String);

      if (messages.length > 0) {
        return messages.join(" ");
      }
    }

    return fallback;
  }

  function normalizeDate(date: string): string {
    return date.trim().replace(/\//g, "-");
  }

  function normalizeTime(time: string): string {
    const value = time.trim();

    if (value.length === 5) {
      return `${value}:00`;
    }

    return value;
  }

  function formatTime(time: string): string {
    if (!time) return "-";

    return time.substring(0, 5);
  }

  function formatDate(date: string): string {
    if (!date) return "-";

    return date;
  }

  function getStatusClass(status: string): string {
    switch (status.toLowerCase()) {
      case "available":
        return "status status-available";

      case "booked":
        return "status status-booked";

      default:
        return "status status-unknown";
    }
  }

  function getStatusText(status: string): string {
    switch (status.toLowerCase()) {
      case "available":
        return "آزاد";

      case "booked":
        return "رزرو شده";

      default:
        return status || "نامشخص";
    }
  }

  async function loadAppointments() {
    hideElement(errorBox);
    hideElement(emptyBox);
    hideElement(tableContainer);
    showElement(loading);

    try {
      const response = await fetch(
        TODAY_APPOINTMENTS_URL,
        {
          method: "GET",
          credentials: "include",
        }
      );

      if (!response.ok) {
        let errorData: unknown = null;

        try {
          errorData = await response.json();
        } catch {
          // Ignore invalid JSON response.
        }

        throw new Error(
          extractApiError(
            errorData,
            "دریافت زمان‌های آزاد با خطا مواجه شد."
          )
        );
      }

      const data: AppointmentResponse =
        await response.json();

      renderAppointments(data);
    } catch (error) {
      const message =
        error instanceof Error
          ? error.message
          : "خطایی رخ داد.";

      if (errorBox) {
        errorBox.textContent = message;
      }

      showElement(errorBox);
    } finally {
      hideElement(loading);
    }
  }

  function renderAppointments(
    data: AppointmentResponse
  ) {
    if (!tableBody) return;

    tableBody.innerHTML = "";

    const days = data.results ?? [];

    const totalSlots = days.reduce(
      (total, day) => total + day.slots.length,
      0
    );

    if (daysCount) {
      daysCount.textContent = String(days.length);
    }

    if (slotsCount) {
      slotsCount.textContent = String(totalSlots);
    }

    if (days.length === 0 || totalSlots === 0) {
      showElement(emptyBox);
      return;
    }

    for (const day of days) {
      for (const slot of day.slots) {
        const row = document.createElement("tr");

        row.innerHTML = `
          <td>${day.day_name || "-"}</td>

          <td class="date-cell">
            ${formatDate(day.date)}
          </td>

          <td class="time-cell">
            ${formatTime(slot.time)}
          </td>

          <td>
            <span class="${getStatusClass(slot.status)}">
              ${getStatusText(slot.status)}
            </span>
          </td>

          <td>
            <div class="actions">
              <button
                class="action-btn edit-btn"
                data-action="edit"
                data-id="${slot.id}"
              >
                ویرایش
              </button>

              <button
                class="action-btn delete-btn"
                data-action="delete"
                data-id="${slot.id}"
                data-date="${day.date}"
                data-time="${slot.time}"
              >
                حذف
              </button>
            </div>
          </td>
        `;

        tableBody.appendChild(row);
      }
    }

    showElement(tableContainer);
  }

  function openModal(modal: HTMLElement | null) {
    if (!modal) return;

    modal.classList.remove("hidden");
    document.body.style.overflow = "hidden";
  }

  function closeModal(modal: HTMLElement | null) {
    if (!modal) return;

    modal.classList.add("hidden");
    document.body.style.overflow = "";
  }

  function resetError(element: HTMLElement | null) {
    if (!element) return;

    element.textContent = "";
    hideElement(element);
  }

  function setButtonLoading(
    button: HTMLButtonElement,
    loadingState: boolean,
    loadingText: string,
    normalText: string
  ) {
    button.disabled = loadingState;
    button.textContent = loadingState
      ? loadingText
      : normalText;
  }

  async function openUpdateModal(slotId: number) {
    resetError(updateError);

    try {
      const response = await fetch(
        `${SLOT_URL}${slotId}/`,
        {
          method: "GET",
          credentials: "include",
        }
      );

      if (!response.ok) {
        let errorData: unknown = null;

        try {
          errorData = await response.json();
        } catch {
          // Ignore invalid JSON response.
        }

        throw new Error(
          extractApiError(
            errorData,
            "دریافت اطلاعات زمان با خطا مواجه شد."
          )
        );
      }

      const data: SlotDetail =
        await response.json();

      updateId.value = String(data.id);
      updateDate.value = data.date;
      updateTime.value = data.time.substring(0, 8);

      openModal(updateModal);
    } catch (error) {
      const message =
        error instanceof Error
          ? error.message
          : "خطایی رخ داد.";

      if (updateError) {
        updateError.textContent = message;
      }

      showElement(updateError);
      openModal(updateModal);
    }
  }

  function openDeleteModal(
    slotId: number,
    date: string,
    time: string
  ) {
    selectedDeleteId = slotId;

    resetError(deleteError);

    if (deleteDate) {
      deleteDate.textContent = formatDate(date);
    }

    if (deleteTime) {
      deleteTime.textContent = formatTime(time);
    }

    openModal(deleteModal);
  }

  document
    .getElementById("open-create-modal")
    ?.addEventListener("click", () => {
      resetError(createError);

      createForm.reset();

      openModal(createModal);
    });

  document
    .querySelectorAll("[data-close-modal]")
    .forEach((button) => {
      button.addEventListener("click", () => {
        const modalId =
          button.getAttribute("data-close-modal");

        if (!modalId) return;

        closeModal(
          document.getElementById(modalId)
        );
      });
    });

  document
    .querySelectorAll(".modal-overlay")
    .forEach((overlay) => {
      overlay.addEventListener("click", (event) => {
        if (event.target === overlay) {
          closeModal(overlay as HTMLElement);
        }
      });
    });

  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape") return;

    document
      .querySelectorAll(".modal-overlay:not(.hidden)")
      .forEach((modal) => {
        closeModal(modal as HTMLElement);
      });
  });

  createForm.addEventListener(
    "submit",
    async (event) => {
      event.preventDefault();

      resetError(createError);

      const date = normalizeDate(createDate.value);
      const time = normalizeTime(createTime.value);

      if (!date || !time) {
        if (createError) {
          createError.textContent =
            "تاریخ و زمان را وارد کنید.";
        }

        showElement(createError);
        return;
      }

      setButtonLoading(
        createSubmit,
        true,
        "در حال ایجاد...",
        "ایجاد زمان"
      );

      try {
        const response = await fetch(
          CREATE_SLOT_URL,
          {
            method: "POST",
            credentials: "include",
            headers: {
              "Content-Type": "application/json",
            },
            body: JSON.stringify({
              date,
              time,
            }),
          }
        );

        if (!response.ok) {
          let errorData: unknown = null;

          try {
            errorData = await response.json();
          } catch {
            // Ignore invalid JSON response.
          }

          throw new Error(
            extractApiError(
              errorData,
              "ایجاد زمان آزاد با خطا مواجه شد."
            )
          );
        }

        closeModal(createModal);

        await loadAppointments();
      } catch (error) {
        const message =
          error instanceof Error
            ? error.message
            : "خطایی رخ داد.";

        if (createError) {
          createError.textContent = message;
        }

        showElement(createError);
      } finally {
        setButtonLoading(
          createSubmit,
          false,
          "در حال ایجاد...",
          "ایجاد زمان"
        );
      }
    }
  );

  updateForm.addEventListener(
    "submit",
    async (event) => {
      event.preventDefault();

      resetError(updateError);

      const slotId = updateId.value;
      const date = normalizeDate(updateDate.value);
      const time = normalizeTime(updateTime.value);

      if (!slotId || !date || !time) {
        if (updateError) {
          updateError.textContent =
            "اطلاعات تاریخ و زمان را کامل وارد کنید.";
        }

        showElement(updateError);
        return;
      }

      setButtonLoading(
        updateSubmit,
        true,
        "در حال ذخیره...",
        "ذخیره تغییرات"
      );

      try {
        const response = await fetch(
          `${SLOT_URL}${slotId}/`,
          {
            method: "PUT",
            credentials: "include",
            headers: {
              "Content-Type": "application/json",
            },
            body: JSON.stringify({
              date,
              time,
            }),
          }
        );

        if (!response.ok) {
          let errorData: unknown = null;

          try {
            errorData = await response.json();
          } catch {
            // Ignore invalid JSON response.
          }

          throw new Error(
            extractApiError(
              errorData,
              "ویرایش زمان آزاد با خطا مواجه شد."
            )
          );
        }

        closeModal(updateModal);

        await loadAppointments();
      } catch (error) {
        const message =
          error instanceof Error
            ? error.message
            : "خطایی رخ داد.";

        if (updateError) {
          updateError.textContent = message;
        }

        showElement(updateError);
      } finally {
        setButtonLoading(
          updateSubmit,
          false,
          "در حال ذخیره...",
          "ذخیره تغییرات"
        );
      }
    }
  );

  deleteSubmit.addEventListener(
    "click",
    async () => {
      if (selectedDeleteId === null) {
        return;
      }

      resetError(deleteError);

      setButtonLoading(
        deleteSubmit,
        true,
        "در حال حذف...",
        "حذف"
      );

      try {
        const response = await fetch(
          `${SLOT_URL}${selectedDeleteId}/`,
          {
            method: "DELETE",
            credentials: "include",
          }
        );

        if (!response.ok) {
          let errorData: unknown = null;

          try {
            errorData = await response.json();
          } catch {
            // DELETE ممکن است body نداشته باشد.
          }

          throw new Error(
            extractApiError(
              errorData,
              "حذف زمان آزاد با خطا مواجه شد."
            )
          );
        }

        closeModal(deleteModal);

        selectedDeleteId = null;

        await loadAppointments();
      } catch (error) {
        const message =
          error instanceof Error
            ? error.message
            : "خطایی رخ داد.";

        if (deleteError) {
          deleteError.textContent = message;
        }

        showElement(deleteError);
      } finally {
        setButtonLoading(
          deleteSubmit,
          false,
          "در حال حذف...",
          "حذف"
        );
      }
    }
  );

  tableBody?.addEventListener(
    "click",
    (event) => {
      const target = event.target as HTMLElement;

      const button =
        target.closest<HTMLButtonElement>(
          "button[data-action]"
        );

      if (!button) return;

      const action =
        button.dataset.action;

      const id = Number(button.dataset.id);

      if (!id) return;

      if (action === "edit") {
        openUpdateModal(id);
      }

      if (action === "delete") {
        openDeleteModal(
          id,
          button.dataset.date || "",
          button.dataset.time || ""
        );
      }
    }
  );

  loadAppointments();
</script>
