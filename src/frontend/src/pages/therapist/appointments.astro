
---
import TherapistLayout from "../../layouts/TherapistLayout.astro";

const demoDays = [
    {
        id: 1,
        dayName: "امروز",
        date: "۱۹ شهریور",
        slots: [
            { time: "09:00", status: "available" },
            { time: "10:30", status: "booked" },
            { time: "11:00", status: "available" },
            { time: "14:00", status: "available" },
            { time: "15:30", status: "booked" },
            { time: "17:00", status: "available" },
        ],
    },
    {
        id: 2,
        dayName: "فردا",
        date: "۲۰ شهریور",
        slots: [
            { time: "09:30", status: "available" },
            { time: "11:00", status: "available" },
            { time: "13:30", status: "booked" },
            { time: "15:00", status: "available" },
            { time: "16:30", status: "available" },
        ],
    },
    {
        id: 3,
        dayName: "شنبه",
        date: "۲۱ شهریور",
        slots: [
            { time: "10:00", status: "available" },
            { time: "11:30", status: "available" },
            { time: "14:00", status: "booked" },
            { time: "16:00", status: "available" },
            { time: "17:30", status: "available" },
        ],
    },
    {
        id: 4,
        dayName: "یکشنبه",
        date: "۲۲ شهریور",
        slots: [
            { time: "09:00", status: "available" },
            { time: "10:00", status: "booked" },
            { time: "12:00", status: "available" },
            { time: "15:30", status: "available" },
            { time: "18:00", status: "booked" },
        ],
    },
    {
        id: 5,
        dayName: "دوشنبه",
        date: "۲۳ شهریور",
        slots: [
            { time: "09:30", status: "available" },
            { time: "11:00", status: "available" },
            { time: "14:30", status: "available" },
            { time: "16:00", status: "booked" },
        ],
    },
];
---

<TherapistLayout title="نوبت‌ها">
    <main class="appointments-page">
        <section class="appointments-container">

            <div class="page-header">
                <div class="header-icon">
                    <i class="fa-solid fa-calendar-days"></i>
                </div>

                <div>
                    <h1>نوبت‌ها</h1>
                    <p>
                        زمان‌های ایجاد شده و وضعیت رزرو آن‌ها را مشاهده کنید.
                    </p>
                </div>

                <a href="/therapist/slots" class="create-slot-button">
                    <i class="fa-solid fa-plus"></i>
                    ایجاد زمان جدید
                </a>
            </div>

            <section class="stats-grid">
                <div class="stat-card">
                    <div class="stat-icon">
                        <i class="fa-solid fa-calendar-plus"></i>
                    </div>

                    <div>
                        <span>کل زمان‌ها</span>
                        <strong id="total-slots">--</strong>
                    </div>
                </div>

                <div class="stat-card">
                    <div class="stat-icon available">
                        <i class="fa-solid fa-clock"></i>
                    </div>

                    <div>
                        <span>زمان‌های آزاد</span>
                        <strong id="available-slots">--</strong>
                    </div>
                </div>

                <div class="stat-card">
                    <div class="stat-icon booked">
                        <i class="fa-solid fa-calendar-check"></i>
                    </div>

                    <div>
                        <span>رزرو شده</span>
                        <strong id="booked-slots">--</strong>
                    </div>
                </div>
            </section>

            <section class="appointments-card">

                <div class="card-header">
                    <div>
                        <h2>زمان‌های ایجاد شده</h2>
                        <p>
                            زمان‌هایی که برای مراجعه بیماران ایجاد کرده‌اید.
                        </p>
                    </div>

                    <div class="legend">
                        <span>
                            <i class="available-dot"></i>
                            آزاد
                        </span>

                        <span>
                            <i class="booked-dot"></i>
                            رزرو شده
                        </span>
                    </div>
                </div>

                <div class="days-list" id="days-list">
                    {
                        demoDays.map((day, index) => (
                            <button
                                type="button"
                                class:list={{ active: index === 0 }}
                                class="day-card"
                                data-day-id={day.id}
                            >
                                <span class="day-name">
                                    {day.dayName}
                                </span>

                                <span class="day-date">
                                    {day.date}
                                </span>

                                <span class="day-slot-count">
                                    {day.slots.length} زمان
                                </span>
                            </button>
                        ))
                    }
                </div>

                <div class="slots-section">

                    <div class="slots-header">
                        <div>
                            <h3 id="selected-day-title">
                                زمان‌های امروز
                            </h3>

                            <p id="selected-day-description">
                                وضعیت زمان‌های ایجاد شده برای امروز
                            </p>
                        </div>

                        <span class="slot-count" id="slot-count">
                            ۰ زمان
                        </span>
                    </div>

                    <div
                        class="slots-grid"
                        id="slots-grid"
                    ></div>

                    <div
                        class="empty-message"
                        id="empty-message"
                        hidden
                    >
                        <i class="fa-regular fa-calendar-xmark"></i>

                        <span>
                            برای این روز زمانی ایجاد نکرده‌اید.
                        </span>
                    </div>

                </div>

            </section>

        </section>
    </main>
</TherapistLayout>

<script>
    const demoDays = [
        {
            id: 1,
            dayName: "امروز",
            date: "۱۹ شهریور",
            slots: [
                { time: "09:00", status: "available" },
                { time: "10:30", status: "booked" },
                { time: "11:00", status: "available" },
                { time: "14:00", status: "available" },
                { time: "15:30", status: "booked" },
                { time: "17:00", status: "available" },
            ],
        },
        {
            id: 2,
            dayName: "فردا",
            date: "۲۰ شهریور",
            slots: [
                { time: "09:30", status: "available" },
                { time: "11:00", status: "available" },
                { time: "13:30", status: "booked" },
                { time: "15:00", status: "available" },
                { time: "16:30", status: "available" },
            ],
        },
        {
            id: 3,
            dayName: "شنبه",
            date: "۲۱ شهریور",
            slots: [
                { time: "10:00", status: "available" },
                { time: "11:30", status: "available" },
                { time: "14:00", status: "booked" },
                { time: "16:00", status: "available" },
                { time: "17:30", status: "available" },
            ],
        },
        {
            id: 4,
            dayName: "یکشنبه",
            date: "۲۲ شهریور",
            slots: [
                { time: "09:00", status: "available" },
                { time: "10:00", status: "booked" },
                { time: "12:00", status: "available" },
                { time: "15:30", status: "available" },
                { time: "18:00", status: "booked" },
            ],
        },
        {
            id: 5,
            dayName: "دوشنبه",
            date: "۲۳ شهریور",
            slots: [
                { time: "09:30", status: "available" },
                { time: "11:00", status: "available" },
                { time: "14:30", status: "available" },
                { time: "16:00", status: "booked" },
            ],
        },
    ];

    const daysList =
        document.getElementById("days-list") as HTMLElement;

    const slotsGrid =
        document.getElementById("slots-grid") as HTMLElement;

    const selectedDayTitle =
        document.getElementById(
            "selected-day-title"
        ) as HTMLElement;

    const selectedDayDescription =
        document.getElementById(
            "selected-day-description"
        ) as HTMLElement;

    const slotCount =
        document.getElementById("slot-count") as HTMLElement;

    const emptyMessage =
        document.getElementById("empty-message") as HTMLElement;

    const totalSlotsElement =
        document.getElementById("total-slots") as HTMLElement;

    const availableSlotsElement =
        document.getElementById(
            "available-slots"
        ) as HTMLElement;

    const bookedSlotsElement =
        document.getElementById(
            "booked-slots"
        ) as HTMLElement;

    const calculateStats = () => {
        const allSlots = demoDays.flatMap(
            (day) => day.slots
        );

        const total = allSlots.length;

        const available = allSlots.filter(
            (slot) => slot.status === "available"
        ).length;

        const booked = allSlots.filter(
            (slot) => slot.status === "booked"
        ).length;

        totalSlotsElement.textContent =
            String(total);

        availableSlotsElement.textContent =
            String(available);

        bookedSlotsElement.textContent =
            String(booked);
    };

    const renderSlots = (dayId: number) => {
        const day = demoDays.find(
            (item) => item.id === dayId
        );

        if (!day) {
            return;
        }

        slotsGrid.innerHTML = "";

        selectedDayTitle.textContent =
            `زمان‌های ${day.dayName}`;

        selectedDayDescription.textContent =
            `وضعیت زمان‌های ایجاد شده برای ${day.dayName}`;

        slotCount.textContent =
            `${day.slots.length} زمان`;

        if (day.slots.length === 0) {
            emptyMessage.hidden = false;
            return;
        }

        emptyMessage.hidden = true;

        day.slots.forEach((slot) => {
            const slotCard =
                document.createElement("div");

            slotCard.className =
                `slot-card ${slot.status}`;

            const time =
                document.createElement("span");

            time.className = "slot-time";
            time.textContent = slot.time;

            const statusWrapper =
                document.createElement("div");

            statusWrapper.className =
                "slot-status";

            const statusDot =
                document.createElement("span");

            statusDot.className =
                "status-dot";

            const statusText =
                document.createElement("span");

            statusText.textContent =
                slot.status === "available"
                    ? "آزاد"
                    : "رزرو شده";

            statusWrapper.appendChild(
                statusDot
            );

            statusWrapper.appendChild(
                statusText
            );

            slotCard.appendChild(time);
            slotCard.appendChild(statusWrapper);

            slotsGrid.appendChild(slotCard);
        });
    };

    daysList
        .querySelectorAll<HTMLButtonElement>(
            ".day-card"
        )
        .forEach((button) => {
            button.addEventListener(
                "click",
                () => {
                    daysList
                        .querySelectorAll(
                            ".day-card"
                        )
                        .forEach((item) => {
                            item.classList.remove(
                                "active"
                            );
                        });

                    button.classList.add("active");

                    const dayId = Number(
                        button.dataset.dayId
                    );

                    renderSlots(dayId);
                }
            );
        });

    calculateStats();
    renderSlots(1);
</script>

<style>
    .appointments-page {
        min-height: 100vh;
        padding: 35px 20px 60px;
        background: #f8f8f8;
        direction: rtl;
    }

    .appointments-container {
        width: 100%;
        max-width: 1000px;
        margin: 0 auto;
    }

    .page-header {
        display: flex;
        align-items: center;
        gap: 14px;
        margin-bottom: 24px;
    }

    .header-icon {
        width: 48px;
        height: 48px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        background: #222;
        color: #fff;
        font-size: 18px;
    }

    .page-header > div:nth-child(2) {
        flex: 1;
    }

    .page-header h1 {
        margin: 0 0 5px;
        color: #222;
        font-size: 24px;
        font-weight: 700;
    }

    .page-header p {
        margin: 0;
        color: #888;
        font-size: 13px;
    }

    .create-slot-button {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        min-height: 42px;
        padding: 0 16px;
        border-radius: 9px;
        background: #222;
        color: #fff;
        font-size: 12px;
        font-weight: 600;
        text-decoration: none;
        white-space: nowrap;
        transition: background 0.2s ease;
    }

    .create-slot-button:hover {
        background: #000;
    }

    /* Stats */

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 14px;
        margin-bottom: 18px;
    }

    .stat-card {
        display: flex;
        align-items: center;
        gap: 13px;
        padding: 18px;
        background: #fff;
        border: 1px solid #e9e9e9;
        border-radius: 14px;
    }

    .stat-icon {
        width: 40px;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        border-radius: 10px;
        background: #f1f1f1;
        color: #333;
        font-size: 14px;
    }

    .stat-icon.available {
        background: #f1f1f1;
    }

    .stat-icon.booked {
        background: #e9e9e9;
    }

    .stat-card span {
        display: block;
        margin-bottom: 4px;
        color: #999;
        font-size: 11px;
    }

    .stat-card strong {
        color: #222;
        font-size: 20px;
        font-weight: 700;
    }

    /* Main card */

    .appointments-card {
        overflow: hidden;
        background: #fff;
        border: 1px solid #e9e9e9;
        border-radius: 16px;
    }

    .card-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        padding: 22px 24px;
        border-bottom: 1px solid #eeeeee;
    }

    .card-header h2 {
        margin: 0 0 5px;
        color: #222;
        font-size: 17px;
        font-weight: 700;
    }

    .card-header p {
        margin: 0;
        color: #999;
        font-size: 12px;
    }

    .legend {
        display: flex;
        align-items: center;
        gap: 14px;
        color: #777;
        font-size: 11px;
    }

    .legend span {
        display: flex;
        align-items: center;
        gap: 5px;
    }

    .legend i {
        width: 7px;
        height: 7px;
        display: block;
        border-radius: 50%;
    }

    .available-dot {
        background: #555;
    }

    .booked-dot {
        background: #bbb;
    }

    /* Days */

    .days-list {
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        gap: 10px;
        padding: 20px 24px;
        border-bottom: 1px solid #eeeeee;
    }

    .day-card {
        min-height: 86px;
        padding: 12px 8px;
        border: 1px solid #e5e5e5;
        border-radius: 11px;
        background: #fff;
        color: #333;
        cursor: pointer;
        font-family: inherit;
        transition:
            border-color 0.2s ease,
            background 0.2s ease;
    }

    .day-card:hover {
        border-color: #bbb;
    }

    .day-card.active {
        border-color: #222;
        background: #222;
        color: #fff;
    }

    .day-name {
        display: block;
        margin-bottom: 6px;
        font-size: 12px;
        font-weight: 600;
    }

    .day-date {
        display: block;
        margin-bottom: 7px;
        color: #999;
        font-size: 11px;
    }

    .day-card.active .day-date {
        color: #ccc;
    }

    .day-slot-count {
        display: block;
        color: #aaa;
        font-size: 10px;
    }

    .day-card.active .day-slot-count {
        color: #ccc;
    }

    /* Slots */

    .slots-section {
        padding: 24px;
    }

    .slots-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 18px;
    }

    .slots-header h3 {
        margin: 0 0 5px;
        color: #222;
        font-size: 15px;
        font-weight: 700;
    }

    .slots-header p {
        margin: 0;
        color: #999;
        font-size: 11px;
    }

    .slot-count {
        color: #777;
        font-size: 11px;
        white-space: nowrap;
    }

    .slots-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 10px;
    }

    .slot-card {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        min-height: 58px;
        padding: 0 15px;
        border: 1px solid #e4e4e4;
        border-radius: 10px;
        background: #fff;
    }

    .slot-card.available {
        border-color: #ddd;
    }

    .slot-card.booked {
        background: #fafafa;
        border-color: #e8e8e8;
    }

    .slot-time {
        color: #222;
        font-size: 14px;
        font-weight: 700;
        direction: ltr;
    }

    .slot-status {
        display: flex;
        align-items: center;
        gap: 6px;
        color: #777;
        font-size: 10px;
        white-space: nowrap;
    }

    .status-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: #555;
    }

    .slot-card.booked .status-dot {
        background: #bbb;
    }

    .slot-card.booked .slot-status {
        color: #999;
    }

    .empty-message {
        min-height: 140px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        color: #999;
        font-size: 13px;
    }

    [hidden] {
        display: none !important;
    }

    @media (max-width: 800px) {
        .stats-grid {
            grid-template-columns: 1fr;
        }

        .days-list {
            grid-template-columns: repeat(3, 1fr);
        }

        .slots-grid {
            grid-template-columns: repeat(3, 1fr);
        }
    }

    @media (max-width: 600px) {
        .appointments-page {
            padding: 25px 14px 40px;
        }

        .page-header {
            align-items: flex-start;
            flex-wrap: wrap;
        }

        .create-slot-button {
            width: 100%;
            justify-content: center;
        }

        .card-header {
            align-items: flex-start;
            flex-direction: column;
            padding: 18px;
        }

        .days-list {
            grid-template-columns: repeat(2, 1fr);
            padding: 16px;
        }

        .slots-section {
            padding: 18px;
        }

        .slots-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @media (max-width: 400px) {
        .slots-grid {
            grid-template-columns: 1fr;
        }

        .slot-card {
            min-height: 54px;
        }
    }
</style>

