---
import TherapistLayout from "../../layouts/TherapistLayout.astro";
---

<TherapistLayout title="نوبت‌ها">
    <div class="appointments-page">

        <!-- Header -->

        <div class="page-header">
            <div class="page-header-content">

                <div class="page-header-icon">
                    <i class="fa-regular fa-calendar-days"></i>
                </div>

                <div>
                    <h1>نوبت‌ها</h1>

                    <p>
                        زمان‌های کاری و وضعیت رزرو نوبت‌های خود را مشاهده کنید.
                    </p>
                </div>

            </div>

            <a
                href="/therapist/slots"
                class="create-slot-btn"
            >
                <i class="fa-solid fa-plus"></i>
                ایجاد زمان آزاد
            </a>
        </div>


        <!-- Statistics -->

        <div class="stats-grid">

            <div class="stat-card">

                <div class="stat-icon">
                    <i class="fa-regular fa-calendar"></i>
                </div>

                <div class="stat-content">
                    <span>
                        کل زمان‌های آزاد
                    </span>

                    <strong id="total-slots">
                        ۰
                    </strong>
                </div>

            </div>


            <div class="stat-card">

                <div class="stat-icon">
                    <i class="fa-regular fa-clock"></i>
                </div>

                <div class="stat-content">
                    <span>
                        زمان‌های آزاد
                    </span>

                    <strong id="available-slots">
                        ۰
                    </strong>
                </div>

            </div>

        </div>


        <!-- Loading -->

        <div
            id="loading"
            class="state-card"
        >

            <div class="state-icon">
                <i class="fa-solid fa-spinner fa-spin"></i>
            </div>

            <h3>
                در حال دریافت نوبت‌ها
            </h3>

            <p>
                لطفاً کمی صبر کنید...
            </p>

        </div>


        <!-- Error -->

        <div
            id="error"
            class="state-card error-state"
            hidden
        >

            <div class="state-icon">
                <i class="fa-solid fa-circle-exclamation"></i>
            </div>

            <h3>
                دریافت نوبت‌ها انجام نشد
            </h3>

            <p>
                در دریافت اطلاعات مشکلی به وجود آمد.
            </p>

        </div>


        <!-- Empty -->

        <div
            id="empty"
            class="state-card"
            hidden
        >

            <div class="state-icon">
                <i class="fa-regular fa-calendar-xmark"></i>
            </div>

            <h3>
                زمان آزادی وجود ندارد
            </h3>

            <p>
                برای امروز و روزهای آینده هنوز زمان آزادی ایجاد نکرده‌اید.
            </p>

        </div>


        <!-- Table -->

        <div
            id="table-container"
            class="table-card"
            hidden
        >

            <div class="table-wrapper">

                <table class="appointments-table">

                    <thead>
                        <tr>
                            <th>روز</th>
                            <th>تاریخ</th>
                            <th>زمان</th>
                            <th>وضعیت</th>
                        </tr>
                    </thead>

                    <tbody id="appointments-body">
                    </tbody>

                </table>

            </div>

        </div>

    </div>
</TherapistLayout>


<style>

    /* =========================
       Base
    ========================== */

    .appointments-page {
        direction: rtl;

        width: 100%;
        max-width: 1400px;

        margin: 0 auto;
        padding: 30px;

        box-sizing: border-box;

        text-align: right;
    }


    /* =========================
       Header
    ========================== */

    .page-header {
        display: flex;

        align-items: center;
        justify-content: space-between;

        gap: 20px;

        margin-bottom: 30px;
    }


    .page-header-content {
        display: flex;

        align-items: center;

        gap: 16px;

        min-width: 0;
    }


    .page-header-icon {
        width: 58px;
        height: 58px;

        flex-shrink: 0;

        display: flex;

        align-items: center;
        justify-content: center;

        border-radius: 16px;

        background: #f1f5f9;

        color: #334155;

        font-size: 24px;
    }


    .page-header h1 {
        margin: 0 0 6px;

        color: #111827;

        font-size: 28px;

        font-weight: 700;

        line-height: 1.5;
    }


    .page-header p {
        margin: 0;

        color: #64748b;

        font-size: 14px;

        line-height: 1.8;
    }


    /* =========================
       Create Button
    ========================== */

    .create-slot-btn {
        display: inline-flex;

        align-items: center;
        justify-content: center;

        gap: 8px;

        flex-shrink: 0;

        padding: 12px 18px;

        border-radius: 12px;

        background: #111827;

        color: #ffffff;

        text-decoration: none;

        font-size: 14px;

        font-weight: 600;

        line-height: 1.5;

        transition:
            background 0.2s ease,
            transform 0.2s ease;
    }


    .create-slot-btn:hover {
        background: #1f2937;

        color: #ffffff;

        transform: translateY(-1px);
    }


    .create-slot-btn i {
        font-size: 13px;
    }


    /* =========================
       Statistics
    ========================== */

    .stats-grid {
        display: grid;

        grid-template-columns:
            repeat(2, minmax(0, 1fr));

        gap: 18px;

        margin-bottom: 30px;
    }


    .stat-card {
        display: flex;

        align-items: center;

        gap: 16px;

        min-width: 0;

        padding: 20px;

        background: #ffffff;

        border: 1px solid #e5e7eb;

        border-radius: 16px;

        box-sizing: border-box;
    }


    .stat-icon {
        width: 48px;
        height: 48px;

        flex-shrink: 0;

        display: flex;

        align-items: center;
        justify-content: center;

        border-radius: 12px;

        background: #f1f5f9;

        color: #334155;

        font-size: 20px;
    }


    .stat-content {
        display: flex;

        flex-direction: column;

        gap: 4px;

        min-width: 0;
    }


    .stat-content span {
        color: #64748b;

        font-size: 13px;

        line-height: 1.7;
    }


    .stat-content strong {
        color: #111827;

        font-size: 24px;

        font-weight: 700;

        line-height: 1.4;
    }


    /* =========================
       State Cards
    ========================== */

    .state-card {
        width: 100%;

        box-sizing: border-box;

        padding: 50px 20px;

        margin-bottom: 25px;

        text-align: center;

        background: #ffffff;

        border: 1px solid #e5e7eb;

        border-radius: 18px;
    }


    .state-icon {
        width: 60px;
        height: 60px;

        display: flex;

        align-items: center;
        justify-content: center;

        margin: 0 auto 16px;

        border-radius: 50%;

        background: #f1f5f9;

        color: #475569;

        font-size: 23px;
    }


    .state-card h3 {
        margin: 0 0 8px;

        color: #111827;

        font-size: 17px;

        font-weight: 700;

        line-height: 1.7;
    }


    .state-card p {
        margin: 0;

        color: #64748b;

        font-size: 14px;

        line-height: 1.8;
    }


    .error-state .state-icon {
        background: #fef2f2;

        color: #dc2626;
    }


    /* =========================
       Table
    ========================== */

    .table-card {
        width: 100%;

        box-sizing: border-box;

        overflow: hidden;

        background: #ffffff;

        border: 1px solid #e5e7eb;

        border-radius: 18px;
    }


    .table-wrapper {
        width: 100%;

        overflow-x: auto;

        -webkit-overflow-scrolling: touch;
    }


    .appointments-table {
        width: 100%;

        min-width: 650px;

        margin: 0;

        border-collapse: collapse;

        border-spacing: 0;

        table-layout: fixed;

        direction: rtl;

        text-align: right;
    }


    /* Prevent global CSS conflicts */

    .appointments-table thead {
        display: table-header-group;
    }


    .appointments-table tbody {
        display: table-row-group;
    }


    .appointments-table tr {
        display: table-row;
    }


    .appointments-table th,
    .appointments-table td {
        display: table-cell;
    }


    /* =========================
       Table Header
    ========================== */

    .appointments-table th {
        padding: 17px 22px;

        background: #f8fafc;

        color: #475569;

        font-size: 13px;

        font-weight: 700;

        line-height: 1.7;

        text-align: right;

        vertical-align: middle;

        white-space: nowrap;

        border-bottom: 1px solid #e5e7eb;
    }


    /* =========================
       Table Cells
    ========================== */

    .appointments-table td {
        padding: 18px 22px;

        background: #ffffff;

        color: #111827;

        font-size: 14px;

        font-weight: 400;

        line-height: 1.7;

        text-align: right;

        vertical-align: middle;

        border-bottom: 1px solid #f1f5f9;
    }


    .appointments-table tbody tr {
        transition: background 0.15s ease;
    }


    .appointments-table tbody tr:hover {
        background: #f8fafc;
    }


    .appointments-table tbody tr:hover td {
        background: #f8fafc;
    }


    .appointments-table tbody tr:last-child td {
        border-bottom: none;
    }


    /* =========================
       Columns
    ========================== */

    .appointments-table th:nth-child(1),
    .appointments-table td:nth-child(1) {
        width: 20%;
    }


    .appointments-table th:nth-child(2),
    .appointments-table td:nth-child(2) {
        width: 35%;
    }


    .appointments-table th:nth-child(3),
    .appointments-table td:nth-child(3) {
        width: 25%;
    }


    .appointments-table th:nth-child(4),
    .appointments-table td:nth-child(4) {
        width: 20%;
    }


    /* =========================
       Day
    ========================== */

    .day-cell {
        color: #111827;

        font-weight: 700;

        white-space: nowrap;
    }


    /* =========================
       Date
    ========================== */

    .date-cell {
        color: #64748b;

        direction: rtl;

        white-space: nowrap;

        font-variant-numeric: tabular-nums;
    }


    /* =========================
       Time
    ========================== */

    .time-cell {
        display: inline-flex;

        align-items: center;

        gap: 9px;

        direction: rtl;

        color: #111827;

        font-weight: 700;

        white-space: nowrap;

        font-variant-numeric: tabular-nums;
    }


    .time-cell i {
        color: #64748b;

        font-size: 14px;
    }


    /* =========================
       Available Status
    ========================== */

    .available-badge {
        display: inline-flex;

        align-items: center;
        justify-content: center;

        gap: 7px;

        padding: 7px 12px;

        border-radius: 999px;

        background: #ecfdf5;

        color: #059669;

        font-size: 12px;

        font-weight: 700;

        line-height: 1.5;

        white-space: nowrap;
    }


    .available-badge i {
        color: #10b981;

        font-size: 8px;
    }


    /* =========================
       Responsive
    ========================== */

    @media (max-width: 768px) {

        .appointments-page {
            padding: 20px;
        }


        .page-header {
            align-items: flex-start;

            flex-direction: column;
        }


        .page-header-content {
            width: 100%;
        }


        .create-slot-btn {
            width: 100%;
        }


        .stats-grid {
            grid-template-columns: 1fr;
        }


        .appointments-table {
            min-width: 700px;
        }


        .appointments-table th,
        .appointments-table td {
            padding: 15px 18px;
        }

    }


    @media (max-width: 480px) {

        .appointments-page {
            padding: 15px;
        }


        .page-header-content {
            align-items: flex-start;

            gap: 12px;
        }


        .page-header-icon {
            width: 48px;
            height: 48px;

            font-size: 20px;

            border-radius: 13px;
        }


        .page-header h1 {
            font-size: 23px;
        }


        .page-header p {
            font-size: 13px;
        }


        .stat-card {
            padding: 16px;
        }


        .stat-icon {
            width: 44px;
            height: 44px;

            font-size: 18px;
        }


        .stat-content strong {
            font-size: 22px;
        }

    }

</style>


<script>

    interface AppointmentSlot {
        id: number;
        time: string;
        status: "available" | "booked";
    }


    interface AppointmentDay {
        id: number;
        date: string;
        day_name: string;
        slots?: AppointmentSlot[];
    }


    interface AppointmentResponse {
        results?: AppointmentDay[];
    }


    const API_URL =
        "http://localhost:8000/api/v1/booking/appointments/today/";


    const loading =
        document.getElementById(
            "loading"
        );


    const error =
        document.getElementById(
            "error"
        );


    const empty =
        document.getElementById(
            "empty"
        );


    const tableContainer =
        document.getElementById(
            "table-container"
        );


    const appointmentsBody =
        document.getElementById(
            "appointments-body"
        );


    const totalSlots =
        document.getElementById(
            "total-slots"
        );


    const availableSlots =
        document.getElementById(
            "available-slots"
        );


    /* =========================
       Persian Digits
    ========================== */

    const toPersianDigits = (
        value: string | number
    ) => {

        return String(value).replace(
            /\d/g,
            (digit) =>
                "۰۱۲۳۴۵۶۷۸۹"[
                    Number(digit)
                ]
        );

    };


    /* =========================
       Format Time
    ========================== */

    const formatTime = (
        time: string
    ) => {

        /*
         * 05:44:49.851000
         *
         * ↓
         *
         * ۰۵:۴۴
         */

        const cleanTime =
            time.slice(0, 5);


        return toPersianDigits(
            cleanTime
        );

    };


    /* =========================
       Format Persian Date
    ========================== */

    const formatDate = (
        date: string
    ) => {

        /*
         * 2026-09-19
         *
         * ↓
         *
         * ۲۸/۰۶/۱۴۰۵
         */

        const parsedDate =
            new Date(
                `${date}T00:00:00`
            );


        const formatter =
            new Intl.DateTimeFormat(
                "fa-IR-u-ca-persian",
                {
                    year: "numeric",
                    month: "2-digit",
                    day: "2-digit",
                }
            );


        const parts =
            formatter.formatToParts(
                parsedDate
            );


        const day =
            parts.find(
                (part) =>
                    part.type === "day"
            )?.value ?? "";


        const month =
            parts.find(
                (part) =>
                    part.type === "month"
            )?.value ?? "";


        const year =
            parts.find(
                (part) =>
                    part.type === "year"
            )?.value ?? "";


        /*
         * همیشه:
         *
         * روز / ماه / سال
         */

        return `${day}/${month}/${year}`;

    };


    /* =========================
       Render Table
    ========================== */

    const renderTable = (
        days: AppointmentDay[]
    ) => {

        if (!appointmentsBody) {
            return false;
        }


        appointmentsBody.innerHTML =
            "";


        let hasAvailableSlots =
            false;


        days.forEach((day) => {

            const slots =
                (day.slots ?? []).filter(
                    (slot) =>
                        slot.status ===
                        "available"
                );


            slots.forEach((slot) => {

                hasAvailableSlots =
                    true;


                const row =
                    document.createElement(
                        "tr"
                    );


                row.innerHTML = `
                    <td class="day-cell">
                        ${day.day_name}
                    </td>

                    <td class="date-cell">
                        ${formatDate(day.date)}
                    </td>

                    <td>
                        <span class="time-cell">
                            <i class="fa-regular fa-clock"></i>
                            ${formatTime(slot.time)}
                        </span>
                    </td>

                    <td>
                        <span class="available-badge">
                            <i class="fa-solid fa-circle"></i>
                            آزاد
                        </span>
                    </td>
                `;


                appointmentsBody.appendChild(
                    row
                );

            });

        });


        return hasAvailableSlots;

    };


    /* =========================
       Load Appointments
    ========================== */

    const loadAppointments =
        async () => {

            try {

                if (loading) {
                    loading.hidden =
                        false;
                }


                if (error) {
                    error.hidden =
                        true;
                }


                if (empty) {
                    empty.hidden =
                        true;
                }


                if (tableContainer) {
                    tableContainer.hidden =
                        true;
                }


                /* Request */

                const response =
                    await fetch(
                        API_URL,
                        {
                            method: "GET",

                            credentials:
                                "include",

                            headers: {
                                Accept:
                                    "application/json",
                            },
                        }
                    );


                if (!response.ok) {
                    throw new Error(
                        "Failed to fetch appointments"
                    );
                }


                /* Response */

                const data:
                    AppointmentResponse =
                        await response.json();


                console.log(
                    "APPOINTMENTS:",
                    data
                );


                const days =
                    data.results ?? [];


                /* Count */

                let availableCount =
                    0;


                days.forEach((day) => {

                    (
                        day.slots ?? []
                    ).forEach((slot) => {

                        if (
                            slot.status ===
                            "available"
                        ) {

                            availableCount++;

                        }

                    });

                });


                /* Persian Count */

                const formattedCount =
                    toPersianDigits(
                        availableCount
                    );


                if (totalSlots) {
                    totalSlots.textContent =
                        formattedCount;
                }


                if (availableSlots) {
                    availableSlots.textContent =
                        formattedCount;
                }


                /* Hide Loading */

                if (loading) {
                    loading.hidden =
                        true;
                }


                /* Render Table */

                const hasAvailableSlots =
                    renderTable(days);


                /* Empty */

                if (!hasAvailableSlots) {

                    if (empty) {
                        empty.hidden =
                            false;
                    }

                    return;
                }


                /* Show Table */

                if (tableContainer) {
                    tableContainer.hidden =
                        false;
                }

            } catch (err) {

                console.error(
                    "APPOINTMENTS ERROR:",
                    err
                );


                if (loading) {
                    loading.hidden =
                        true;
                }


                if (error) {
                    error.hidden =
                        false;
                }

            }

        };


    /* =========================
       Init
    ========================== */

    loadAppointments();

</script>