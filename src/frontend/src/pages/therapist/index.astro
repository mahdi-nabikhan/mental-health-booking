---
import TherapistLayout from '@layouts/TherapistLayout.astro';
import { API_BASE_URL } from '../../config/api';
---

<TherapistLayout title="داشبورد درمانگر">
    <div class="dashboard-container">

        <!-- Welcome -->
        <section class="welcome-section">
            <div>
                <h1>خوش آمدید 👋</h1>
                <p>
                    از اینجا می‌توانید وضعیت نوبت‌ها و اسلات‌های خود را مدیریت کنید.
                </p>
            </div>
        </section>


        <!-- Statistics -->
        <section class="statistics-section">

            <div class="stat-card">
                <div class="stat-content">
                    <span class="stat-label">نوبت‌های امروز</span>
                    <strong id="todayAppointmentsCount">-</strong>
                </div>
            </div>

            <div class="stat-card">
                <div class="stat-content">
                    <span class="stat-label">اسلات‌های آزاد</span>
                    <strong id="availableSlotsCount">-</strong>
                </div>
            </div>

            <div class="stat-card">
                <div class="stat-content">
                    <span class="stat-label">مراجعین امروز</span>
                    <strong id="todayPatientsCount">-</strong>
                </div>
            </div>

        </section>


        <!-- Today's Appointments -->
        <section class="dashboard-section">

            <div class="section-header">
                <div>
                    <h2>نوبت‌های امروز</h2>
                    <p>لیست مراجع و نوبت‌های رزروشده امروز</p>
                </div>

                <a href="/therapist/appointments" class="section-link">
                    مشاهده همه
                </a>
            </div>


            <div id="todayAppointmentsLoading" class="state-message">
                در حال دریافت نوبت‌های امروز...
            </div>

            <div id="todayAppointmentsError" class="state-message error-message hidden">
                دریافت نوبت‌های امروز انجام نشد.
            </div>

            <div id="todayAppointmentsEmpty" class="state-message hidden">
                برای امروز نوبت رزروشده‌ای وجود ندارد.
            </div>


            <div id="todayAppointmentsTableWrapper" class="table-wrapper hidden">

                <table class="dashboard-table">

                    <thead>
                        <tr>
                            <th>مراجع</th>
                            <th>تاریخ</th>
                            <th>زمان</th>
                            <th>وضعیت</th>
                        </tr>
                    </thead>

                    <tbody id="todayAppointmentsTableBody">
                    </tbody>

                </table>

            </div>

        </section>


        <!-- Available Slots -->
        <section class="dashboard-section">

            <div class="section-header">
                <div>
                    <h2>اسلات‌های آزاد</h2>
                    <p>زمان‌های آزاد برای رزرو نوبت</p>
                </div>

                <a href="/therapist/main-slot" class="section-link">
                    مشاهده همه
                </a>
            </div>


            <div id="availableSlotsLoading" class="state-message">
                در حال دریافت اسلات‌های آزاد...
            </div>

            <div id="availableSlotsError" class="state-message error-message hidden">
                دریافت اسلات‌های آزاد انجام نشد.
            </div>

            <div id="availableSlotsEmpty" class="state-message hidden">
                اسلات آزادی وجود ندارد.
            </div>


            <div id="availableSlotsTableWrapper" class="table-wrapper hidden">

                <table class="dashboard-table">

                    <thead>
                        <tr>
                            <th>تاریخ</th>
                            <th>زمان</th>
                            <th>وضعیت</th>
                        </tr>
                    </thead>

                    <tbody id="availableSlotsTableBody">
                    </tbody>

                </table>

            </div>

        </section>


        <!-- Quick Actions -->
        <section class="dashboard-section">

            <div class="section-header">
                <div>
                    <h2>دسترسی سریع</h2>
                    <p>عملیات پرکاربرد پنل درمانگر</p>
                </div>
            </div>


            <div class="quick-actions">

                <a href="/therapist/main-slot" class="quick-action-card">
                    <div class="quick-action-icon">
                        +
                    </div>

                    <div>
                        <h3>افزودن اسلات</h3>
                        <p>ایجاد زمان جدید برای رزرو نوبت</p>
                    </div>
                </a>


                <a href="/therapist/appointments" class="quick-action-card">
                    <div class="quick-action-icon">
                        📅
                    </div>

                    <div>
                        <h3>مشاهده نوبت‌ها</h3>
                        <p>مدیریت نوبت‌های رزروشده</p>
                    </div>
                </a>


                <a href="/therapist/patients" class="quick-action-card">
                    <div class="quick-action-icon">
                        👥
                    </div>

                    <div>
                        <h3>مراجعین</h3>
                        <p>مشاهده اطلاعات مراجعین</p>
                    </div>
                </a>

            </div>

        </section>

    </div>
</TherapistLayout>


<style>

    .dashboard-container {
        width: 100%;
        padding: 30px;
        direction: rtl;
    }


    /* =========================
       Welcome
    ========================= */

    .welcome-section {
        background: #ffffff;
        border-radius: 14px;
        padding: 28px;
        margin-bottom: 24px;
        border: 1px solid #e8e8e8;
    }

    .welcome-section h1 {
        margin: 0 0 8px;
        font-size: 26px;
        font-weight: 700;
    }

    .welcome-section p {
        margin: 0;
        color: #777;
        font-size: 14px;
    }


    /* =========================
       Statistics
    ========================= */

    .statistics-section {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
        margin-bottom: 24px;
    }

    .stat-card {
        background: #ffffff;
        border: 1px solid #e8e8e8;
        border-radius: 14px;
        padding: 24px;
    }

    .stat-content {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .stat-label {
        color: #777;
        font-size: 14px;
    }

    .stat-card strong {
        font-size: 30px;
        font-weight: 700;
    }


    /* =========================
       Sections
    ========================= */

    .dashboard-section {
        background: #ffffff;
        border: 1px solid #e8e8e8;
        border-radius: 14px;
        padding: 24px;
        margin-bottom: 24px;
    }

    .section-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 20px;
    }

    .section-header h2 {
        margin: 0 0 7px;
        font-size: 20px;
        font-weight: 700;
    }

    .section-header p {
        margin: 0;
        color: #777;
        font-size: 14px;
    }

    .section-link {
        color: #333;
        text-decoration: none;
        font-size: 14px;
        font-weight: 600;
        white-space: nowrap;
    }

    .section-link:hover {
        text-decoration: underline;
    }


    /* =========================
       States
    ========================= */

    .state-message {
        padding: 30px;
        text-align: center;
        color: #777;
        font-size: 14px;
    }

    .error-message {
        color: #c62828;
    }

    .hidden {
        display: none !important;
    }


    /* =========================
       Tables
    ========================= */

    .table-wrapper {
        width: 100%;
        overflow-x: auto;
    }

    .dashboard-table {
        width: 100%;
        border-collapse: collapse;
    }

    .dashboard-table th,
    .dashboard-table td {
        padding: 15px 14px;
        text-align: right;
        border-bottom: 1px solid #eeeeee;
        font-size: 14px;
    }

    .dashboard-table th {
        background: #fafafa;
        color: #555;
        font-weight: 600;
    }

    .dashboard-table td {
        color: #333;
    }

    .dashboard-table tbody tr:last-child td {
        border-bottom: none;
    }


    /* =========================
       Status
    ========================= */

    .status-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 5px 12px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
        background: #e8f5e9;
        color: #2e7d32;
    }


    /* =========================
       Quick Actions
    ========================= */

    .quick-actions {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 18px;
    }

    .quick-action-card {
        display: flex;
        align-items: center;
        gap: 15px;
        padding: 20px;
        border: 1px solid #e8e8e8;
        border-radius: 12px;
        text-decoration: none;
        color: inherit;
        transition: 0.2s ease;
    }

    .quick-action-card:hover {
        border-color: #cfcfcf;
        transform: translateY(-2px);
    }

    .quick-action-icon {
        width: 45px;
        height: 45px;
        min-width: 45px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        background: #f5f5f5;
        font-size: 20px;
    }

    .quick-action-card h3 {
        margin: 0 0 5px;
        font-size: 15px;
        font-weight: 700;
    }

    .quick-action-card p {
        margin: 0;
        color: #777;
        font-size: 12px;
        line-height: 1.7;
    }


    /* =========================
       Responsive
    ========================= */

    @media (max-width: 900px) {

        .statistics-section {
            grid-template-columns: 1fr;
        }

        .quick-actions {
            grid-template-columns: 1fr;
        }

    }


    @media (max-width: 600px) {

        .dashboard-container {
            padding: 15px;
        }

        .dashboard-section {
            padding: 16px;
        }

        .welcome-section {
            padding: 20px;
        }

        .section-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .dashboard-table th,
        .dashboard-table td {
            padding: 12px 8px;
            font-size: 12px;
        }

    }

</style>


<script define:vars={{ API_BASE_URL }}>

    interface Patient {
        id?: number;
        first_name?: string;
        last_name?: string;
        phone_number?: string;
    }


    interface AppointmentSlot {
        id?: number;
        date?: string;
        time?: string;
        created_at?: string;
        therapist?: unknown;
    }


    interface Appointment {
        id?: number;
        reason?: string;
        status?: string;
        created_at?: string;
        updated_at?: string;
        slot?: AppointmentSlot;
        patient?: Patient;
    }


    interface AppointmentResponse {
        count?: number;
        results?: Appointment[];
    }


    interface AvailableSlot {
        id?: number;
        time?: string;
        status?: string;
    }


    interface AvailableDay {
        id?: number;
        date?: string;
        day_name?: string;
        slots?: AvailableSlot[];
    }


    interface AvailableSlotWithDate extends AvailableSlot {
        date?: string;
    }


    interface AvailableSlotResponse {
        count?: number;
        results?: AvailableDay[];
    }


    /*
     * =========================
     * Helpers
     * =========================
     */

    function formatPersianDate(dateString: unknown) {

        if (
            !dateString ||
            typeof dateString !== "string"
        ) {
            return "-";
        }

        const date = new Date(
            `${dateString}T00:00:00`
        );

        if (Number.isNaN(date.getTime())) {
            return dateString;
        }

        try {

            const parts = new Intl.DateTimeFormat(
                "fa-IR-u-ca-persian",
                {
                    day: "2-digit",
                    month: "2-digit",
                    year: "numeric",
                }
            ).formatToParts(date);

            const day =
                parts.find(
                    (part) => part.type === "day"
                )?.value ?? "";

            const month =
                parts.find(
                    (part) => part.type === "month"
                )?.value ?? "";

            const year =
                parts.find(
                    (part) => part.type === "year"
                )?.value ?? "";

            if (!day || !month || !year) {
                return dateString;
            }

            return `${day}/${month}/${year}`;

        } catch {
            return dateString;
        }
    }


    function formatTime(timeString: unknown) {

        if (
            !timeString ||
            typeof timeString !== "string"
        ) {
            return "-";
        }

        return timeString.slice(0, 5);
    }


    function getPatientName(patient?: Patient) {

        if (!patient) {
            return "-";
        }

        const firstName =
            patient.first_name ?? "";

        const lastName =
            patient.last_name ?? "";

        const fullName =
            `${firstName} ${lastName}`.trim();

        return fullName || "-";
    }


    function showElement(id: string) {

        document
            .getElementById(id)
            ?.classList.remove("hidden");
    }


    function hideElement(id: string) {

        document
            .getElementById(id)
            ?.classList.add("hidden");
    }


    /*
     * =========================
     * Today's Appointments
     * =========================
     *
     * Actual API:
     *
     * /api/v1/booking/appointment-slots/
     *
     * Response:
     *
     * results: [
     *   {
     *      patient: {...},
     *      slot: {...},
     *      status: "scheduled"
     *   }
     * ]
     */

    async function loadTodayAppointments() {

        const loading =
            document.getElementById(
                "todayAppointmentsLoading"
            );

        const error =
            document.getElementById(
                "todayAppointmentsError"
            );

        const empty =
            document.getElementById(
                "todayAppointmentsEmpty"
            );

        const tableWrapper =
            document.getElementById(
                "todayAppointmentsTableWrapper"
            );

        const body =
            document.getElementById(
                "todayAppointmentsTableBody"
            );

        try {

            const response = await fetch(
                `${API_BASE_URL}/booking/appointment-slots/`,
                {
                    method: "GET",
                    credentials: "include",
                }
            );


            if (!response.ok) {
                throw new Error(
                    `HTTP ${response.status}`
                );
            }


            const data =
                await response.json() as AppointmentResponse;


            console.log(
                "TODAY APPOINTMENTS:",
                data
            );


            const appointments =
                Array.isArray(data.results)
                    ? data.results
                    : [];


            hideElement(
                "todayAppointmentsLoading"
            );


            /*
             * Statistics
             */

            const appointmentsCount =
                document.getElementById(
                    "todayAppointmentsCount"
                );

            if (appointmentsCount) {
                appointmentsCount.textContent =
                    String(appointments.length);
            }


            /*
             * Unique patients
             */

            const uniquePatients =
                new Set(
                    appointments
                        .map(
                            (appointment) =>
                                appointment.patient?.id
                        )
                        .filter(
                            (id) =>
                                id !== undefined &&
                                id !== null
                        )
                );


            const patientsCount =
                document.getElementById(
                    "todayPatientsCount"
                );

            if (patientsCount) {
                patientsCount.textContent =
                    String(uniquePatients.size);
            }


            /*
             * Empty state
             */

            if (appointments.length === 0) {

                showElement(
                    "todayAppointmentsEmpty"
                );

                return;
            }


            /*
             * Table
             */

            if (body) {

                body.innerHTML =
                    appointments
                        .map(
                            (appointment) => `
                                <tr>

                                    <td>
                                        ${getPatientName(
                                            appointment.patient
                                        )}
                                    </td>

                                    <td>
                                        ${formatPersianDate(
                                            appointment.slot?.date
                                        )}
                                    </td>

                                    <td>
                                        ${formatTime(
                                            appointment.slot?.time
                                        )}
                                    </td>

                                    <td>
                                        <span class="status-badge">
                                            ${
                                                appointment.status ===
                                                "scheduled"
                                                    ? "رزرو شده"
                                                    : (
                                                        appointment.status ??
                                                        "-"
                                                    )
                                            }
                                        </span>
                                    </td>

                                </tr>
                            `
                        )
                        .join("");
            }


            showElement(
                "todayAppointmentsTableWrapper"
            );

        } catch (err) {

            console.error(
                "Failed to load today's appointments:",
                err
            );


            hideElement(
                "todayAppointmentsLoading"
            );

            showElement(
                "todayAppointmentsError"
            );

        }
    }


    /*
     * =========================
     * Available Slots
     * =========================
     *
     * Actual API:
     *
     * /api/v1/booking/appointments/today/
     *
     * Response:
     *
     * results: [
     *   {
     *      date: "2026-09-19",
     *      slots: [
     *          {
     *              id: 5,
     *              time: "...",
     *              status: "available"
     *          }
     *      ]
     *   }
     * ]
     */

    async function loadAvailableSlots() {

        try {

            const response = await fetch(
                `${API_BASE_URL}/booking/appointments/today/`,
                {
                    method: "GET",
                    credentials: "include",
                }
            );


            if (!response.ok) {
                throw new Error(
                    `HTTP ${response.status}`
                );
            }


            const data =
                await response.json() as AvailableSlotResponse;


            console.log(
                "AVAILABLE SLOTS:",
                data
            );


            const days =
                Array.isArray(data.results)
                    ? data.results
                    : [];


            /*
             * Convert:
             *
             * [
             *   {
             *      date,
             *      slots: [...]
             *   }
             * ]
             *
             * to:
             *
             * [
             *   {
             *      date,
             *      id,
             *      time,
             *      status
             *   }
             * ]
             */

            const slots: AvailableSlotWithDate[] =
                days.flatMap(
                    (day) =>
                        (Array.isArray(day.slots)
                            ? day.slots
                            : []
                        ).map(
                            (slot) => ({
                                ...slot,
                                date: day.date,
                            })
                        )
                );


            hideElement(
                "availableSlotsLoading"
            );


            /*
             * Statistics
             */

            const slotsCount =
                document.getElementById(
                    "availableSlotsCount"
                );

            if (slotsCount) {
                slotsCount.textContent =
                    String(slots.length);
            }


            /*
             * Empty
             */

            if (slots.length === 0) {

                showElement(
                    "availableSlotsEmpty"
                );

                return;
            }


            /*
             * Table
             */

            const body =
                document.getElementById(
                    "availableSlotsTableBody"
                );


            if (body) {

                body.innerHTML =
                    slots
                        .map(
                            (slot) => `
                                <tr>

                                    <td>
                                        ${formatPersianDate(
                                            slot.date
                                        )}
                                    </td>

                                    <td>
                                        ${formatTime(
                                            slot.time
                                        )}
                                    </td>

                                    <td>
                                        <span class="status-badge">
                                            ${
                                                slot.status ===
                                                "available"
                                                    ? "آزاد"
                                                    : (
                                                        slot.status ??
                                                        "-"
                                                    )
                                            }
                                        </span>
                                    </td>

                                </tr>
                            `
                        )
                        .join("");
            }


            showElement(
                "availableSlotsTableWrapper"
            );

        } catch (err) {

            console.error(
                "Failed to load available slots:",
                err
            );


            hideElement(
                "availableSlotsLoading"
            );

            showElement(
                "availableSlotsError"
            );

        }

    }


    /*
     * =========================
     * Initialize Dashboard
     * =========================
     */

    document.addEventListener(
        "DOMContentLoaded",
        () => {

            loadTodayAppointments();

            loadAvailableSlots();

        }
    );

</script>