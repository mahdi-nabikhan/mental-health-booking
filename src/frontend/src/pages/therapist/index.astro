---
import TherapistLayout from "../../layouts/TherapistLayout.astro";
import StatCard from "../../components/Dashboard/StatCard.astro";
import AppointmentTable from "../../components/Dashboard/AppointmentTable.astro";
---

<TherapistLayout title="داشبورد روان‌درمانگر">
    <div class="dashboard">
        <div class="welcome-section">
            <div>
                <h2>خوش آمدید، روان‌درمانگر</h2>
                <p>
                    در اینجا می‌توانید وضعیت فعالیت‌های امروز خود را مشاهده کنید.
                </p>
            </div>

            <a href="/therapist/slots" class="create-slot-button">
                <i class="fa-solid fa-plus"></i>
                ایجاد زمان آزاد
            </a>
        </div>

        <section class="stats-grid">
            <StatCard
                title="مجموع بیماران"
                value="24"
                description="بیماران فعال"
                icon="fa-solid fa-users"
            />

            <StatCard
                title="جلسات امروز"
                value="3"
                description="نوبت‌های امروز"
                icon="fa-solid fa-calendar-day"
            />

            <StatCard
                title="نوبت‌های پیش‌رو"
                value="8"
                description="نوبت‌های برنامه‌ریزی‌شده"
                icon="fa-solid fa-calendar-check"
            />

            <StatCard
                title="زمان‌های آزاد"
                value="12"
                description="زمان‌های قابل رزرو"
                icon="fa-solid fa-clock"
            />
        </section>

        <section class="dashboard-section">
            <AppointmentTable />
        </section>

        <section class="quick-actions">
            <h2>دسترسی سریع</h2>

            <div class="actions-grid">
                <a href="/therapist/slots" class="action-card">
                    <div class="action-icon">
                        <i class="fa-solid fa-calendar-plus"></i>
                    </div>

                    <div>
                        <strong>ایجاد زمان آزاد</strong>
                        <span>افزودن زمان جدید برای رزرو نوبت</span>
                    </div>

                    <i class="fa-solid fa-chevron-right arrow"></i>
                </a>

                <a href="/therapist/patients" class="action-card">
                    <div class="action-icon">
                        <i class="fa-solid fa-user-plus"></i>
                    </div>

                    <div>
                        <strong>مشاهده بیماران</strong>
                        <span>بیماران خود را مدیریت کنید</span>
                    </div>

                    <i class="fa-solid fa-chevron-right arrow"></i>
                </a>

                <a href="/therapist/appointments" class="action-card">
                    <div class="action-icon">
                        <i class="fa-solid fa-calendar-check"></i>
                    </div>

                    <div>
                        <strong>نوبت‌ها</strong>
                        <span>برنامه نوبت‌های خود را مشاهده کنید</span>
                    </div>

                    <i class="fa-solid fa-chevron-right arrow"></i>
                </a>
            </div>
        </section>
    </div>
</TherapistLayout>

<style>
    .dashboard {
        width: 100%;
    }

    .welcome-section {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
        margin-bottom: 32px;
        padding: 28px 32px;
        background: #fff;
        border-radius: 16px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.06);
    }

    .welcome-section h2 {
        margin: 0 0 8px;
        font-size: 1.6rem;
        font-weight: 700;
        color: #222;
    }

    .welcome-section p {
        margin: 0;
        color: #777;
        font-size: 0.95rem;
    }

    .create-slot-button {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 12px 20px;
        border-radius: 10px;
        background: #222;
        color: #fff;
        text-decoration: none;
        font-size: 0.9rem;
        font-weight: 600;
        white-space: nowrap;
        transition: 0.2s ease;
    }

    .create-slot-button:hover {
        opacity: 0.88;
        color: #fff;
    }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 20px;
        margin-bottom: 32px;
    }

    .dashboard-section {
        margin-bottom: 32px;
        padding: 24px;
        background: #fff;
        border-radius: 16px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.06);
        overflow-x: auto;
    }

    .quick-actions {
        margin-bottom: 32px;
    }

    .quick-actions h2 {
        margin: 0 0 18px;
        font-size: 1.3rem;
        font-weight: 700;
        color: #222;
    }

    .actions-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 18px;
    }

    .action-card {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 20px;
        background: #fff;
        border-radius: 14px;
        color: #222;
        text-decoration: none;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .action-card:hover {
        color: #222;
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.08);
    }

    .action-icon {
        width: 46px;
        height: 46px;
        min-width: 46px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        background: #f3f3f3;
        font-size: 18px;
    }

    .action-card > div:nth-child(2) {
        display: flex;
        flex-direction: column;
        gap: 5px;
        flex: 1;
    }

    .action-card strong {
        font-size: 0.95rem;
        font-weight: 700;
    }

    .action-card span {
        color: #777;
        font-size: 0.8rem;
        line-height: 1.5;
    }

    .action-card .arrow {
        color: #999;
        font-size: 13px;
    }

    @media (max-width: 992px) {
        .stats-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .actions-grid {
            grid-template-columns: 1fr;
        }
    }

    @media (max-width: 768px) {
        .welcome-section {
            flex-direction: column;
            align-items: flex-start;
            padding: 24px;
        }

        .create-slot-button {
            width: 100%;
            justify-content: center;
        }

        .dashboard-section {
            padding: 18px;
        }
    }

    @media (max-width: 576px) {
        .stats-grid {
            grid-template-columns: 1fr;
        }

        .welcome-section h2 {
            font-size: 1.35rem;
        }

        .action-card {
            padding: 16px;
        }
    }
</style>