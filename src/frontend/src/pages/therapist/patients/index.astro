---
import TherapistLayout from '@layouts/TherapistLayout.astro';
---

<TherapistLayout title="مراجعین">
    <div class="patients-container">

        <!-- Header -->
        <section class="page-header">
            <div>
                <h1>مراجعین</h1>
                <p>لیست مراجعین شما و اطلاعات آن‌ها</p>
            </div>
        </section>

        <!-- Loading -->
        <div id="patientsLoading" class="state-message">
            در حال دریافت لیست مراجعین...
        </div>

        <!-- Error -->
        <div id="patientsError" class="state-message error-message hidden">
            دریافت لیست مراجعین انجام نشد.
        </div>

        <!-- Empty -->
        <div id="patientsEmpty" class="state-message hidden">
            در حال حاضر مراجعی برای نمایش وجود ندارد.
        </div>

        <!-- Patients Table -->
        <section id="patientsTableWrapper" class="table-wrapper hidden">
            <table class="patients-table">
                <thead>
                    <tr>
                        <th>نام و نام خانوادگی</th>
                        <th>شماره تماس</th>
                        <th>ایمیل</th>
                        <th>عملیات</th>
                    </tr>
                </thead>

                <tbody id="patientsTableBody"></tbody>
            </table>
        </section>
    </div>

    <!-- Patient Details Modal -->
    <div id="patientModal" class="modal hidden">
        <div class="modal-overlay"></div>

        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <h2>جزئیات مراجع</h2>
                    <p>اطلاعات ثبت‌شده مراجع</p>
                </div>

                <button
                    type="button"
                    id="closePatientModal"
                    class="modal-close"
                    aria-label="بستن"
                >
                    ×
                </button>
            </div>

            <!-- Modal Loading -->
            <div id="patientDetailsLoading" class="modal-state">
                در حال دریافت اطلاعات مراجع...
            </div>

            <!-- Modal Error -->
            <div
                id="patientDetailsError"
                class="modal-state error-message hidden"
            >
                دریافت اطلاعات مراجع انجام نشد.
            </div>

            <!-- Modal Details -->
            <div id="patientDetailsContent" class="patient-details hidden">

                <div class="detail-item">
                    <span class="detail-label">شناسه مراجع</span>
                    <strong id="detailPatientId">-</strong>
                </div>

                <div class="detail-item">
                    <span class="detail-label">نام</span>
                    <strong id="detailFirstName">-</strong>
                </div>

                <div class="detail-item">
                    <span class="detail-label">نام خانوادگی</span>
                    <strong id="detailLastName">-</strong>
                </div>

                <div class="detail-item">
                    <span class="detail-label">شماره تماس</span>
                    <strong id="detailPhone">-</strong>
                </div>

                <div class="detail-item">
                    <span class="detail-label">ایمیل</span>
                    <strong id="detailEmail">-</strong>
                </div>

                <div class="detail-item">
                    <span class="detail-label">شناسه کاربر</span>
                    <strong id="detailUserId">-</strong>
                </div>

            </div>

            <div class="modal-footer">
                <button
                    type="button"
                    id="closePatientModalFooter"
                    class="close-button"
                >
                    بستن
                </button>
            </div>
        </div>
    </div>
</TherapistLayout>

<style>
    .patients-container {
        width: 100%;
        padding: 30px;
        direction: rtl;
    }

    .page-header {
        margin-bottom: 30px;
    }

    .page-header h1 {
        margin: 0 0 8px;
        font-size: 28px;
        font-weight: 700;
    }

    .page-header p {
        margin: 0;
        color: #6b7280;
        font-size: 15px;
    }

    .table-wrapper {
        width: 100%;
        overflow-x: auto;
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
    }

    .patients-table {
        width: 100%;
        border-collapse: collapse;
        direction: rtl;
    }

    .patients-table th,
    .patients-table td {
        padding: 16px;
        text-align: right;
        border-bottom: 1px solid #e5e7eb;
        white-space: nowrap;
    }

    .patients-table th {
        background: #f9fafb;
        color: #374151;
        font-size: 14px;
        font-weight: 600;
    }

    .patients-table td {
        color: #4b5563;
        font-size: 14px;
    }

    .patients-table tbody tr:last-child td {
        border-bottom: none;
    }

    .patients-table tbody tr:hover {
        background: #f9fafb;
    }

    .details-button {
        border: none;
        border-radius: 8px;
        padding: 8px 14px;
        background: #111827;
        color: #ffffff;
        font-size: 13px;
        cursor: pointer;
        transition: opacity 0.2s ease;
    }

    .details-button:hover {
        opacity: 0.85;
    }

    .state-message {
        width: 100%;
        padding: 40px 20px;
        text-align: center;
        color: #6b7280;
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
    }

    .error-message {
        color: #dc2626;
    }

    .hidden {
        display: none !important;
    }

    /* Modal */

    .modal {
        position: fixed;
        inset: 0;
        z-index: 1000;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 20px;
    }

    .modal-overlay {
        position: absolute;
        inset: 0;
        background: rgba(0, 0, 0, 0.5);
    }

    .modal-content {
        position: relative;
        z-index: 1;
        width: 100%;
        max-width: 600px;
        max-height: 90vh;
        overflow-y: auto;
        background: #ffffff;
        border-radius: 16px;
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.2);
    }

    .modal-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 20px;
        padding: 24px;
        border-bottom: 1px solid #e5e7eb;
    }

    .modal-header h2 {
        margin: 0 0 6px;
        font-size: 21px;
        color: #111827;
    }

    .modal-header p {
        margin: 0;
        color: #6b7280;
        font-size: 14px;
    }

    .modal-close {
        width: 36px;
        height: 36px;
        border: none;
        border-radius: 8px;
        background: #f3f4f6;
        color: #374151;
        font-size: 24px;
        line-height: 1;
        cursor: pointer;
    }

    .modal-close:hover {
        background: #e5e7eb;
    }

    .modal-state {
        padding: 35px 24px;
        text-align: center;
        color: #6b7280;
    }

    .patient-details {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 16px;
        padding: 24px;
    }

    .detail-item {
        padding: 16px;
        background: #f9fafb;
        border: 1px solid #e5e7eb;
        border-radius: 10px;
    }

    .detail-label {
        display: block;
        margin-bottom: 8px;
        color: #6b7280;
        font-size: 13px;
    }

    .detail-item strong {
        display: block;
        color: #111827;
        font-size: 15px;
        word-break: break-word;
    }

    .modal-footer {
        display: flex;
        justify-content: flex-start;
        padding: 20px 24px;
        border-top: 1px solid #e5e7eb;
    }

    .close-button {
        border: none;
        border-radius: 8px;
        padding: 10px 20px;
        background: #111827;
        color: #ffffff;
        cursor: pointer;
        font-size: 14px;
    }

    .close-button:hover {
        opacity: 0.85;
    }

    @media (max-width: 768px) {
        .patients-container {
            padding: 20px 15px;
        }

        .patient-details {
            grid-template-columns: 1fr;
        }

        .modal {
            padding: 10px;
        }

        .modal-content {
            max-height: 95vh;
        }
    }
</style>

<script>
    interface Patient {
        id?: number;
        first_name?: string;
        last_name?: string;
        phone_number?: string;
        user?: {
            email?: string;
            id?: number;
        };
    }

    const PATIENTS_URL =
        "http://localhost:8000/api/v1/accounts/patients/";

    const PATIENT_DETAIL_URL = (id: number) =>
        `http://localhost:8000/api/v1/accounts/therapist/patients/${id}/`;

    const patientsLoading =
        document.getElementById("patientsLoading") as HTMLDivElement;

    const patientsError =
        document.getElementById("patientsError") as HTMLDivElement;

    const patientsEmpty =
        document.getElementById("patientsEmpty") as HTMLDivElement;

    const patientsTableWrapper =
        document.getElementById("patientsTableWrapper") as HTMLElement;

    const patientsTableBody =
        document.getElementById("patientsTableBody") as HTMLTableSectionElement;

    const patientModal =
        document.getElementById("patientModal") as HTMLDivElement;

    const patientDetailsLoading =
        document.getElementById("patientDetailsLoading") as HTMLDivElement;

    const patientDetailsError =
        document.getElementById("patientDetailsError") as HTMLDivElement;

    const patientDetailsContent =
        document.getElementById("patientDetailsContent") as HTMLDivElement;

    const closePatientModal =
        document.getElementById("closePatientModal") as HTMLButtonElement;

    const closePatientModalFooter =
        document.getElementById(
            "closePatientModalFooter"
        ) as HTMLButtonElement;

    const modalOverlay =
        document.querySelector(".modal-overlay") as HTMLDivElement;

    const detailPatientId =
        document.getElementById("detailPatientId") as HTMLElement;

    const detailFirstName =
        document.getElementById("detailFirstName") as HTMLElement;

    const detailLastName =
        document.getElementById("detailLastName") as HTMLElement;

    const detailPhone =
        document.getElementById("detailPhone") as HTMLElement;

    const detailEmail =
        document.getElementById("detailEmail") as HTMLElement;

    const detailUserId =
        document.getElementById("detailUserId") as HTMLElement;


    function getPatientName(patient: Patient): string {
        const firstName = patient.first_name?.trim() || "";
        const lastName = patient.last_name?.trim() || "";

        const fullName = `${firstName} ${lastName}`.trim();

        return fullName || "بدون نام";
    }


    function showPatientDetailsLoading() {
        patientDetailsLoading.classList.remove("hidden");
        patientDetailsError.classList.add("hidden");
        patientDetailsContent.classList.add("hidden");
    }


    function showPatientDetailsError() {
        patientDetailsLoading.classList.add("hidden");
        patientDetailsError.classList.remove("hidden");
        patientDetailsContent.classList.add("hidden");
    }


    function showPatientDetailsContent() {
        patientDetailsLoading.classList.add("hidden");
        patientDetailsError.classList.add("hidden");
        patientDetailsContent.classList.remove("hidden");
    }


    function openPatientModal() {
        patientModal.classList.remove("hidden");
        document.body.style.overflow = "hidden";
    }


    function closeModal() {
        patientModal.classList.add("hidden");
        document.body.style.overflow = "";
    }


    function resetPatientDetails() {
        detailPatientId.textContent = "-";
        detailFirstName.textContent = "-";
        detailLastName.textContent = "-";
        detailPhone.textContent = "-";
        detailEmail.textContent = "-";
        detailUserId.textContent = "-";
    }


    async function loadPatientDetails(patientId: number) {
        openPatientModal();
        resetPatientDetails();
        showPatientDetailsLoading();

        try {
            const response = await fetch(
                PATIENT_DETAIL_URL(patientId),
                {
                    method: "GET",
                    credentials: "include",
                    headers: {
                        Accept: "application/json",
                    },
                }
            );

            if (!response.ok) {
                throw new Error(
                    `Failed to fetch patient details: ${response.status}`
                );
            }

            const patient: Patient = await response.json();

            detailPatientId.textContent =
                patient.id?.toString() || "-";

            detailFirstName.textContent =
                patient.first_name || "-";

            detailLastName.textContent =
                patient.last_name || "-";

            detailPhone.textContent =
                patient.phone_number || "-";

            detailEmail.textContent =
                patient.user?.email || "-";

            detailUserId.textContent =
                patient.user?.id?.toString() || "-";

            showPatientDetailsContent();

        } catch (error) {
            console.error(
                "Error loading patient details:",
                error
            );

            showPatientDetailsError();
        }
    }


    function renderPatients(patients: Patient[]) {
        patientsTableBody.innerHTML = "";

        patients.forEach((patient) => {
            const row = document.createElement("tr");

            row.innerHTML = `
                <td>
                    ${getPatientName(patient)}
                </td>

                <td>
                    ${patient.phone_number || "-"}
                </td>

                <td>
                    ${patient.user?.email || "-"}
                </td>

                <td>
                    <button
                        type="button"
                        class="details-button"
                        data-patient-id="${patient.id}"
                    >
                        جزئیات
                    </button>
                </td>
            `;

            patientsTableBody.appendChild(row);
        });
    }


    async function loadPatients() {
        patientsLoading.classList.remove("hidden");
        patientsError.classList.add("hidden");
        patientsEmpty.classList.add("hidden");
        patientsTableWrapper.classList.add("hidden");

        try {
            const response = await fetch(
                PATIENTS_URL,
                {
                    method: "GET",
                    credentials: "include",
                    headers: {
                        Accept: "application/json",
                    },
                }
            );

            if (!response.ok) {
                throw new Error(
                    `Failed to fetch patients: ${response.status}`
                );
            }

            const data: Patient[] = await response.json();

            patientsLoading.classList.add("hidden");

            if (!Array.isArray(data) || data.length === 0) {
                patientsEmpty.classList.remove("hidden");
                return;
            }

            renderPatients(data);

            patientsTableWrapper.classList.remove("hidden");

        } catch (error) {
            console.error(
                "Error loading patients:",
                error
            );

            patientsLoading.classList.add("hidden");
            patientsError.classList.remove("hidden");
        }
    }


    patientsTableBody.addEventListener(
        "click",
        (event) => {
            const target = event.target as HTMLElement;

            const button =
                target.closest(
                    ".details-button"
                ) as HTMLButtonElement | null;

            if (!button) {
                return;
            }

            const patientId =
                Number(button.dataset.patientId);

            if (!patientId) {
                return;
            }

            loadPatientDetails(patientId);
        }
    );


    closePatientModal.addEventListener(
        "click",
        closeModal
    );


    closePatientModalFooter.addEventListener(
        "click",
        closeModal
    );


    modalOverlay.addEventListener(
        "click",
        closeModal
    );


    document.addEventListener(
        "keydown",
        (event) => {
            if (
                event.key === "Escape" &&
                !patientModal.classList.contains("hidden")
            ) {
                closeModal();
            }
        }
    );


    document.addEventListener(
        "DOMContentLoaded",
        () => {
            loadPatients();
        }
    );
</script>