---
import TherapistLayout from "../../layouts/TherapistLayout.astro";
---

<TherapistLayout title="پروفایل من">
    <div class="profile-page">
        <!-- Page Header -->
        <section class="page-header">
            <div>
                <h2>پروفایل من</h2>
                <p>
                    اطلاعات شخصی خود را مشاهده و مدیریت کنید.
                </p>
            </div>
        </section>

        <!-- Loading -->
        <div id="profile-loading" class="profile-loading">
            <div class="loading-spinner"></div>
            <span>در حال دریافت اطلاعات...</span>
        </div>

        <!-- Error -->
        <div
            id="profile-error"
            class="profile-error d-none"
        >
            <i class="fa-solid fa-triangle-exclamation"></i>

            <div>
                <strong>خطا در دریافت اطلاعات</strong>

                <p id="profile-error-text">
                    دریافت اطلاعات پروفایل با مشکل مواجه شد.
                </p>
            </div>

            <button id="retry-profile" type="button">
                تلاش مجدد
            </button>
        </div>

        <!-- Profile Content -->
        <div id="profile-content" class="d-none">
            <div class="profile-grid">
                <!-- Profile Summary -->
                <section class="profile-card profile-summary">
                    <div class="avatar-large">
                        <i class="fa-solid fa-user-doctor"></i>
                    </div>

                    <h3 id="profile-full-name">
                        -
                    </h3>

                    <p>تراپیست</p>

                    <div class="summary-divider"></div>

                    <div class="summary-item">
                        <i class="fa-solid fa-envelope"></i>

                        <div>
                            <span>ایمیل</span>

                            <strong id="profile-email">
                                -
                            </strong>
                        </div>
                    </div>

                    <div class="summary-item">
                        <i class="fa-solid fa-phone"></i>

                        <div>
                            <span>شماره تلفن</span>

                            <strong id="profile-phone">
                                -
                            </strong>
                        </div>
                    </div>
                </section>

                <!-- Personal Information -->
                <section class="profile-card">
                    <div class="card-header">
                        <div>
                            <h3>اطلاعات شخصی</h3>

                            <p>
                                اطلاعات شخصی خود را مشاهده کنید.
                            </p>
                        </div>
                    </div>

                    <form id="profile-form">
                        <div class="form-grid">
                            <div class="form-group">
                                <label for="first-name">
                                    نام
                                </label>

                                <input
                                    id="first-name"
                                    name="first_name"
                                    type="text"
                                    readonly
                                />
                            </div>

                            <div class="form-group">
                                <label for="last-name">
                                    نام خانوادگی
                                </label>

                                <input
                                    id="last-name"
                                    name="last_name"
                                    type="text"
                                    readonly
                                />
                            </div>

                            <div class="form-group full-width">
                                <label for="email">
                                    آدرس ایمیل
                                </label>

                                <input
                                    id="email"
                                    name="email"
                                    type="email"
                                    disabled
                                />

                                <small>
                                    آدرس ایمیل از این قسمت قابل تغییر نیست.
                                </small>
                            </div>

                            <div class="form-group full-width">
                                <label for="phone-number">
                                    شماره تلفن
                                </label>

                                <input
                                    id="phone-number"
                                    name="phone_number"
                                    type="tel"
                                    readonly
                                />
                            </div>
                        </div>
                    </form>
                </section>
            </div>

            <!-- Security -->
            <section class="profile-card security-card">
                <div class="card-header">
                    <div>
                        <h3>امنیت</h3>

                        <p>
                            رمز عبور حساب خود را مدیریت کنید.
                        </p>
                    </div>
                </div>

                <div class="security-content">
                    <div class="security-info">
                        <div class="security-icon">
                            <i class="fa-solid fa-lock"></i>
                        </div>

                        <div>
                            <h4>رمز عبور</h4>

                            <p>
                                با استفاده از یک رمز عبور قوی، حساب خود را ایمن نگه دارید.
                            </p>
                        </div>
                    </div>

                    <button
                        id="open-password-modal"
                        type="button"
                        class="change-password-btn"
                    >
                        تغییر رمز عبور
                    </button>
                </div>
            </section>
        </div>
    </div>

    <!-- Change Password Modal -->
    <div
        id="password-modal"
        class="modal-overlay d-none"
    >
        <div
            class="password-modal"
            role="dialog"
            aria-modal="true"
            aria-labelledby="password-modal-title"
        >
            <div class="modal-header">
                <div>
                    <h3 id="password-modal-title">
                        تغییر رمز عبور
                    </h3>

                    <p>
                        رمز عبور فعلی و رمز عبور جدید خود را وارد کنید.
                    </p>
                </div>

                <button
                    id="close-password-modal"
                    type="button"
                    class="close-modal"
                    aria-label="بستن"
                >
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            <form id="change-password-form">
                <div class="form-group">
                    <label for="old-password">
                        رمز عبور فعلی
                    </label>

                    <div class="password-wrapper">
                        <input
                            id="old-password"
                            name="old_password"
                            type="password"
                            placeholder="رمز عبور فعلی"
                            autocomplete="current-password"
                            required
                        />

                        <button
                            type="button"
                            class="toggle-password"
                            data-target="old-password"
                            aria-label="نمایش رمز عبور"
                        >
                            <i class="fa-regular fa-eye"></i>
                        </button>
                    </div>
                </div>

                <div class="form-group">
                    <label for="new-password">
                        رمز عبور جدید
                    </label>

                    <div class="password-wrapper">
                        <input
                            id="new-password"
                            name="new_password"
                            type="password"
                            placeholder="رمز عبور جدید"
                            autocomplete="new-password"
                            required
                        />

                        <button
                            type="button"
                            class="toggle-password"
                            data-target="new-password"
                            aria-label="نمایش رمز عبور"
                        >
                            <i class="fa-regular fa-eye"></i>
                        </button>
                    </div>
                </div>

                <div class="form-group">
                    <label for="confirm-password">
                        تکرار رمز عبور جدید
                    </label>

                    <div class="password-wrapper">
                        <input
                            id="confirm-password"
                            name="confirm_password"
                            type="password"
                            placeholder="تکرار رمز عبور جدید"
                            autocomplete="new-password"
                            required
                        />

                        <button
                            type="button"
                            class="toggle-password"
                            data-target="confirm-password"
                            aria-label="نمایش رمز عبور"
                        >
                            <i class="fa-regular fa-eye"></i>
                        </button>
                    </div>
                </div>

                <div
                    id="password-message"
                    class="password-message d-none"
                ></div>

                <div class="modal-actions">
                    <button
                        id="cancel-password"
                        type="button"
                        class="cancel-btn"
                    >
                        انصراف
                    </button>

                    <button
                        id="submit-password"
                        type="submit"
                        class="submit-password-btn"
                    >
                        <span id="submit-password-text">
                            تغییر رمز عبور
                        </span>

                        <span
                            id="submit-password-loading"
                            class="d-none"
                        >
                            <i class="fa-solid fa-spinner fa-spin"></i>
                            در حال تغییر...
                        </span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</TherapistLayout>

<script>
    interface TherapistProfile {
        id: number;
        first_name: string;
        last_name: string;
        phone_number: string;
        user: {
            email: string;
            id: number;
        };
    }

    const profileLoading =
        document.querySelector<HTMLDivElement>(
            "#profile-loading"
        );

    const profileError =
        document.querySelector<HTMLDivElement>(
            "#profile-error"
        );

    const profileErrorText =
        document.querySelector<HTMLParagraphElement>(
            "#profile-error-text"
        );

    const profileContent =
        document.querySelector<HTMLDivElement>(
            "#profile-content"
        );

    const retryProfile =
        document.querySelector<HTMLButtonElement>(
            "#retry-profile"
        );

    const firstNameInput =
        document.querySelector<HTMLInputElement>(
            "#first-name"
        );

    const lastNameInput =
        document.querySelector<HTMLInputElement>(
            "#last-name"
        );

    const emailInput =
        document.querySelector<HTMLInputElement>(
            "#email"
        );

    const phoneInput =
        document.querySelector<HTMLInputElement>(
            "#phone-number"
        );

    const profileFullName =
        document.querySelector<HTMLElement>(
            "#profile-full-name"
        );

    const profileEmail =
        document.querySelector<HTMLElement>(
            "#profile-email"
        );

    const profilePhone =
        document.querySelector<HTMLElement>(
            "#profile-phone"
        );

    const passwordModal =
        document.querySelector<HTMLDivElement>(
            "#password-modal"
        );

    const openPasswordModal =
        document.querySelector<HTMLButtonElement>(
            "#open-password-modal"
        );

    const closePasswordModal =
        document.querySelector<HTMLButtonElement>(
            "#close-password-modal"
        );

    const cancelPassword =
        document.querySelector<HTMLButtonElement>(
            "#cancel-password"
        );

    const changePasswordForm =
        document.querySelector<HTMLFormElement>(
            "#change-password-form"
        );

    const passwordMessage =
        document.querySelector<HTMLDivElement>(
            "#password-message"
        );

    const submitPassword =
        document.querySelector<HTMLButtonElement>(
            "#submit-password"
        );

    const submitPasswordText =
        document.querySelector<HTMLSpanElement>(
            "#submit-password-text"
        );

    const submitPasswordLoading =
        document.querySelector<HTMLSpanElement>(
            "#submit-password-loading"
        );

    function showProfileLoading() {
        profileLoading?.classList.remove("d-none");
        profileError?.classList.add("d-none");
        profileContent?.classList.add("d-none");
    }

    function showProfileContent() {
        profileLoading?.classList.add("d-none");
        profileError?.classList.add("d-none");
        profileContent?.classList.remove("d-none");
    }

    function showProfileError(message: string) {
        profileLoading?.classList.add("d-none");
        profileContent?.classList.add("d-none");
        profileError?.classList.remove("d-none");

        if (profileErrorText) {
            profileErrorText.textContent = message;
        }
    }

    async function fetchProfile() {
        showProfileLoading();

        try {
            const response = await fetch(
                "http://localhost:8000/api/v1/accounts/therapist/profile/",
                {
                    method: "GET",
                    credentials: "include",
                    headers: {
                        Accept: "application/json",
                    },
                }
            );

            if (!response.ok) {
                throw new Error(
                    `خطای سرور: ${response.status}`
                );
            }

            const data: TherapistProfile =
                await response.json();

            const fullName =
                `${data.first_name || ""} ${
                    data.last_name || ""
                }`.trim();

            if (firstNameInput) {
                firstNameInput.value =
                    data.first_name || "";
            }

            if (lastNameInput) {
                lastNameInput.value =
                    data.last_name || "";
            }

            if (emailInput) {
                emailInput.value =
                    data.user?.email || "";
            }

            if (phoneInput) {
                phoneInput.value =
                    data.phone_number || "";
            }

            if (profileFullName) {
                profileFullName.textContent =
                    fullName || "تراپیست";
            }

            if (profileEmail) {
                profileEmail.textContent =
                    data.user?.email || "-";
            }

            if (profilePhone) {
                profilePhone.textContent =
                    data.phone_number || "-";
            }

            showProfileContent();
        } catch (error) {
            console.error(
                "Failed to fetch therapist profile:",
                error
            );

            showProfileError(
                "دریافت اطلاعات پروفایل با مشکل مواجه شد."
            );
        }
    }

    function showPasswordMessage(
        message: string,
        type: "success" | "error"
    ) {
        if (!passwordMessage) {
            return;
        }

        passwordMessage.textContent = message;
        passwordMessage.className =
            `password-message ${type}`;
    }

    function hidePasswordMessage() {
        if (!passwordMessage) {
            return;
        }

        passwordMessage.textContent = "";
        passwordMessage.className =
            "password-message d-none";
    }

    function openPasswordDialog() {
        if (!passwordModal) {
            return;
        }

        hidePasswordMessage();

        passwordModal.classList.remove("d-none");

        document.body.style.overflow = "hidden";

        document
            .querySelector<HTMLInputElement>(
                "#old-password"
            )
            ?.focus();
    }

    function closePasswordDialog() {
        if (!passwordModal) {
            return;
        }

        passwordModal.classList.add("d-none");

        document.body.style.overflow = "";

        changePasswordForm?.reset();

        hidePasswordMessage();
    }

    function setPasswordLoading(
        loading: boolean
    ) {
        if (submitPassword) {
            submitPassword.disabled = loading;
        }

        submitPasswordText?.classList.toggle(
            "d-none",
            loading
        );

        submitPasswordLoading?.classList.toggle(
            "d-none",
            !loading
        );
    }

    function extractErrorMessage(
        data: unknown
    ): string {
        if (!data || typeof data !== "object") {
            return "تغییر رمز عبور انجام نشد.";
        }

        const errorData =
            data as Record<string, unknown>;

        if (
            typeof errorData.detail ===
            "string"
        ) {
            return errorData.detail;
        }

        if (
            typeof errorData.message ===
            "string"
        ) {
            return errorData.message;
        }

        for (const value of Object.values(
            errorData
        )) {
            if (
                Array.isArray(value) &&
                value.length
            ) {
                return String(value[0]);
            }

            if (typeof value === "string") {
                return value;
            }
        }

        return "تغییر رمز عبور انجام نشد.";
    }

    async function handleChangePassword(
        event: SubmitEvent
    ) {
        event.preventDefault();

        if (!changePasswordForm) {
            return;
        }

        hidePasswordMessage();

        const formData =
            new FormData(changePasswordForm);

        const oldPassword =
            String(
                formData.get("old_password") || ""
            );

        const newPassword =
            String(
                formData.get("new_password") || ""
            );

        const confirmPassword =
            String(
                formData.get("confirm_password") || ""
            );

        if (
            !oldPassword ||
            !newPassword ||
            !confirmPassword
        ) {
            showPasswordMessage(
                "لطفاً تمام فیلدها را تکمیل کنید.",
                "error"
            );

            return;
        }

        if (newPassword !== confirmPassword) {
            showPasswordMessage(
                "رمز عبور جدید و تکرار آن یکسان نیستند.",
                "error"
            );

            return;
        }

        if (oldPassword === newPassword) {
            showPasswordMessage(
                "رمز عبور جدید باید با رمز عبور فعلی متفاوت باشد.",
                "error"
            );

            return;
        }

        setPasswordLoading(true);

        try {
            const response = await fetch(
                "http://localhost:8000/api/v1/accounts/change-password/",
                {
                    method: "PUT",
                    credentials: "include",
                    headers: {
                        "Content-Type":
                            "application/json",
                        Accept: "application/json",
                    },
                    body: JSON.stringify({
                        old_password:
                            oldPassword,

                        new_password:
                            newPassword,

                        confirm_password:
                            confirmPassword,
                    }),
                }
            );

            const data =
                await response.json().catch(
                    () => null
                );

            if (!response.ok) {
                throw new Error(
                    extractErrorMessage(data)
                );
            }

            showPasswordMessage(
                "رمز عبور با موفقیت تغییر کرد.",
                "success"
            );

            changePasswordForm.reset();

            setTimeout(() => {
                closePasswordDialog();
            }, 1200);
        } catch (error) {
            console.error(
                "Failed to change password:",
                error
            );

            showPasswordMessage(
                error instanceof Error
                    ? error.message
                    : "تغییر رمز عبور با مشکل مواجه شد.",
                "error"
            );
        } finally {
            setPasswordLoading(false);
        }
    }

    document
        .querySelectorAll<HTMLButtonElement>(
            ".toggle-password"
        )
        .forEach((button) => {
            button.addEventListener(
                "click",
                () => {
                    const target =
                        button.dataset.target;

                    if (!target) {
                        return;
                    }

                    const input =
                        document.querySelector<HTMLInputElement>(
                            `#${target}`
                        );

                    if (!input) {
                        return;
                    }

                    const icon =
                        button.querySelector("i");

                    if (
                        input.type ===
                        "password"
                    ) {
                        input.type = "text";

                        icon?.classList.remove(
                            "fa-eye"
                        );

                        icon?.classList.add(
                            "fa-eye-slash"
                        );
                    } else {
                        input.type = "password";

                        icon?.classList.remove(
                            "fa-eye-slash"
                        );

                        icon?.classList.add(
                            "fa-eye"
                        );
                    }
                }
            );
        });

    openPasswordModal?.addEventListener(
        "click",
        openPasswordDialog
    );

    closePasswordModal?.addEventListener(
        "click",
        closePasswordDialog
    );

    cancelPassword?.addEventListener(
        "click",
        closePasswordDialog
    );

    changePasswordForm?.addEventListener(
        "submit",
        handleChangePassword
    );

    passwordModal?.addEventListener(
        "click",
        (event) => {
            if (
                event.target === passwordModal
            ) {
                closePasswordDialog();
            }
        }
    );

    document.addEventListener(
        "keydown",
        (event) => {
            if (
                event.key === "Escape" &&
                !passwordModal?.classList.contains(
                    "d-none"
                )
            ) {
                closePasswordDialog();
            }
        }
    );

    retryProfile?.addEventListener(
        "click",
        fetchProfile
    );

    fetchProfile();
</script>

<style>
    .profile-page {
        max-width: 1200px;
        margin: 0 auto;
    }

    .page-header {
        margin-bottom: 30px;
    }

    .page-header h2 {
        margin: 0;
        color: #111827;
        font-size: 24px;
        font-weight: 700;
    }

    .page-header p {
        margin: 7px 0 0;
        color: #9ca3af;
        font-size: 14px;
    }

    .profile-grid {
        display: grid;
        grid-template-columns: 300px 1fr;
        gap: 20px;
        margin-bottom: 20px;
    }

    .profile-card {
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        background: #ffffff;
    }

    .profile-summary {
        padding: 30px;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
    }

    .avatar-large {
        width: 90px;
        height: 90px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 18px;
        border-radius: 50%;
        background: #f3f4f6;
        color: #374151;
        font-size: 30px;
    }

    .profile-summary h3 {
        margin: 0;
        color: #111827;
        font-size: 18px;
        font-weight: 700;
    }

    .profile-summary > p {
        margin: 6px 0 0;
        color: #9ca3af;
        font-size: 13px;
    }

    .summary-divider {
        width: 100%;
        height: 1px;
        margin: 25px 0;
        background: #e5e7eb;
    }

    .summary-item {
        width: 100%;
        display: flex;
        align-items: flex-start;
        gap: 12px;
        margin-bottom: 18px;
        text-align: left;
    }

    .summary-item:last-child {
        margin-bottom: 0;
    }

    .summary-item > i {
        width: 18px;
        margin-top: 2px;
        color: #6b7280;
        font-size: 14px;
    }

    .summary-item div {
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: 3px;
    }

    .summary-item span {
        color: #9ca3af;
        font-size: 11px;
    }

    .summary-item strong {
        overflow-wrap: anywhere;
        color: #374151;
        font-size: 12px;
        font-weight: 500;
    }

    .card-header {
        padding: 24px 26px;
        border-bottom: 1px solid #e5e7eb;
    }

    .card-header h3 {
        margin: 0;
        color: #111827;
        font-size: 17px;
        font-weight: 700;
    }

    .card-header p {
        margin: 5px 0 0;
        color: #9ca3af;
        font-size: 12px;
    }

    #profile-form {
        padding: 26px;
    }

    .form-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 20px;
    }

    .form-group {
        display: flex;
        flex-direction: column;
    }

    .full-width {
        grid-column: 1 / -1;
    }

    .form-group label {
        margin-bottom: 8px;
        color: #374151;
        font-size: 13px;
        font-weight: 600;
    }

    .form-group input {
        width: 100%;
        box-sizing: border-box;
        padding: 11px 13px;
        border: 1px solid #d1d5db;
        border-radius: 8px;
        outline: none;
        background: #ffffff;
        color: #111827;
        font-family: inherit;
        font-size: 13px;
    }

    .form-group input[readonly],
    .form-group input:disabled {
        background: #f9fafb;
        color: #6b7280;
        cursor: default;
    }

    .form-group small {
        margin-top: 6px;
        color: #9ca3af;
        font-size: 11px;
    }

    .security-card {
        margin-bottom: 30px;
    }

    .security-content {
        padding: 24px 26px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
    }

    .security-info {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .security-icon {
        width: 42px;
        height: 42px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 9px;
        background: #f3f4f6;
        color: #374151;
    }

    .security-info h4 {
        margin: 0;
        color: #111827;
        font-size: 14px;
    }

    .security-info p {
        margin: 4px 0 0;
        color: #9ca3af;
        font-size: 12px;
    }

    .change-password-btn {
        padding: 9px 14px;
        border: 1px solid #d1d5db;
        border-radius: 8px;
        background: #ffffff;
        color: #374151;
        font-family: inherit;
