---

import TherapistLayout from '@layouts/TherapistLayout.astro';
import { API_BASE_URL } from '../../config/api';
------------------------------------------------

<TherapistLayout title="تمام اسلات‌ها">
    <div class="slots-container">

```
    <!-- Header -->
    <section class="page-header">
        <div>
            <h1>تمام اسلات‌ها</h1>
            <p>مشاهده تمام زمان‌های تعریف‌شده و وضعیت رزرو آن‌ها</p>
        </div>
    </section>

    <!-- Loading -->
    <div id="slotsLoading" class="state-message">
        در حال دریافت اسلات‌ها...
    </div>

    <!-- Error -->
    <div id="slotsError" class="state-message error-message hidden">
        دریافت اسلات‌ها انجام نشد.
    </div>

    <!-- Empty -->
    <div id="slotsEmpty" class="state-message hidden">
        هنوز هیچ اسلاتی برای شما ثبت نشده است.
    </div>

    <!-- Table -->
    <section id="slotsTableWrapper" class="table-wrapper hidden">
        <table class="slots-table">
            <thead>
                <tr>
                    <th>تاریخ</th>
                    <th>زمان</th>
                    <th>وضعیت</th>
                    <th>مراجع</th>
                    <th>علت مراجعه</th>
                </tr>
            </thead>

            <tbody id="slotsTableBody"></tbody>
        </table>
    </section>

</div>
```

</TherapistLayout>

<style>
    .slots-container {
        width: 100%;
        padding: 30px;
        direction: rtl;
    }

    .page-header {
        margin-bottom: 30px;
    }

    .page-header h1 {
        margin: 0 0 8px;
        font-size: 28px;
        font-weight: 700;
    }

    .page-header p {
        margin: 0;
        color: #6b7280;
        font-size: 15px;
    }

    .table-wrapper {
        width: 100%;
        overflow-x: auto;
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
    }

    .slots-table {
        width: 100%;
        border-collapse: collapse;
        direction: rtl;
    }

    .slots-table th,
    .slots-table td {
        padding: 16px;
        text-align: right;
        border-bottom: 1px solid #e5e7eb;
        white-space: nowrap;
    }

    .slots-table th {
        background: #f9fafb;
        color: #374151;
        font-size: 14px;
        font-weight: 600;
    }

    .slots-table td {
        color: #4b5563;
        font-size: 14px;
    }

    .slots-table tbody tr:last-child td {
        border-bottom: none;
    }

    .slots-table tbody tr:hover {
        background: #f9fafb;
    }

    .state-message {
        width: 100%;
        padding: 40px 20px;
        text-align: center;
        color: #6b7280;
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
    }

    .error-message {
        color: #dc2626;
    }

    .hidden {
        display: none !important;
    }

    .status-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 6px 12px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 600;
    }

    .status-available {
        background: #dcfce7;
        color: #166534;
    }

    .status-scheduled {
        background: #dbeafe;
        color: #1d4ed8;
    }

    .status-completed {
        background: #f3f4f6;
        color: #374151;
    }

    .status-cancelled {
        background: #fee2e2;
        color: #b91c1c;
    }

    @media (max-width: 768px) {
        .slots-container {
            padding: 20px 15px;
        }

        .slots-table th,
        .slots-table td {
            padding: 12px;
        }
    }
</style>

<script define:vars={{ API_BASE_URL }}>
    interface Patient {
        id?: number;
        first_name?: string;
        last_name?: string;
        phone_number?: string;
    }

    interface Appointment {
        id?: number;
        patient?: Patient;
        reason?: string;
        status?: string;
    }

    interface AppointmentSlot {
        id?: number;
        date?: string;
        time?: string;
        status?: string;
        appointment?: Appointment | null;
    }

    const SLOTS_URL =
        `${API_BASE_URL}/booking/therapist/appointment-slots/`;

    const slotsLoading =
        document.getElementById("slotsLoading") as HTMLDivElement;

    const slotsError =
        document.getElementById("slotsError") as HTMLDivElement;

    const slotsEmpty =
        document.getElementById("slotsEmpty") as HTMLDivElement;

    const slotsTableWrapper =
        document.getElementById("slotsTableWrapper") as HTMLElement;

    const slotsTableBody =
        document.getElementById("slotsTableBody") as HTMLTableSectionElement;


    function formatDate(date?: string): string {
        if (!date) {
            return "-";
        }

        return date;
    }


    function formatTime(time?: string): string {
        if (!time) {
            return "-";
        }

        return time.slice(0, 5);
    }


    function getPatientName(patient?: Patient): string {
        if (!patient) {
            return "-";
        }

        const firstName = patient.first_name?.trim() || "";
        const lastName = patient.last_name?.trim() || "";

        const fullName =
            `${firstName} ${lastName}`.trim();

        return fullName || "-";
    }


    function getStatusLabel(status?: string): string {
        switch (status) {
            case "available":
                return "آزاد";

            case "scheduled":
                return "رزرو شده";

            case "completed":
                return "انجام شده";

            case "cancelled":
                return "لغو شده";

            default:
                return status || "-";
        }
    }


    function getStatusClass(status?: string): string {
        switch (status) {
            case "available":
                return "status-available";

            case "scheduled":
                return "status-scheduled";

            case "completed":
                return "status-completed";

            case "cancelled":
                return "status-cancelled";

            default:
                return "";
        }
    }


    function renderSlots(slots: AppointmentSlot[]) {
        slotsTableBody.innerHTML = "";

        slots.forEach((slot) => {
            const row = document.createElement("tr");

            const patientName =
                getPatientName(slot.appointment?.patient);

            const reason =
                slot.appointment?.reason || "-";

            const status =
                slot.status || "available";

            row.innerHTML = `
                <td>
                    ${formatDate(slot.date)}
                </td>

                <td>
                    ${formatTime(slot.time)}
                </td>

                <td>
                    <span class="status-badge ${getStatusClass(status)}">
                        ${getStatusLabel(status)}
                    </span>
                </td>

                <td>
                    ${patientName}
                </td>

                <td>
                    ${reason}
                </td>
            `;

            slotsTableBody.appendChild(row);
        });
    }


    async function loadSlots() {
        slotsLoading.classList.remove("hidden");
        slotsError.classList.add("hidden");
        slotsEmpty.classList.add("hidden");
        slotsTableWrapper.classList.add("hidden");

        try {
            const response = await fetch(
                SLOTS_URL,
                {
                    method: "GET",
                    credentials: "include",
                    headers: {
                        Accept: "application/json",
                    },
                }
            );

            if (!response.ok) {
                throw new Error(
                    `Failed to fetch slots: ${response.status}`
                );
            }

            const data: AppointmentSlot[] =
                await response.json();

            slotsLoading.classList.add("hidden");

            if (
                !Array.isArray(data) ||
                data.length === 0
            ) {
                slotsEmpty.classList.remove("hidden");
                return;
            }

            renderSlots(data);

            slotsTableWrapper.classList.remove("hidden");

        } catch (error) {
            console.error(
                "Error loading therapist slots:",
                error
            );

            slotsLoading.classList.add("hidden");
            slotsError.classList.remove("hidden");
        }
    }


    document.addEventListener(
        "DOMContentLoaded",
        () => {
            loadSlots();
        }
    );
</script>
